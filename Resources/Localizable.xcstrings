    "How much the couplers sharpen edges, as on real film. Lower keeps their colour with softer edges." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie stark die Kuppler Kanten schärfen, wie bei echtem Film. Niedriger behält ihre Farbe mit weicheren Kanten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto realzan los bordes los acopladores, como en la película real. Más bajo conserva su color con bordes más suaves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien les coupleurs accentuent les contours, comme sur un vrai film. Plus bas garde leur couleur avec des bords plus doux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto gli accoppianti rendono nitidi i contorni, come su una vera pellicola. Più basso mantiene il colore con bordi più morbidi."
