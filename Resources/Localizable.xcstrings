          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proyecto se convierte en una nueva línea de tiempo en el proyecto abierto de Resolve, con sus subtítulos. Los archivos que ya están no se vuelven a importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
