    "Steady framing shot by shot, titles shown whole, a Framing choice, and sleek new captions with the spoken word highlighted in pink.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhiger Bildausschnitt pro Einstellung, Titel vollständig im Bild, eine Wahl für den Bildausschnitt und schicke neue Untertitel mit dem gesprochenen Wort in Pink."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuadre estable plano a plano, títulos completos, una opción de encuadre y nuevos subtítulos elegantes con la palabra dicha resaltada en rosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cadrage stable plan par plan, des titres affichés en entier, un choix de cadrage et de nouveaux sous-titres élégants avec le mot prononcé surligné en rose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadratura stabile ripresa per ripresa, titoli mostrati per intero, una scelta di inquadratura e nuovi sottotitoli eleganti con la parola pronunciata evidenziata in rosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショットごとに安定したフレーミング、タイトルは全体を表示、フレーミングの選択、話している単語をピンクで強調する洗練された新しいキャプション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장면마다 안정적인 프레이밍, 제목 전체 표시, 프레이밍 선택, 말하는 단어를 분홍색으로 강조하는 세련된 새 캡션."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille kadrering per shot, titels volledig in beeld, een keuze voor kadrering, en strakke nieuwe ondertiteling met het gesproken woord in roze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquadramento estável cena a cena, títulos inteiros, uma opção de enquadramento e novas legendas elegantes com a palavra falada destacada em rosa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐镜头稳定取景、完整显示标题、可选择取景方式，以及用粉色突出当前词语的精致新字幕。"
          }
        }
      }
    },
