    "The pairing code has expired. Make a new one on the host Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kopplungscode ist abgelaufen. Erstelle auf dem Host-Mac einen neuen."
          }
        },
        "es": {
