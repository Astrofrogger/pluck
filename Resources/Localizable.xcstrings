        }
      }
    },
    "There’s no preview for that render (yet).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Rendering gibt es (noch) keine Vorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(Todavía) no hay vista previa de ese render."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
