    "%@ No playable video was found on the page either.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Auch auf der Seite wurde kein abspielbares Video gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tampoco se encontró ningún vídeo reproducible en la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Aucune vidéo lisible n’a été trouvée sur la page non plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nemmeno sulla pagina è stato trovato un video riproducibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ページ上にも再生可能なビデオは見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 페이지에서도 재생 가능한 비디오를 찾지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ook op de pagina is geen afspeelbare video gevonden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Também não foi encontrado nenhum vídeo reproduzível na página."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 页面上也没有找到可播放的视频。"
          }
        }
      }
    },
