    "Anyone with the link can add files to “%@”. They land on the NAS; nothing there is replaced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder mit dem Link kann Dateien zu „%@“ hinzufügen. Sie landen auf dem NAS; dort wird nichts ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con el enlace puede añadir archivos a “%@”. Llegan al NAS; allí no se reemplaza nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du lien peut ajouter des fichiers à « %@ ». Ils arrivent sur le NAS ; rien n’y est remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia il link può aggiungere file a “%@”. Arrivano sul NAS; lì non viene sostituito nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを知っている人は誰でも「%@」にファイルを追加できます。ファイルは NAS に届き、既存のものは置き換えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 있는 사람은 누구나 ‘%@’에 파일을 추가할 수 있습니다. 파일은 NAS에 저장되며 기존 파일은 바뀌지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen met de link kan bestanden aan ‘%@’ toevoegen. Ze komen op de NAS; daar wordt niets vervangen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com o link pode adicionar arquivos a “%@”. Eles chegam ao NAS; nada lá é substituído."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何拥有链接的人都能向“%@”添加文件。文件会存入 NAS，那里的内容不会被替换。"
          }
        }
      }
    },
