    "This Mac can’t render here any more until it’s paired again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann hier erst wieder rendern, wenn er erneut gekoppelt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no podrá renderizar aquí hasta que se vuelva a vincular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne pourra plus faire de rendu ici tant qu’il n’est pas jumelé à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non potrà più eseguire rendering qui finché non viene abbinato di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再度ペアリングするまで、この Mac はここでレンダリングできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 페어링할 때까지 이 Mac은 여기서 렌더링할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac kan hier niet meer renderen tot hij opnieuw gekoppeld is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não poderá mais renderizar aqui até ser pareado novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在重新配对之前，此 Mac 将无法在这里渲染。"
          }
        }
      }
    },
    "This Mac can’t transcribe that language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann diese Sprache nicht transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no puede transcribir ese idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas transcrire cette langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non può trascrivere quella lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac はその言語を文字起こしできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
