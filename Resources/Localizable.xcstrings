    "Reads every master again from the drive and looks at its original before you delete anything" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest jeden Master erneut vom Laufwerk und prüft sein Original, bevor du etwas löschst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a leer cada máster del disco y revisa su original antes de que borres nada"
          }
        },
        "fr" : {
