        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén beeld tussen twee shots, waarschijnlijk overgebleven van de montage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único quadro entre dois planos, provavelmente sobra da edição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个镜头之间夹着单独一帧，可能是剪辑时遗留的。"
          }
        }
      }
    },
    "A smooth, even camera move: good for a speed ramp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige, gleichmäßige Kamerabewegung: gut für eine Geschwindigkeitsrampe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimiento de cámara suave y uniforme: ideal para una rampa de velocidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mouvement de caméra fluide et régulier : idéal pour une rampe de vitesse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimento di camera fluido e regolare: ottimo per una rampa di velocità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
