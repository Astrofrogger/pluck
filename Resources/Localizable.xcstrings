          }
        }
      }
    },
    "The update didn’t match its published checksum, so it was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update stimmte nicht mit seiner veröffentlichten Prüfsumme überein und wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no coincidía con su suma de comprobación publicada y se descartó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour ne correspondait pas à sa somme de contrôle publiée et a été supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento non corrispondeva al checksum pubblicato ed è stato scartato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが公開されたチェックサムと一致しなかったため、破棄しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 게시된 체크섬과 일치하지 않아 폐기했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update kwam niet overeen met de gepubliceerde controlesom en is daarom verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não correspondia ao checksum publicado e foi descartada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新与已发布的校验和不符，已被丢弃。"
          }
        }
      }
    },
    "There are no pauses or filler words to remove at this setting.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen pauzes of stopwoorden om te verwijderen met deze instelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Einstellung gibt es keine Pausen oder Füllwörter zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pause ni hésitation à supprimer avec ce réglage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pausas ni muletillas que quitar con este ajuste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa impostazione non ci sono pause o intercalari da rimuovere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pausas nem vícios de fala para remover com esta opção."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定では削除する間やフィラーはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정에서는 제거할 쉼이나 군말이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设置下没有可删除的停顿或口头禅。"
          }
        }
      }
    },
    "There isn’t enough memory to process this video.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg geheugen om deze video te verwerken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Video ist nicht genug Speicher frei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire insuffisante pour traiter cette vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay memoria suficiente para procesar este vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria insufficiente per elaborare questo video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há memória suficiente para processar este vídeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画を処理するのに十分なメモリがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상을 처리할 메모리가 부족합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存不足，无法处理此视频。"
          }
        }
      }
    },
    "These settings make the photos bigger. Lower the quality or the size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesen Einstellungen werden die Fotos größer. Senke die Qualität oder die Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos ajustes las fotos ocupan más. Baja la calidad o el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages rendent les photos plus lourdes. Baissez la qualité ou la taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con queste impostazioni le foto diventano più grandi. Riduci la qualità o la dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定では写真が大きくなります。品質かサイズを下げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정에서는 사진이 더 커집니다. 품질이나 크기를 낮추십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze instellingen worden de foto’s groter. Verlaag de kwaliteit of de grootte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esses ajustes as fotos ficam maiores. Diminua a qualidade ou o tamanho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置会使照片变大。请降低质量或尺寸。"
          }
        }
      }
    },
    "This Mac can’t transcribe that language.": {
      "localizations": {
        "de": {
