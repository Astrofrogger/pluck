    "Keeps the room but softly out of focus, like a portrait lens.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt de ruimte, maar zacht onscherp, zoals een portretlens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den Raum, aber weich unscharf wie mit einem Porträtobjektiv."
