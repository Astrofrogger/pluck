    "It works once, for 24 hours, and only for the Mac that uses it first. Send it only to your own team.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er funktioniert einmal, 24 Stunden lang, und nur für den Mac, der ihn zuerst nutzt. Schicke ihn nur an dein eigenes Team."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona una vez, durante 24 horas, y solo para el primer Mac que lo use. Envíalo solo a tu propio equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fonctionne une fois, pendant 24 heures, et seulement pour le premier Mac qui l’utilise. Ne l’envoyez qu’à votre équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona una volta, per 24 ore, e solo per il primo Mac che lo usa. Invialo solo al tuo team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回だけ、24 時間有効で、最初に使った Mac だけが使えます。自分のチームにだけ送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만, 24시간 동안, 처음 사용하는 Mac에서만 작동합니다. 팀원에게만 보내세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij werkt één keer, 24 uur lang, en alleen voor de Mac die hem eerst gebruikt. Stuur hem alleen naar je eigen team."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona uma vez, por 24 horas, e só para o primeiro Mac que usá-lo. Envie apenas para sua própria equipe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可使用一次，有效期 24 小时，且只对最先使用的 Mac 有效。只发给你自己的团队。"
          }
        }
      }
    },
