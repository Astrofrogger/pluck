    "AgX keeps each colour's hue into white; Basic is punchier, its colours drifting in bright light" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX hält den Farbton jeder Farbe bis ins Weiß; Einfach ist kräftiger, die Farben verschieben sich in hellem Licht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX mantiene el tono de cada color hasta el blanco; Básico es más intenso y sus colores derivan con luz intensa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX garde la teinte de chaque couleur jusqu’au blanc ; Basique est plus percutant, ses couleurs dérivent en forte lumière"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX mantiene la tinta di ogni colore fino al bianco; Base è più incisivo e i colori virano con luce intensa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgXは白に向かっても各色の色相を保ちます。ベーシックはメリハリが強く、明るい光で色がずれます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX는 흰색까지 각 색의 색조를 유지합니다. 기본은 더 강렬하며 밝은 빛에서 색이 틀어집니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX houdt de tint van elke kleur tot in het wit; Basis is krachtiger, de kleuren verschuiven in fel licht"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX mantém o matiz de cada cor até o branco; Básico é mais intenso e as cores desviam sob luz forte"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AgX 在接近白色时保持各颜色的色相；基本更鲜明，强光下颜色会偏移"
          }
        }
      }
    },
