    "The model couldn’t be downloaded. Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell konnte nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo. Revisa tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n’a pas pu être téléchargé. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello. Controlla la connessione a Internet e riprova."
          }
