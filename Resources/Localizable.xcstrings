        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %lldp. 로컬 AI가 픽셀을 키우는 대신 실제 디테일을 더합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
