    "Records a live stream and marks cheers, music and silence as it goes, with a live transcript and highlights for the edit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimmt einen Livestream auf und markiert dabei Jubel, Musik und Stille, mit Live-Abschrift und Highlights für den Schnitt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba un directo y marca aplausos, música y silencios sobre la marcha, con transcripción en vivo y destacados para el montaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre un direct et marque au fil de l’eau acclamations, musique et silences, avec une transcription en direct et des temps forts pour le montage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una diretta e segna man mano applausi, musica e silenzi, con trascrizione dal vivo e momenti salienti per il montaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ配信を録画しながら歓声、音楽、無音にマーカーを付け、リアルタイムの文字起こしと編集用ハイライトを作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브 방송을 녹화하면서 환호, 음악, 무음을 표시하고 실시간 전사와 편집용 하이라이트를 만듭니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt een livestream op en markeert onderweg gejuich, muziek en stiltes, met een live transcriptie en highlights voor de montage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava uma transmissão ao vivo e marca aplausos, música e silêncio durante a gravação, com transcrição ao vivo e destaques para a edição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制直播的同时标记欢呼、音乐和静音，并提供实时转写和用于剪辑的精彩片段。"
          }
        }
      }
    },
