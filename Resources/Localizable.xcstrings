    "Resolve would use another font or leave the effect out. Install them on the office Mac (licences apply)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve würde eine andere Schrift verwenden oder den Effekt weglassen. Installiere sie auf dem Büro-Mac (Lizenzen beachten)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve usaría otra fuente u omitiría el efecto. Instálalos en el Mac de la oficina (se aplican licencias)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve utiliserait une autre police ou omettrait l’effet. Installez-les sur le Mac du bureau (les licences s’appliquent)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve userebbe un altro font o tralascerebbe l’effetto. Installali sul Mac dell’ufficio (valgono le licenze)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve は別のフォントを使うか、エフェクトを省きます。オフィスの Mac にインストールしてください（ライセンスに従ってください）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve가 다른 서체를 쓰거나 효과를 빼게 됩니다. 사무실 Mac에 설치하세요(라이선스가 적용됩니다)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve zou een ander lettertype gebruiken of het effect weglaten. Installeer ze op de kantoor-Mac (licenties gelden)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Resolve usaria outra fonte ou deixaria o efeito de fora. Instale-os no Mac do escritório (licenças se aplicam)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resolve 会改用其他字体或省略该效果。请在办公室 Mac 上安装它们（须遵守许可）。"
          }
        }
      }
    },
