    "Copies everything pulled to a second drive too, checked, without pulling it twice" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert alles Geladene geprüft auch auf ein zweites Laufwerk, ohne es zweimal zu laden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia también todo lo descargado en un segundo disco, comprobado, sin descargarlo dos veces"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie aussi tout ce qui est récupéré sur un second disque, vérifié, sans le récupérer deux fois"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia anche tutto ciò che viene scaricato su un secondo disco, verificato, senza scaricarlo due volte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得したものを 2 台目のドライブにも確認付きでコピーします。2 回取得する必要はありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아 온 모든 것을 두 번째 드라이브에도 확인하며 복사합니다. 두 번 받지 않습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert alles wat is opgehaald ook gecontroleerd naar een tweede schijf, zonder het twee keer op te halen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia também tudo o que for baixado para um segundo disco, verificado, sem baixar duas vezes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将获取的所有内容也复制到第二块磁盘并校验，无需获取两次"
          }
        }
      }
    },
    "Copies the card to the first drive, then that drive to the others, so the card can go back in the camera sooner" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert die Karte auf das erste Laufwerk und von dort auf die anderen, damit die Karte früher zurück in die Kamera kann"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la tarjeta al primer disco y desde ahí a los demás, para que la tarjeta pueda volver antes a la cámara"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie la carte sur le premier disque, puis celui-ci sur les autres, pour que la carte retourne plus vite dans la caméra"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la scheda sulla prima unità, poi da quella alle altre, così la scheda torna prima nella fotocamera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
