    "Datasets › Add: one for the host's own data. Give the apps user (568) read and write there, and read on your media." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Hinzufügen: eines für die eigenen Daten des Hosts. Gib dem Apps-Benutzer (568) dort Lese- und Schreibrechte und auf deine Medien Leserechte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Añadir: uno para los datos propios del anfitrión. Da al usuario de apps (568) lectura y escritura ahí, y lectura en tus medios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Ajouter : un pour les données propres à l’hôte. Donnez à l’utilisateur des apps (568) la lecture et l’écriture dessus, et la lecture sur vos médias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Aggiungi: uno per i dati propri dell’host. Dai all’utente delle app (568) lettura e scrittura lì, e lettura sui tuoi media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › 追加：ホスト自身のデータ用に1つ作成します。アプリ用ユーザー（568）に、そこでの読み書きと、メディアの読み取り権限を与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Add: 호스트 자체 데이터용으로 하나를 만듭니다. 앱 사용자(568)에게 여기에 대한 읽기·쓰기 권한과 미디어에 대한 읽기 권한을 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Add: één voor de eigen data van de host. Geef de apps-gebruiker (568) daar lees- en schrijfrechten en leesrechten op je media."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Add: um para os dados do próprio anfitrião. Dê ao usuário dos apps (568) leitura e gravação nele e leitura na sua mídia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasets › Add：为主机自身的数据创建一个。授予应用用户 (568) 对它的读写权限，以及对你的媒体的读取权限。"
          }
        }
      }
    },
