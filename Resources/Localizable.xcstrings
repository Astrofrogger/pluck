    "Keeps the room but softly out of focus, like a portrait lens.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt de ruimte, maar zacht onscherp, zoals een portretlens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den Raum, aber weich unscharf wie mit einem Porträtobjektiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la pièce, mais doucement floue, comme un objectif portrait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el lugar, pero suavemente desenfocado, como un objetivo de retrato."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
