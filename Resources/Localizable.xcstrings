            "state": "translated",
            "value": "Bereit: Macs, die du einlädst, erreichen diesen von überall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: los Mac que invites llegan a este desde cualquier lugar."
          }
