    "Record a voice-over from the playhead; the timeline plays while you speak (Space or Esc stops)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice-over ab dem Abspielkopf aufnehmen; die Timeline läuft, während du sprichst (Leertaste oder Esc stoppt)"
          }
        },
        "es" : {
          "stringUnit" : {
