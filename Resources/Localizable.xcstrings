          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene un número impar de píxeles; muchos reproductores y plataformas lo rechazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a un nombre impair de pixels ; beaucoup de lecteurs et de plateformes le refusent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha un numero dispari di pixel; molti player e piattaforme lo rifiutano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はピクセル数が奇数です。多くのプレーヤーやプラットフォームで受け付けられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 픽셀 수가 홀수입니다. 많은 플레이어와 플랫폼에서 거부됩니다."
