    "Using the yt-dlp and ffmpeg installed on this Mac. Keep them current with “brew upgrade yt-dlp ffmpeg”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden yt-dlp und ffmpeg verwendet, die auf diesem Mac installiert sind. Halte sie mit „brew upgrade yt-dlp ffmpeg“ aktuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usan yt-dlp y ffmpeg instalados en este Mac. Mantenlos al día con “brew upgrade yt-dlp ffmpeg”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise yt-dlp et ffmpeg installés sur ce Mac. Gardez-les à jour avec « brew upgrade yt-dlp ffmpeg »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono usati yt-dlp e ffmpeg installati su questo Mac. Tienili aggiornati con “brew upgrade yt-dlp ffmpeg”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にインストールされた yt-dlp と ffmpeg を使用しています。「brew upgrade yt-dlp ffmpeg」で最新に保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 설치된 yt-dlp와 ffmpeg를 사용 중입니다. ‘brew upgrade yt-dlp ffmpeg’로 최신 상태를 유지하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck gebruikt de yt-dlp en ffmpeg die op deze Mac zijn geïnstalleerd. Houd ze up-to-date met “brew upgrade yt-dlp ffmpeg”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando o yt-dlp e o ffmpeg instalados neste Mac. Mantenha-os atualizados com “brew upgrade yt-dlp ffmpeg”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用此 Mac 上安装的 yt-dlp 和 ffmpeg。请用“brew upgrade yt-dlp ffmpeg”保持更新。"
          }
        }
      }
    },
