    "Google’s model: nearly as sharp and about four times quicker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Googles Modell: fast so genau und etwa viermal schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de Google: casi igual de preciso y unas cuatro veces más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle de Google : presque aussi précis et environ quatre fois plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di Google: quasi altrettanto preciso e circa quattro volte più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleのモデル：ほぼ同等の精度で約4倍速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 모델: 거의 같은 정확도에 약 4배 빠릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
