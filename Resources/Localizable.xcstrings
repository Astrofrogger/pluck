    "The clean sound (lavalier or recorder). Everything is synced to it, and it becomes the edit’s sound." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der saubere Ton (Lavalier oder Recorder). Alles wird damit synchronisiert, und er wird der Ton des Schnitts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sonido limpio (lavalier o grabadora). Todo se sincroniza con él y será el sonido del montaje."
          }
