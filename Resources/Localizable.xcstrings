        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Try other words, or describe what was being talked about.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche andere Wörter oder beschreibe, worum es ging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otras palabras o describe de qué se hablaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d’autres mots, ou décrivez de quoi il était question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova altre parole o descrivi di cosa si parlava."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の言葉を試すか、何について話していたかを説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 단어를 사용하거나 무엇에 대한 이야기였는지 설명해 보십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer andere woorden, of beschrijf waar het over ging."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outras palavras ou descreva do que se falava."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他词，或描述当时谈论的内容。"
          }
        }
      }
    },
    "Try other words.": {
