            "value" : "%@ esegue uno script Lua o un comando, cosa che il Mac host non fa per altri Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Lua スクリプトまたはコマンドを実行しますが、ホスト Mac は他の Mac のためにそれを実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) Lua 스크립트나 명령을 실행하는데, 호스트 Mac은 다른 Mac을 위해 이를 실행하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ voert een Lua-script of opdracht uit, wat de host-Mac niet voor andere Macs doet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ executa um script Lua ou um comando, o que o Mac anfitrião não faz para outros Macs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会运行 Lua 脚本或命令，主机 Mac 不会为其他 Mac 运行这些内容。"
          }
        }
      }
    },
    "%@ runs an older Pluck: folder limits apply there once it’s updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ läuft ein älteres Pluck: Die Ordnergrenzen gelten dort erst nach dem Update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa un Pluck antiguo: los límites de carpeta se aplicarán allí cuando se actualice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise un Pluck plus ancien : les limites par dossier s’y appliqueront après sa mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa un Pluck più vecchio: i limiti per cartella valgono lì dopo l’aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Pluck は古いバージョンです。アップデート後にフォルダの制限が適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이전 버전의 Pluck을 사용합니다. 업데이트하면 폴더 제한이 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op %@ draait een oudere Pluck: de mapgrenzen gelden daar zodra hij is bijgewerkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa um Pluck mais antigo: os limites por pasta valem lá depois da atualização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的是较旧的 Pluck：更新后那里才会应用文件夹限制。"
          }
        }
      }
    },
    "%@ seconds of black. Fine if it’s meant as a pause." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sekunden Schwarz. In Ordnung, wenn es als Pause gedacht ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ segundos en negro. Bien si es una pausa intencionada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ secondes de noir. Pas de souci si c’est voulu comme pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ secondi di nero. Va bene se è una pausa voluta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 秒の黒。意図した間なら問題ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@초 동안 검은 화면. 의도한 쉼이라면 괜찮습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ seconden zwart. Prima als het als pauze bedoeld is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ segundos de preto. Tudo bem se for uma pausa intencional."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 秒黑屏。如果是有意停顿则没问题。"
          }
        }
      }
    },
    "%@ seconds of black. Some platforms pick a black first frame as the thumbnail." : {
