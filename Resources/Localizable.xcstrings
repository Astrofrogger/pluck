    "A bit faster in the build-up, every bar on the drop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas schneller im Build-up, jeder Takt im Drop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo más rápido en el build-up, cada compás en el drop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu plus rapide dans le build-up, chaque mesure sur le drop."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po’ più veloce nel build-up, ogni battuta sul drop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドアップでやや速く、ドロップでは1小節ごと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드업에서 조금 더 빠르게, 드롭에서는 매 마디마다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets sneller in de build-up, elke maat op de drop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco mais rápido no build-up, cada compasso no drop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺垫段稍快，高潮段每小节一切。"
          }
        }
      },
      "extractionState": "stale"
    },
    "A blob of colour splits into droplets that flow into the letters and become the logo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Farbklecks teilt sich in Tropfen, die in die Buchstaben fließen und zum Logo werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mancha de color se divide en gotas que fluyen hacia las letras y forman el logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tache de couleur se divise en gouttes qui coulent dans les lettres et forment le logo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una macchia di colore si divide in gocce che scorrono nelle lettere e diventano il logo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色のしずくが分かれて文字へ流れ込み、ロゴになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색 덩어리가 방울로 나뉘어 글자로 흘러 들어가 로고가 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klodder kleur splitst in druppels die in de letters vloeien en het logo vormen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma gota de cor se divide em gotículas que fluem para as letras e viram o logo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一团颜色分成水滴，流入字母并变成标志。"
          }
        }
      }
    },
    "A calmer Assemble": {
