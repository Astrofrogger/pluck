    "Burned into 9:16, 1:1 and 4:5 only, in your subtitle style, clear of the apps’ buttons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in 9:16, 1:1 und 4:5 eingebrannt, in deinem Untertitelstil, frei von den Bedienelementen der Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se incrustan en 9:16, 1:1 y 4:5, con tu estilo de subtítulos, lejos de los botones de las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incrustés uniquement en 9:16, 1:1 et 4:5, dans votre style de sous-titres, à l’écart des boutons des apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressi solo in 9:16, 1:1 e 4:5, nel tuo stile di sottotitoli, lontano dai pulsanti delle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16、1:1、4:5のみに、あなたの字幕スタイルで、アプリのボタンに重ならない位置に焼き込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "9:16, 1:1, 4:5에만 내 자막 스타일로, 앱 버튼을 피해 입힙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen in 9:16, 1:1 en 4:5 ingebrand, in je ondertitelstijl, vrij van de knoppen van de apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravadas só em 9:16, 1:1 e 4:5, no seu estilo de legenda, longe dos botões dos apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅烧录到 9:16、1:1 和 4:5，使用你的字幕样式，避开应用的按钮。"
          }
        }
      }
    },
