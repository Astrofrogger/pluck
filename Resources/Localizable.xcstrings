    "Photos on film are developed at full size: that takes a while each." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos auf Film werden in voller Größe entwickelt: das dauert jeweils etwas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos en película se revelan a tamaño completo: cada una tarda un poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sur film sont développées en taille réelle : cela prend un moment chacune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto su pellicola vengono sviluppate a dimensione piena: ognuna richiede un po’."
