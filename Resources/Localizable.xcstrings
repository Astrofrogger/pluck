    "Move %lld proxies (%@) to the Trash? Paired Macs can ask for them again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Proxys (%2$@) in den Papierkorb legen? Gekoppelte Macs können sie erneut anfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Move %1$lld proxies (%2$@) to the Trash? Paired Macs can ask for them again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mover %1$lld proxies (%2$@) a la Papelera? Los Mac vinculados pueden volver a pedirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer %1$lld proxys (%2$@) dans la Corbeille ? Les Mac jumelés peuvent les redemander."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare %1$lld proxy (%2$@) nel Cestino? I Mac abbinati possono richiederli di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 個のプロキシ（%2$@）をゴミ箱に入れますか？ペアリング済みの Mac は再度リクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프록시 %1$lld개(%2$@)를 휴지통으로 이동하시겠습니까? 페어링된 Mac에서 다시 요청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld proxy’s (%2$@) naar de prullenmand verplaatsen? Gekoppelde Macs kunnen ze opnieuw aanvragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover %1$lld proxies (%2$@) para a Lixeira? Macs pareados podem pedi-los novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要将 %1$lld 个代理（%2$@）移到废纸篓吗？已配对的 Mac 可以再次请求它们。"
          }
        }
      }
    },
