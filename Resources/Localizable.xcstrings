    "Folders here stay in step: new and changed files go up by themselves, into this Mac’s folder in the host’s inbox." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner hier bleiben synchron: neue und geänderte Dateien gehen von selbst in den Ordner dieses Macs im Eingang des Hosts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas de aquí se mantienen al día: lo nuevo y lo cambiado sube solo a la carpeta de este Mac en la bandeja del anfitrión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers d’ici restent à jour : les fichiers nouveaux ou modifiés partent d’eux-mêmes dans le dossier de ce Mac, dans la boîte de réception de l’hôte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle qui restano allineate: i file nuovi e modificati salgono da soli nella cartella di questo Mac nella posta in arrivo dell’host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここのフォルダは同期され、新しいファイルや変更されたファイルはホストの受信フォルダ内のこのMac用フォルダへ自動で送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 폴더는 동기화되어 새 파일과 변경된 파일이 호스트 받은 편지함의 이 Mac 폴더로 자동으로 올라갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappen hier blijven bij: nieuwe en gewijzigde bestanden gaan vanzelf naar de map van deze Mac in de inbox van de host."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas daqui ficam em sincronia: arquivos novos e alterados sobem sozinhos para a pasta deste Mac na caixa de entrada do anfitrião."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处的文件夹保持同步：新文件和更改的文件会自动上传到主机收件箱中本 Mac 的文件夹。"
          }
        }
      }
    },
    "Folders or photos; ⌘-click to choose several" : {
      "localizations" : {
        "de" : {
