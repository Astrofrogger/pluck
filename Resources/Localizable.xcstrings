    "Works with keywords; Apple Intelligence makes it understand questions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit Stichwörtern; mit Apple Intelligence versteht sie Fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con palabras clave; Apple Intelligence hace que entienda preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec des mots-clés ; Apple Intelligence lui permet de comprendre les questions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
