    "AI jobs now wait their turn, so starting several at once won’t slow your Mac down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Aufgaben warten jetzt, bis sie dran sind, damit mehrere auf einmal deinen Mac nicht ausbremsen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas de IA ahora esperan su turno, así que iniciar varias a la vez no ralentiza tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches d’IA attendent désormais leur tour : en lancer plusieurs à la fois ne ralentit pas votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività IA ora aspettano il loro turno, così avviarne diverse insieme non rallenta il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI の処理は順番待ちになったので、まとめて開始しても Mac が遅くなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 AI 작업이 차례를 기다리므로 여러 개를 한꺼번에 시작해도 Mac이 느려지지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-taken wachten nu op hun beurt, dus als je er meerdere tegelijk start, wordt je Mac niet traag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas de IA agora esperam a vez, então iniciar várias de uma vez não deixa seu Mac lento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 任务现在会排队依次进行，同时启动多个也不会拖慢你的 Mac。"
          }
        }
      }
    },
