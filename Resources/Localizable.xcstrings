        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초대한 Mac은 어디서나 여기에서 편집할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
