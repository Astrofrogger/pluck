    "Set in Pluck at the clip’s start; keyframe it here to match." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Pluck am Clipanfang gesetzt; setze hier Keyframes, damit es passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definido en Pluck al inicio del clip; añade aquí fotogramas clave para que coincida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défini dans Pluck au début du clip ; ajoutez ici des images clés pour l’égaler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
