    "A dot travels along the logo, the letters springing up as it passes, and lands in its place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt wandert über das Logo, die Buchstaben springen auf, wenn er vorbeikommt, und er landet an seinem Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto recorre el logo, las letras saltan a su paso y él aterriza en su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point parcourt le logo, les lettres jaillissent à son passage, puis il se pose à sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto percorre il logo, le lettere scattano su al suo passaggio e lui atterra al suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点がロゴの上を進み、通過した文字が跳ね上がり、最後に点が自分の位置に着地します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점이 로고를 따라 이동하며 지나가는 글자가 튀어 오르고, 마지막에 제자리에 착지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stip reist over het logo, de letters springen op als hij voorbijkomt, en landt op zijn plek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto percorre o logo, as letras saltam quando ele passa, e ele pousa no seu lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个圆点沿着标志移动，经过时字母依次弹起，最后落到自己的位置。"
          }
        }
      }
    },
    "A downloaded model file didn’t match its published checksum, so it was discarded.": {
