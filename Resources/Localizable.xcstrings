    "The main server is offline. Upload to the backup now? It moves to the main when it’s back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hauptserver ist offline. Jetzt auf das Backup hochladen? Die Datei wandert auf den Hauptserver, sobald er zurück ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor principal está desconectado. ¿Subir al respaldo ahora? Pasará al principal cuando vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur principal est hors ligne. Envoyer à la sauvegarde maintenant ? Le fichier passera sur le principal à son retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server principale è offline. Caricare ora sul backup? Passerà al principale quando torna."
