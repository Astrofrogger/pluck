        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음부터 끝까지 빠르게: 매 마디, 드롭에서도 매 마디, 길게 잡지 않음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
