        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck los reproduce y busca donde están. No se copia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck les lit et les cherche là où ils sont. Rien n’est copié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck li riproduce e li cerca dove si trovano. Non viene copiato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck はその場所のまま再生・検索します。何もコピーされません。"
