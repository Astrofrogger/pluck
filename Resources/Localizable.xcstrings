    "Click something in the Library and press Space to play it. The arrow keys move to the next one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Mediathek auf etwas und drücke die Leertaste, um es abzuspielen. Mit den Pfeiltasten geht es zum nächsten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en algo de la biblioteca y pulsa la barra espaciadora para reproducirlo. Las flechas pasan al siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément de la bibliothèque et appuyez sur Espace pour le lire. Les flèches passent au suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un elemento della libreria e premi Spazio per riprodurlo. Le frecce passano al successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリで項目をクリックしてスペースキーを押すと再生します。矢印キーで次へ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 항목을 클릭하고 스페이스 바를 누르면 재생됩니다. 화살표 키로 다음 항목으로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik iets aan in de bibliotheek en druk op de spatiebalk om het af te spelen. Met de pijltjestoetsen ga je naar het volgende."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em algo na biblioteca e pressione Espaço para reproduzir. As setas passam para o próximo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在资料库中点按一项并按空格键即可播放，用方向键切换到下一项。"
          }
        }
      }
    },
    "Click the scissors to download just part of a video, like 1:30 to 2:45.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Schere, um nur einen Teil eines Videos zu laden, etwa 1:30 bis 2:45."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en las tijeras para descargar solo una parte de un vídeo, como de 1:30 a 2:45."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur les ciseaux pour télécharger seulement une partie d’une vidéo, par exemple de 1:30 à 2:45."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulle forbici per scaricare solo una parte di un video, ad esempio da 1:30 a 2:45."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はさみをクリックすると、1:30 から 2:45 のようにビデオの一部だけをダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가위를 클릭하면 1:30부터 2:45까지처럼 비디오의 일부만 다운로드할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de schaar om maar een deel van een video te downloaden, zoals 1:30 tot 2:45."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na tesoura para baixar só uma parte de um vídeo, como de 1:30 a 2:45."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按剪刀即可只下载视频的一部分，例如从 1:30 到 2:45。"
          }
        }
      }
    },
    "Click the shortcut, then press the keys you want.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf den Kurzbefehl und drücke dann die gewünschten Tasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el atajo y pulsa las teclas que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le raccourci, puis appuyez sur les touches voulues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sull’abbreviazione, poi premi i tasti che vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをクリックして、使いたいキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 클릭한 다음 원하는 키를 누르십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de toetscombinatie en druk dan op de toetsen die je wilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no atalho e pressione as teclas que quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按快捷键，然后按下想用的按键。"
          }
        }
      }
    },
    "Click this link on your Mac to connect Pluck to the host Mac:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf deinem Mac auf diesen Link, um Pluck mit dem Host-Mac zu verbinden:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en este enlace en tu Mac para conectar Pluck con el Mac anfitrión:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur ce lien sur votre Mac pour connecter Pluck au Mac hôte :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su questo link sul tuo Mac per collegare Pluck al Mac host:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac でこのリンクをクリックすると、Pluck がホスト Mac に接続されます："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 이 링크를 클릭하면 Pluck이 호스트 Mac에 연결됩니다:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op je Mac op deze link om Pluck met de host-Mac te verbinden:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique neste link no seu Mac para conectar o Pluck ao Mac anfitrião:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上点按此链接，将 Pluck 连接到主机 Mac："
          }
        }
      }
    },
    "Click, then press the new shortcut. Esc cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke und drücke dann den neuen Kurzbefehl. Esc bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic y pulsa el nuevo atajo. Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez, puis tapez le nouveau raccourci. Échap annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic, poi premi la nuova abbreviazione. Esc annulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして新しいショートカットを押してください。Esc でキャンセル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭한 다음 새 단축키를 누르십시오. Esc를 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik en druk dan op de nieuwe toetscombinatie. Esc annuleert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique e pressione o novo atalho. Esc cancela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按，然后按下新的快捷键。按 Esc 取消。"
          }
        }
      }
    },
