    "Subtitles can now be translated into several languages at once, with local AI on your Mac.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels kunnen nu in één keer naar meerdere talen worden vertaald, met lokale AI op je Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel lassen sich jetzt mit lokaler KI auf deinem Mac in mehrere Sprachen auf einmal übersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-titres peuvent désormais être traduits en plusieurs langues à la fois, avec l’IA locale de votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora los subtítulos se pueden traducir a varios idiomas a la vez, con IA local en tu Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora i sottotitoli si possono tradurre in più lingue insieme, con l’IA locale sul tuo Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora as legendas podem ser traduzidas para vários idiomas de uma vez, com IA local no seu Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac上のローカルAIで、字幕を一度に複数の言語へ翻訳できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Mac의 로컬 AI로 자막을 한 번에 여러 언어로 번역할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可以用 Mac 上的本地 AI 一次将字幕翻译成多种语言。"
          }
        }
      }
    },
