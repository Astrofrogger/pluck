    "Cleans RAW photos from the sensor’s own data: crisper detail, cleaner shadows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinigt RAW-Fotos direkt aus den Sensordaten: schärfere Details, sauberere Schatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpia las fotos RAW desde los datos del propio sensor: más detalle y sombras más limpias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoie les photos RAW à partir des données du capteur : détails plus nets, ombres plus propres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulisce le foto RAW dai dati del sensore stesso: dettagli più nitidi, ombre più pulite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センサーのデータから直接RAW写真をクリーンにします。ディテールはより鮮明に、シャドウはよりきれいに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "센서 자체 데이터로 RAW 사진을 정리합니다. 더 선명한 디테일, 더 깨끗한 그림자."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt RAW-foto’s schoon vanuit de eigen sensordata: scherper detail, schonere schaduwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa fotos RAW a partir dos dados do próprio sensor: detalhes mais nítidos, sombras mais limpas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接用传感器数据清理 RAW 照片：细节更清晰，阴影更干净。"
          }
        }
      }
    },
