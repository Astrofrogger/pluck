        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een klein .xmp-bestand naast elke foto, dat Lightroom en Capture One lezen. Beoordelingen en labels uit die apps worden altijd gelezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
