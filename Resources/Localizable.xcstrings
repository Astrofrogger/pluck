    "Picks moments by sound; Apple Intelligence picks them by what’s said.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt Momente nach dem Klang; Apple Intelligence wählt sie nach dem Gesagten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige momentos por el sonido; Apple Intelligence los elige por lo que se dice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit les moments d’après le son ; Apple Intelligence les choisit d’après ce qui est dit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sceglie i momenti in base al suono; Apple Intelligence li sceglie in base a ciò che viene detto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音で場面を選びます。Apple Intelligence なら話の内容で選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리로 순간을 고릅니다. Apple Intelligence는 말한 내용으로 고릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiest momenten op geluid; Apple Intelligence kiest ze op wat er gezegd wordt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe momentos pelo som; a Apple Intelligence escolhe pelo que é dito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按声音挑选片段；Apple 智能则按所说内容挑选。"
          }
        }
      }
    },
