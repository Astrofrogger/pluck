        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você salvou com o Pluck em um só lugar, para sempre: coleções por tipo e site, suas etiquetas, busca, duplicados, arquivos ausentes e o espaço ocupado (⇧⌘L)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Pluck 存储的所有内容集中在一处并长期保留：按类型和网站分类的合集、你的标签、搜索、重复项、缺失文件和占用空间（⇧⌘L）。"
          }
        }
