    "Add watched folders on the Search page. The film engine is downloaded from the Photo page when you ask for it." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwachte Ordner fügst du auf der Seite „Suche“ hinzu. Die Film-Engine wird auf der Seite „Foto“ geladen, wenn du sie anforderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade carpetas vigiladas en la página Buscar. El motor de película se descarga desde la página Foto cuando lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dossiers surveillés dans la page Recherche. Le moteur film se télécharge depuis la page Photo quand vous le demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le cartelle sorvegliate nella pagina Cerca. Il motore pellicola si scarica dalla pagina Foto quando lo chiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監視フォルダは「検索」ページで追加します。フィルムエンジンは「写真」ページで依頼したときにダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감시 폴더는 검색 페이지에서 추가합니다. 필름 엔진은 사진 페이지에서 요청할 때 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg gevolgde mappen toe op de pagina Zoeken. De filmengine wordt gedownload vanaf de pagina Foto als je erom vraagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pastas monitoradas na página Buscar. O motor de filme é baixado na página Foto quando você pedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“搜索”页面添加监视文件夹。胶片引擎会在你于“照片”页面请求时下载。"
          }
        }
      }
    },
    "Add watched folders on the Search page. The films and the denoise engine are downloaded from the Photo page when you ask for them." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwachte Ordner fügst du auf der Seite „Suchen“ hinzu. Die Filme und die Entrausch-Engine werden auf der Seite „Foto“ geladen, wenn du sie anforderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade carpetas vigiladas en la página Buscar. Las películas y el motor de reducción de ruido se descargan desde la página Foto cuando los pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dossiers surveillés depuis la page Rechercher. Les films et le moteur de débruitage se téléchargent depuis la page Photo quand vous les demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le cartelle monitorate nella pagina Cerca. Le pellicole e il motore di riduzione del rumore si scaricano dalla pagina Foto quando li richiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "監視フォルダは「検索」ページで追加します。フィルムとノイズ除去エンジンは、必要なときに「写真」ページからダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감시 폴더는 검색 페이지에서 추가합니다. 필름과 노이즈 제거 엔진은 요청할 때 사진 페이지에서 내려받습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevolgde mappen voeg je toe op de pagina Zoeken. De films en de ruisengine worden vanaf de pagina Foto gedownload wanneer je erom vraagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pastas vigiadas na página Buscar. Os filmes e o motor de remoção de ruído são baixados na página Foto quando você pedir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“搜索”页面添加监视文件夹。胶片和降噪引擎会在你需要时从“照片”页面下载。"
          }
        }
