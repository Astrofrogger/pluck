            "value": "Bijwerken…"
          }
        }
      }
    },
    "Use at least two modifier keys, like ⌃⌥⌘D, so it doesn’t clash with shortcuts in other apps.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
