    "Who opened, watched and commented, with name and email. You keep this; tell your clients." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer geöffnet, angesehen und kommentiert hat, mit Name und E-Mail. Du bewahrst das auf – sag es deinen Kunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quién abrió, vio y comentó, con nombre y correo. Lo guardas tú; díselo a tus clientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui a ouvert, regardé et commenté, avec nom et e-mail. C’est vous qui le conservez ; informez vos clients."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi ha aperto, guardato e commentato, con nome ed e-mail. Lo conservi tu: dillo ai tuoi clienti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰が開き、視聴し、コメントしたか（名前とメール付き）。保存するのはあなたです。クライアントに伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누가 열고 보고 댓글을 남겼는지(이름과 이메일 포함). 보관하는 것은 본인이니 고객에게 알려 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie opende, keek en reageerde, met naam en e-mail. Jij bewaart dit; vertel het je klanten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem abriu, assistiu e comentou, com nome e e-mail. Quem guarda é você; avise seus clientes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谁打开、观看和评论过，包括姓名和邮箱。这由你保存，请告知你的客户。"
          }
        }
      }
    },
