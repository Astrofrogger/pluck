    "Turn a finished edit into 9:16, 1:1 and 4:5 versions that follow the subject." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach aus einem fertigen Schnitt 9:16-, 1:1- und 4:5-Versionen, die dem Motiv folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte un montaje terminado en versiones 9:16, 1:1 y 4:5 que siguen al sujeto."
          }
        },
        "fr" : {
          "stringUnit" : {
