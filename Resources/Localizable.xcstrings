    "Denoise" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrauschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir ruido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débruiter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci rumore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノイズ除去"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노이즈 제거"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruis verwijderen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover ruído"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降噪"
          }
        }
      }
    },
    "Denoise removes far more noise, and analyses each photo only once: Amount and the new Luminance and Colour sliders change live afterwards, as in Lightroom." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrauschen entfernt weit mehr Rauschen und analysiert jedes Foto nur einmal: Stärke und die neuen Regler Luminanz und Farbe ändern sich danach live, wie in Lightroom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reducción de ruido elimina mucho más ruido y analiza cada foto una sola vez: la Cantidad y los nuevos reguladores Luminancia y Color cambian en directo después, como en Lightroom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le débruitage supprime bien plus de bruit et n’analyse chaque photo qu’une fois : le Montant et les nouveaux curseurs Luminance et Couleur changent ensuite en direct, comme dans Lightroom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riduzione rumore rimuove molto più rumore e analizza ogni foto una sola volta: Quantità e i nuovi cursori Luminanza e Colore cambiano poi in tempo reale, come in Lightroom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノイズ除去ははるかに多くのノイズを取り除き、各写真の解析は一度だけです。その後は適用量と新しい輝度・カラーのスライダーがライブで変わります（Lightroomと同様）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노이즈 제거가 훨씬 더 많은 노이즈를 없애며 각 사진을 한 번만 분석합니다. 이후 양과 새 휘도·색상 슬라이더가 Lightroom처럼 실시간으로 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruisonderdrukking haalt veel meer ruis weg en analyseert elke foto maar één keer: Hoeveelheid en de nieuwe schuifregelaars Luminantie en Kleur veranderen daarna live, zoals in Lightroom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A redução de ruído remove muito mais ruído e analisa cada foto só uma vez: a Quantidade e os novos controles Luminância e Cor mudam ao vivo depois, como no Lightroom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "降噪能去除更多噪点，且每张照片只分析一次：之后数量以及新的明亮度和颜色滑块可实时调整，与 Lightroom 一样。"
          }
        }
      }
    },
    "Denoise uses the photo engine. Get it in the Film tab." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrauschen nutzt die Foto-Engine. Hol sie im Tab „Film“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir ruido usa el motor de fotos. Consíguelo en la pestaña Película."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le débruitage utilise le moteur photo. Obtenez-le dans l’onglet Film."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riduzione del rumore usa il motore foto. Scaricalo nella scheda Pellicola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノイズ除去はフォトエンジンを使います。「フィルム」タブで入手してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노이즈 제거는 사진 엔진을 사용합니다. 필름 탭에서 받으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruisonderdrukking gebruikt de foto-engine. Haal die op in het tabblad Film."
          }
        },
        "pt-BR" : {
