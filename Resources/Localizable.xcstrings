    "%@ is already on the NAS, but Pluck can’t read its host key (%@). Nothing was changed. Remove the app in TrueNAS › Apps, then install again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist schon auf dem NAS, aber Pluck kann seinen Host-Schlüssel nicht lesen (%2$@). Nichts wurde geändert. Entferne die App unter TrueNAS › Apps und installiere sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already on the NAS, but Pluck can’t read its host key (%2$@). Nothing was changed. Remove the app in TrueNAS › Apps, then install again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya está en el NAS, pero Pluck no puede leer su clave de host (%2$@). No se ha cambiado nada. Elimina la app en TrueNAS › Apps y vuelve a instalarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est déjà sur le NAS, mais Pluck ne peut pas lire sa clé d’hôte (%2$@). Rien n’a été modifié. Supprimez l’app dans TrueNAS › Apps, puis réinstallez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è già sul NAS, ma Pluck non riesce a leggerne la chiave host (%2$@). Non è stato cambiato nulla. Rimuovi l’app in TrueNAS › Apps, poi installala di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はすでに NAS 上にありますが、Pluck はそのホストキーを読み取れません（%2$@）。何も変更されていません。TrueNAS › Apps でアプリを削除してから、もう一度インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 이미 NAS에 있지만 Pluck이 호스트 키를 읽을 수 없습니다(%2$@). 아무것도 변경되지 않았습니다. TrueNAS › Apps에서 앱을 제거한 다음 다시 설치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ staat al op de NAS, maar Pluck kan de hostsleutel niet lezen (%2$@). Er is niets gewijzigd. Verwijder de app in TrueNAS › Apps en installeer opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ já está no NAS, mas o Pluck não consegue ler a chave do host (%2$@). Nada foi alterado. Remova o app em TrueNAS › Apps e instale de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已在 NAS 上，但 Pluck 无法读取它的主机密钥（%2$@）。未做任何更改。请在 TrueNAS › Apps 中移除该应用，然后重新安装。"
          }
        }
      }
    },
