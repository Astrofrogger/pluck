    "A small .xmp file next to each photo, which Lightroom and Capture One read. Ratings and labels from those apps are always read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kleine .xmp-Datei neben jedem Foto, die Lightroom und Capture One lesen. Bewertungen und Etiketten aus diesen Apps werden immer gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pequeño archivo .xmp junto a cada foto, que leen Lightroom y Capture One. Las valoraciones y etiquetas de esas apps siempre se leen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit fichier .xmp à côté de chaque photo, lu par Lightroom et Capture One. Les notes et étiquettes de ces apps sont toujours lues."
