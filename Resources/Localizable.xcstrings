          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck wijzigt nooit de netwerkinstellingen van je router of NAS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pluck nunca altera as configurações de rede do seu roteador ou NAS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck 从不更改你的路由器或 NAS 的网络设置。"
          }
        }
      }
    },
    "Pluck never deletes: originals and proxies go to “Pluck · Originals to delete”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck löscht nie: Originale und Proxys kommen in „Pluck · Originals to delete“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck nunca borra: los originales y proxies van a «Pluck · Originals to delete»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck ne supprime jamais : les originaux et les proxys vont dans « Pluck · Originals to delete »"
