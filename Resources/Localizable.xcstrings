    "Right-click a link and choose Services → Download with Pluck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf einen Link und wähle Dienste → Download with Pluck."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un enlace y elige Servicios → Download with Pluck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un lien et choisissez Services → Download with Pluck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un link e scegli Servizi → Download with Pluck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを右クリックして サービス → Download with Pluck を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 오른쪽 클릭하고 서비스 → Download with Pluck을 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op een link en kies Voorzieningen → Download met Pluck."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em um link e escolha Serviços → Download with Pluck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按链接，然后选择“服务”→“Download with Pluck”。"
          }
        }
      }
    },
    "Right-click something in the Library, scan the QR code, and it saves straight to your phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Mediathek mit der rechten Maustaste auf etwas, scanne den QR-Code, und es wird direkt auf deinem Telefon gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en algo de la biblioteca, escanea el código QR y se guarda directamente en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur un élément de la bibliothèque, scannez le code QR, et il s’enregistre directement sur votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic destro su un elemento della libreria, inquadra il codice QR e viene salvato direttamente sul telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリで項目を右クリックしてQRコードを読み取ると、スマートフォンに直接保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 항목을 오른쪽 클릭하고 QR 코드를 스캔하면 휴대폰에 바로 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik met de rechtermuisknop op iets in de bibliotheek, scan de QR-code en het wordt direct op je telefoon bewaard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em algo na biblioteca, escaneie o código QR e ele é salvo direto no celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在资料库中右键点按某项，扫描二维码，即可直接保存到手机。"
          }
        }
      }
    },
