    "AI Denoise for RAW" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Rauschreduzierung für RAW"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducción de ruido con IA para RAW"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduction du bruit par IA pour le RAW"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduzione rumore IA per RAW"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAW向けAIノイズ除去"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAW용 AI 노이즈 제거"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-ruisonderdrukking voor RAW"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redução de ruído com IA para RAW"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 RAW 的 AI 降噪"
          }
        }
      }
    },
    "AI Denoise no longer shows double edges, and profiles look right on JPEG and HEIC photos. Press Update on older photos to use the new engine." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Rauschreduzierung zeigt keine doppelten Kanten mehr, und Profile sehen bei JPEG- und HEIC-Fotos richtig aus. Bei älteren Fotos auf „Aktualisieren“ klicken, um die neue Engine zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reducción de ruido con IA ya no muestra bordes dobles y los perfiles se ven bien en fotos JPEG y HEIC. Pulsa Actualizar en las fotos antiguas para usar el nuevo motor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réduction du bruit par IA n’affiche plus de doubles contours, et les profils s’affichent correctement sur les photos JPEG et HEIC. Cliquez sur Mettre à jour sur les anciennes photos pour utiliser le nouveau moteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riduzione rumore IA non mostra più bordi doppi e i profili appaiono corretti sulle foto JPEG e HEIC. Premi Aggiorna sulle foto meno recenti per usare il nuovo motore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIノイズ除去で輪郭が二重にならなくなり、JPEGやHEICの写真でもプロファイルが正しく表示されます。以前の写真では「アップデート」を押すと新しいエンジンを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 노이즈 제거에서 가장자리가 이중으로 보이지 않으며, JPEG와 HEIC 사진에서도 프로필이 올바르게 보입니다. 이전 사진은 업데이트를 눌러 새 엔진을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-ruisonderdrukking toont geen dubbele randen meer en profielen zien er goed uit op JPEG- en HEIC-foto’s. Klik bij oudere foto’s op Werk bij om de nieuwe engine te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A redução de ruído com IA não mostra mais bordas duplas e os perfis ficam corretos em fotos JPEG e HEIC. Clique em Atualizar nas fotos antigas para usar o novo mecanismo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 降噪不再出现双重边缘，配置文件在 JPEG 和 HEIC 照片上也显示正确。在较早的照片上点按“更新”即可使用新引擎。"
          }
        }
      }
    },
    "AI Denoise now cleans RAW photos from the sensor’s own data: crisper detail, cleaner shadows." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Rauschreduzierung bereinigt RAW-Fotos jetzt direkt aus den Sensordaten: schärfere Details, sauberere Schatten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reducción de ruido con IA ahora limpia las fotos RAW a partir de los datos del propio sensor: detalle más nítido y sombras más limpias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réduction du bruit par IA nettoie désormais les photos RAW à partir des données du capteur : détails plus nets, ombres plus propres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riduzione rumore IA ora pulisce le foto RAW partendo dai dati del sensore: dettagli più nitidi, ombre più pulite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIノイズ除去がセンサー自体のデータからRAW写真をクリーンにします。よりシャープな細部、すっきりしたシャドウ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 노이즈 제거가 이제 센서 자체 데이터로 RAW 사진을 정리합니다. 더 선명한 디테일, 더 깨끗한 그림자."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-ruisonderdrukking maakt RAW-foto’s nu schoon vanuit de eigen gegevens van de sensor: scherper detail, schonere schaduwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A redução de ruído com IA agora limpa fotos RAW a partir dos dados do próprio sensor: detalhes mais nítidos, sombras mais limpas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 降噪现在直接根据传感器数据清理 RAW 照片：细节更清晰，阴影更干净。"
          }
        }
      }
    },
    "AI Remove, Liquify, HDR and panorama merges, Super Resolution and Auto Cull." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Entfernen, Verflüssigen, HDR- und Panorama-Zusammenführung, Super-Auflösung und automatisches Aussortieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar con IA, Licuar, fusión HDR y de panoramas, Superresolución y Selección automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer par IA, Fluidité, fusions HDR et panorama, Super résolution et Tri automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimozione IA, Fluidifica, unione HDR e panorama, Super risoluzione e Selezione automatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI除去、ゆがみ、HDR・パノラマ合成、超解像、自動選別。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 제거, 픽셀 유동화, HDR·파노라마 병합, 초해상도, 자동 선별."
          }
        },
        "nl" : {
