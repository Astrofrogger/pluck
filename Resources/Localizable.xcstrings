    "The frame rate changes during the video, which can drift out of sync on some platforms. Export at a constant frame rate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildrate ändert sich im Video, was auf manchen Plattformen asynchron werden kann. Exportiere mit konstanter Bildrate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia de fotogramas cambia durante el vídeo, lo que puede desincronizarse en algunas plataformas. Exporta a frecuencia constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cadence change pendant la vidéo, ce qui peut se désynchroniser sur certaines plateformes. Exportez à cadence constante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il frame rate cambia durante il video e su alcune piattaforme può andare fuori sincrono. Esporta a frame rate costante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画の途中でフレームレートが変わるため、一部のプラットフォームで音ずれすることがあります。固定フレームレートで書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상 중간에 프레임 레이트가 바뀌어 일부 플랫폼에서 싱크가 어긋날 수 있습니다. 고정 프레임 레이트로 내보내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De framerate verandert tijdens de video, wat op sommige platforms uit sync kan raken. Exporteer met een constante framerate."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A taxa de quadros muda durante o vídeo, o que pode sair de sincronia em algumas plataformas. Exporte com taxa constante."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频中帧率会变化，在某些平台上可能导致音画不同步。请以固定帧率导出。"
          }
        }
      }
    },
