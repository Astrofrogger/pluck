        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DJ ミックスやアルバム全体など、チャプタのあるビデオをチャプタごとに 1 ファイルで保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DJ 믹스나 전체 앨범처럼 챕터가 있는 비디오를 챕터마다 파일 하나로 저장합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video’s met hoofdstukken, zoals dj-mixen en volledige albums, worden als één bestand per hoofdstuk bewaard"
