    "Shapes slide in one after another, left to right.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formen gleiten nacheinander herein, von links nach rechts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las formas entran deslizándose una tras otra, de izquierda a derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formes glissent l’une après l’autre, de gauche à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forme scivolano dentro una dopo l’altra, da sinistra a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形が左から右へ順番にスライドして現れます。"
