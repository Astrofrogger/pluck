    "Overrides both of the above when set.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat Vorrang vor beiden oben, wenn gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se define, tiene prioridad sobre ambos de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les deux options ci-dessus si défini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se impostato, ha la precedenza su entrambe le opzioni sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定すると、上の両方より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정하면 위의 두 항목보다 우선합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft voorrang op beide opties hierboven als je het instelt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando definido, substitui as duas opções acima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置后将覆盖以上两项。"
          }
        }
      }
    },
