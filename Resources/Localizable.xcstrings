          }
        }
      }
    },
    "Keeps these adjustments and the film, to use on other photos." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert diese Anpassungen und den Film für andere Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda estos ajustes y la película para usarlos en otras fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ces réglages et le film pour d’autres photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva queste regolazioni e la pellicola per altre foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この調整とフィルムを保存して、ほかの写真に使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 조정과 필름을 저장해 다른 사진에 씁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart deze aanpassingen en de film, om op andere foto’s te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda estes ajustes e o filme para usar em outras fotos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存这些调整和胶片，用于其他照片。"
          }
        }
      }
    },
    "Keeps these adjustments and the film, to use on other photos. Masks of the sky, subject, people and faces are found again on each photo; brushed areas aren’t kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält diese Anpassungen und den Film für andere Fotos. Masken für Himmel, Motiv, Personen und Gesichter werden auf jedem Foto neu gefunden; gemalte Bereiche werden nicht übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda estos ajustes y la película para usarlos en otras fotos. Las máscaras de cielo, sujeto, personas y caras se vuelven a detectar en cada foto; las zonas pintadas no se guardan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve ces réglages et le film pour d’autres photos. Les masques du ciel, du sujet, des personnes et des visages sont retrouvés sur chaque photo ; les zones peintes ne sont pas conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene queste regolazioni e la pellicola per usarle su altre foto. Le maschere di cielo, soggetto, persone e volti vengono ritrovate su ogni foto; le aree dipinte non vengono mantenute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この調整とフィルムを他の写真で使えるように保存します。空、被写体、人物、顔のマスクは写真ごとに検出し直されます。ブラシで塗った部分は保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 조정과 필름을 다른 사진에 쓸 수 있게 저장합니다. 하늘, 피사체, 사람, 얼굴 마스크는 사진마다 다시 찾으며 브러시로 칠한 영역은 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart deze aanpassingen en de film voor andere foto’s. Maskers van lucht, onderwerp, mensen en gezichten worden op elke foto opnieuw gevonden; geschilderde gebieden worden niet bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda estes ajustes e o filme para usar em outras fotos. As máscaras de céu, assunto, pessoas e rostos são detectadas novamente em cada foto; áreas pintadas não são mantidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留这些调整和胶片，以用于其他照片。天空、主体、人物和面部蒙版会在每张照片上重新识别；画笔涂抹的区域不会保留。"
          }
        }
      }
    },
