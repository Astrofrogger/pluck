            "state": "translated",
            "value": "Jede Form federt herein, von der Mitte nach außen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada forma entra con un rebote, del centro hacia fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque forme entre avec un rebond, du centre vers l’extérieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni forma entra con un rimbalzo, dal centro verso l’esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各形状が中央から外へ弾むように現れます。"
          }
        },
        "ko": {
