    "On a camera card: nothing is saved there. Offload it first to keep the sync and its report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf einer Kamerakarte: Dort wird nichts gespeichert. Erst mit Offload kopieren, um die Synchronisierung und ihren Bericht zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una tarjeta de cámara: no se guarda nada allí. Descárgala primero para conservar la sincronización y su informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur une carte de caméra : rien n’y est enregistré. Déchargez-la d’abord pour garder la synchro et son rapport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su una scheda della videocamera: lì non si salva nulla. Scaricala prima per tenere la sincronizzazione e il suo report."
