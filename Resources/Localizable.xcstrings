    "%@ stops sending it copies and it can no longer connect. The app on it keeps running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schickt ihm keine Kopien mehr, und er kann sich nicht mehr verbinden. Die App darauf läuft weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deja de enviarle copias y ya no podrá conectarse. La app que tiene sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cesse de lui envoyer des copies et il ne peut plus se connecter. L’app qui s’y trouve continue de tourner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ smette di inviargli copie e non potrà più connettersi. L’app su di esso continua a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はコピーの送信を停止し、接続できなくなります。そこにあるアプリは動作し続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 더 이상 사본을 보내지 않으며 연결할 수 없게 됩니다. 그곳의 앱은 계속 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stuurt er geen kopieën meer naartoe en hij kan niet meer verbinden. De app erop blijft draaien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deixa de enviar cópias para ele e ele não consegue mais se conectar. O app nele continua funcionando."
