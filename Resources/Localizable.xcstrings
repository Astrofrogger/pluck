    "Bright highlights on HDR screens (a gain map); looks as usual everywhere else" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle Lichter auf HDR-Bildschirmen (eine Gain Map); überall sonst wie gewohnt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luces brillantes en pantallas HDR (un mapa de ganancia); en las demás se ve como siempre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hautes lumières éclatantes sur les écrans HDR (carte de gain) ; ailleurs, rendu habituel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luci brillanti sugli schermi HDR (una gain map); altrove l’aspetto è quello di sempre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDRディスプレイでは明るいハイライト（ゲインマップ）、それ以外では通常どおり"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR 화면에서는 밝은 하이라이트(게인 맵), 다른 곳에서는 평소대로"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heldere hoge lichten op HDR-schermen (een gain map); elders zoals gewoonlijk"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realces brilhantes em telas HDR (um mapa de ganho); nas demais, aparência normal"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 HDR 屏幕上呈现明亮高光（增益图）；其他屏幕显示如常"
