    "Split a song into vocals, drums, bass and other, plus a karaoke version, with an open-source AI model running locally on your Mac (macOS 27, Apple silicon).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenne einen Song in Gesang, Schlagzeug, Bass und Sonstiges, dazu eine Karaoke-Version, mit einem Open-Source-KI-Modell, das lokal auf deinem Mac läuft (macOS 27, Apple Chip)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa una canción en voz, batería, bajo y otros, más una versión karaoke, con un modelo de IA de código abierto que funciona localmente en tu Mac (macOS 27, chip de Apple)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparez un morceau en voix, batterie, basse et autres, plus une version karaoké, avec un modèle d’IA open source qui fonctionne localement sur votre Mac (macOS 27, puce Apple)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa un brano in voce, batteria, basso e altro, più una versione karaoke, con un modello di IA open source che funziona localmente sul tuo Mac (macOS 27, chip Apple)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲をボーカル、ドラム、ベース、その他とカラオケ版に分離します。Mac 上でローカルに動くオープンソースの AI モデルを使います（macOS 27、Apple シリコン）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 로컬로 실행되는 오픈 소스 AI 모델로 노래를 보컬, 드럼, 베이스, 기타와 노래방 버전으로 분리합니다(macOS 27, Apple 실리콘)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits een nummer in zang, drums, bas en overig, plus een karaokeversie, met een opensource AI-model dat lokaal op je Mac draait (macOS 27, Apple silicon)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe uma música em voz, bateria, baixo e outros, além de uma versão karaokê, com um modelo de IA de código aberto que roda localmente no seu Mac (macOS 27, chip da Apple)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用在你的 Mac 上本地运行的开源 AI 模型，将歌曲分离为人声、鼓、贝斯和其他音轨，外加卡拉 OK 版本（macOS 27，Apple 芯片）。"
          }
        }
      }
    },
