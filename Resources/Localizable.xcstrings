    "Enter the access code shown in Pluck on the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Zugangscode ein, den Pluck auf dem Mac anzeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de acceso que muestra Pluck en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code d’accès affiché par Pluck sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice di accesso mostrato da Pluck sul Mac."
          }
        },
        "ja": {
