    "Forget the host Mac on this Mac. Remove this Mac on the host Mac too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Host-Mac auf diesem Mac vergessen. Entferne diesen Mac auch auf dem Host-Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida el Mac anfitrión en este Mac. Elimina también este Mac en el Mac anfitrión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier le Mac hôte sur ce Mac. Retirez aussi ce Mac sur le Mac hôte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica il Mac host su questo Mac. Rimuovi questo Mac anche sul Mac host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac からホスト Mac の情報を削除します。ホスト Mac 側でもこの Mac を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 호스트 Mac 정보를 지웁니다. 호스트 Mac에서도 이 Mac을 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeet de host-Mac op deze Mac. Verwijder deze Mac ook op de host-Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquecer o Mac anfitrião neste Mac. Remova também este Mac no Mac anfitrião."
          }
        },
