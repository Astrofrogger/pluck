    "The background is for the title and end cards; lower thirds are always transparent." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrund gilt für Titel- und Abspann-Karte; Bauchbinden sind immer transparent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo es para la cartela de título y el cierre; los rótulos son siempre transparentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fond s’applique aux cartons de titre et de fin ; les synthés sont toujours transparents."
          }
        },
        "it" : {
          "stringUnit" : {
