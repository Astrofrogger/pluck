    "A new Support tab in Settings to buy me a coffee or star Pluck on GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Tab „Unterstützen“ in den Einstellungen, um mir einen Kaffee auszugeben oder Pluck auf GitHub einen Stern zu geben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nueva pestaña Apoyo en Ajustes para invitarme a un café o dar una estrella a Pluck en GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouvel onglet Soutien dans les Réglages pour m’offrir un café ou donner une étoile à Pluck sur GitHub."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo pannello Supporto in Impostazioni per offrirmi un caffè o dare una stella a Pluck su GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定に新しい「サポート」タブ。コーヒーをおごったり、GitHub で Pluck にスターを付けたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에 새로운 지원 탭이 생겼습니다. 커피 한 잔을 사 주거나 GitHub에서 Pluck에 별을 달아 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw tabblad Steun in Instellingen om me een koffie te trakteren of Pluck een ster te geven op GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova aba Apoio nos Ajustes para me pagar um café ou dar uma estrela ao Pluck no GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置”中新增“支持”标签页，可以请我喝杯咖啡，或在 GitHub 上为 Pluck 加星。"
          }
        }
      }
    },
