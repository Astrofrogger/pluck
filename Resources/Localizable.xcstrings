    "Songs get their lyrics, so they show up in Apple Music and on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs bekommen ihren Songtext, sodass er in Apple Music und auf dem iPhone erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones reciben su letra, que aparece en Apple Music y en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux reçoivent leurs paroles, qui s’affichent dans Apple Music et sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani ricevono il loro testo, che appare in Apple Music e su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲に歌詞が付くので、Apple Music や iPhone で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래에 가사가 포함되어 Apple Music과 iPhone에 표시됩니다."
          }
        },
        "nl": {
