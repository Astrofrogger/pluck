          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即查找新素材（每隔几小时也会自动进行）"
          }
        }
      }
    },
    "Look over a finished export before it goes out: flash frames, black, sound, loudness, typos in titles and more. Runs on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe einen fertigen Export, bevor er rausgeht: Blitzbilder, Schwarz, Ton, Lautheit, Tippfehler in Titeln und mehr. Läuft auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa una exportación terminada antes de enviarla: fotogramas sueltos, negro, sonido, sonoridad, erratas en los títulos y más. Funciona en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez un export terminé avant de l’envoyer : images flash, noir, son, sonie, fautes dans les titres et plus. Fonctionne sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla un export finito prima che parta: fotogrammi flash, nero, audio, loudness, refusi nei titoli e altro. Funziona su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成した書き出しを納品前にチェック：フラッシュフレーム、黒、音声、ラウドネス、タイトルの誤字など。この Mac で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 완성본을 보내기 전에 점검하세요: 플래시 프레임, 검은 화면, 소리, 라우드니스, 타이틀 오타 등. 이 Mac에서 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk een afgewerkte export voordat hij de deur uitgaat: flitsbeelden, zwart, geluid, luidheid, tikfouten in titels en meer. Draait op deze Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
