    "During long answers, cuts to the listener when they react, or to the wide shot." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei langen Antworten wird auf die zuhörende Person geschnitten, wenn sie reagiert, oder auf die Totale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En respuestas largas, corta a quien escucha cuando reacciona, o al plano general."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant les longues réponses, passe sur la personne qui écoute quand elle réagit, ou sur le plan large."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante le risposte lunghe, stacca su chi ascolta quando reagisce, o sul campo largo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長い回答の途中で、聞き手が反応したときに聞き手か引きのショットに切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 답변 중 듣는 사람이 반응하면 그 사람이나 와이드 샷으로 전환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij lange antwoorden wordt naar de luisteraar geknipt als die reageert, of naar het totaalshot."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em respostas longas, corta para quem ouve quando reage, ou para o plano aberto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在长回答中，当听者有反应时切到听者，或切到全景。"
          }
        }
      }
    },
