    "Logged ^[%lld clip](inflect: true) with ^[%lld marker](inflect: true) in “%@”. In Resolve, search the media pool or make smart bins on Keywords.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld Clip](inflect: true) mit ^[%lld Marker](inflect: true) in „%@“ protokolliert. Durchsuche in Resolve den Media Pool oder lege Smart Bins nach Stichwörtern an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld clip registrado](inflect: true) con ^[%lld marcador](inflect: true) en “%@”. En Resolve, busca en el Media Pool o crea Smart Bins por palabras clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld clip indexé](inflect: true) avec ^[%lld marqueur](inflect: true) dans « %@ ». Dans Resolve, recherchez dans le Media Pool ou créez des chutiers intelligents par mots-clés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld clip registrata](inflect: true) con ^[%lld marker](inflect: true) in “%@”. In Resolve, cerca nel Media Pool o crea Smart Bin per parole chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%3$@” の %1$lld 個のクリップに %2$lld 個のマーカーを記録しました。Resolve でメディアプールを検索するか、キーワードでスマートビンを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%3$@”에서 클립 %1$lld개에 마커 %2$lld개를 기록했습니다. Resolve에서 미디어 풀을 검색하거나 키워드로 스마트 빈을 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld clip(s) gelogd met %lld marker(s) in ‘%@’. Zoek in Resolve in de Media Pool of maak Smart Bins op trefwoorden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld clipe registrado](inflect: true) com ^[%lld marcador](inflect: true) em “%@”. No Resolve, pesquise no Media Pool ou crie Smart Bins por palavras-chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在“%3$@”中记录 %1$lld 个片段和 %2$lld 个标记。在 Resolve 中可搜索媒体池，或按关键词创建智能素材箱。"
          }
        }
      }
    },
