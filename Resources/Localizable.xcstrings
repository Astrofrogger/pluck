    "H.264 (plays everywhere)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (läuft überall)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (se reproduce en todas partes)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (lisible partout)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (si riproduce ovunque)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264（どこでも再生可能）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (어디서나 재생)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (speelt overal af)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 (toca em qualquer lugar)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264（随处可播放）"
          }
        }
      }
    },
    "H.264 video that plays everywhere. Files that are already compatible are only repackaged, without quality loss.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264-Video, das überall läuft. Bereits kompatible Dateien werden nur neu verpackt, ohne Qualitätsverlust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo H.264 que se reproduce en todas partes. Los archivos ya compatibles solo se reempaquetan, sin pérdida de calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéo H.264 lisible partout. Les fichiers déjà compatibles sont seulement réempaquetés, sans perte de qualité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Video H.264 che si riproduce ovunque. I file già compatibili vengono solo reimpacchettati, senza perdita di qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも再生できる H.264 ビデオ。すでに互換性のあるファイルは画質を落とさず入れ物だけを変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 재생되는 H.264 비디오입니다. 이미 호환되는 파일은 품질 손실 없이 다시 포장만 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264-video die overal afspeelt. Bestanden die al compatibel zijn, worden alleen opnieuw verpakt, zonder kwaliteitsverlies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo H.264 que toca em qualquer lugar. Arquivos já compatíveis são só reempacotados, sem perda de qualidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随处可播放的 H.264 视频。已兼容的文件只会重新封装，不损失画质。"
          }
        }
      }
    },
