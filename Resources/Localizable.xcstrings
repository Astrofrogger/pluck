            "state": "translated",
            "value": "Téléchargement de l’autre version… Pluck se rouvre tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download dell’altra versione… Pluck si riapre da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のバージョンをダウンロード中… Pluck は自動的に再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 버전을 다운로드하는 중… Pluck이 자동으로 다시 열립니다."
          }
        },
        "nl": {
