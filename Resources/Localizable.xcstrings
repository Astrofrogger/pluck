    "Use at least two modifier keys, like ⌃⌥⌘D, so it doesn’t clash with shortcuts in other apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens zwei Sondertasten, etwa ⌃⌥⌘D, damit es nicht mit Kurzbefehlen anderer Apps kollidiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa al menos dos teclas modificadoras, como ⌃⌥⌘D, para no chocar con atajos de otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez au moins deux touches de modification, comme ⌃⌥⌘D, pour éviter les conflits avec les raccourcis d’autres apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa almeno due tasti modificatori, come ⌃⌥⌘D, per non entrare in conflitto con le abbreviazioni di altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリのショートカットと重ならないよう、⌃⌥⌘D のように修飾キーを 2 つ以上使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 단축키와 겹치지 않도록 ⌃⌥⌘D처럼 보조 키를 두 개 이상 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik minstens twee speciale toetsen, zoals ⌃⌥⌘D, zodat de combinatie niet botst met andere apps."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos duas teclas modificadoras, como ⌃⌥⌘D, para não conflitar com atalhos de outros apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少使用两个修饰键（例如 ⌃⌥⌘D），以免与其他 App 的快捷键冲突。"
          }
        }
      }
    },
