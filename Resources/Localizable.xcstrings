    "Takes about %lld h on this Mac. Try part of the video first.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duurt ongeveer %lld u op deze Mac. Probeer eerst een deel van de video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert auf diesem Mac etwa %lld Std. Probiere zuerst einen Teil des Videos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %lld h sur ce Mac. Essayez d’abord une partie de la vidéo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda unas %lld h en este Mac. Prueba primero con una parte del vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede circa %lld h su questo Mac. Prova prima con una parte del video."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva cerca de %lld h neste Mac. Experimente primeiro uma parte do vídeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで約%lld時間かかります。まず動画の一部で試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 약 %lld시간 걸립니다. 먼저 동영상 일부로 해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上约需 %lld 小时。建议先试一小段视频。"
          }
        }
      }
    },
    "Takes about %lld min on this Mac.": {
