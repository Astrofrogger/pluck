    "Fusion, generator or compound clips (%@) aren’t rendered on the host Mac for other Macs. Render this one on your own Mac." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion-, Generator- oder Compound-Clips (%@) werden auf dem Host-Mac nicht für andere Macs gerendert. Rendere diesen auf deinem eigenen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips de Fusion, generadores o compuestos (%@) no se renderizan en el Mac anfitrión para otros Mac. Renderiza este en tu propio Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clips Fusion, générateurs ou composés (%@) ne sont pas rendus sur le Mac hôte pour d’autres Mac. Rendez celui-ci sur votre propre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le clip Fusion, generatori o composte (%@) non vengono renderizzate sul Mac host per altri Mac. Esegui il rendering di questo sul tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion・ジェネレータ・複合クリップ（%@）は、ホストMacで他のMac用にレンダリングされません。これは自分のMacでレンダリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion, 제너레이터 또는 컴파운드 클립(%@)은 호스트 Mac에서 다른 Mac을 위해 렌더링되지 않습니다. 이 항목은 내 Mac에서 렌더링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion-, generator- of compound-clips (%@) worden op de host-Mac niet voor andere Macs gerenderd. Render deze op je eigen Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipes Fusion, geradores ou compostos (%@) não são renderizados no Mac anfitrião para outros Macs. Renderize este no seu próprio Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusion、生成器或复合片段（%@）不会在主机 Mac 上为其他 Mac 渲染。请在你自己的 Mac 上渲染此项。"
          }
        }
      }
    },
