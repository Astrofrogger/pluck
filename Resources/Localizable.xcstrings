          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un PDF della giornata: ogni scheda e se è stata controllata, per persona e camera. Clicca per oggi; la freccia offre altri giorni e la condivisione."
