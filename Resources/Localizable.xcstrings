    },
    "Pluck never changes your router or NAS network settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck ändert nie die Netzwerkeinstellungen deines Routers oder NAS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck nunca cambia los ajustes de red de tu router o NAS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck ne modifie jamais les réglages réseau de votre routeur ou de votre NAS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck non modifica mai le impostazioni di rete del router o del NAS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck がルーターや NAS のネットワーク設定を変更することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
