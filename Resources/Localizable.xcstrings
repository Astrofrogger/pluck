    "ffmpeg isn’t installed, so merging video and converting audio will fail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg ist nicht installiert, daher schlagen das Zusammenführen von Video und die Audiokonvertierung fehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg no está instalado, así que unir vídeo y convertir audio fallará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg n’est pas installé : la fusion vidéo et la conversion audio vont échouer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg non è installato: l’unione dei video e la conversione audio non riusciranno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg がインストールされていないため、ビデオの結合とオーディオの変換は失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg가 설치되어 있지 않아 비디오 병합과 오디오 변환이 실패합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg is niet geïnstalleerd, dus video samenvoegen en audio omzetten zal mislukken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ffmpeg não está instalado, então juntar vídeo e converter áudio vai falhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 ffmpeg，因此合并视频和转换音频将会失败。"
          }
        }
      }
    },
