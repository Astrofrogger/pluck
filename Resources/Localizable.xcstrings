    "For when Macs can’t connect directly. Only your paired Macs and office Macs may use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den Fall, dass sich Macs nicht direkt verbinden können. Nur deine gekoppelten Macs und Büro-Macs dürfen es nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cuando los Mac no pueden conectarse directamente. Solo tus Mac vinculados y los de la oficina pueden usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les cas où les Mac ne peuvent pas se connecter directement. Seuls vos Mac jumelés et ceux du bureau peuvent l’utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per quando i Mac non riescono a collegarsi direttamente. Solo i tuoi Mac abbinati e quelli dell’ufficio possono usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 同士が直接接続できないとき用。使えるのはペアリング済みの Mac とオフィスの Mac だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac끼리 직접 연결할 수 없을 때 사용합니다. 페어링된 Mac과 사무실 Mac만 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor als Macs niet direct verbinding kunnen maken. Alleen je gekoppelde Macs en kantoor-Macs mogen hem gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para quando os Macs não conseguem se conectar diretamente. Só seus Macs pareados e os do escritório podem usá-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于 Mac 之间无法直接连接时。只有你已配对的 Mac 和办公室 Mac 可以使用。"
          }
        }
      }
    },
