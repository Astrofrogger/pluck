    "This Mac is an editor. An admin changes roles and approves invites." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac ist Editor. Ein Admin ändert Rollen und gibt Einladungen frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac es editor. Un administrador cambia los roles y aprueba las invitaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac est monteur. Un admin change les rôles et approuve les invitations."
          }
        },
        "it" : {
