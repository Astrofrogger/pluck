            "state": "translated",
            "value": "Deixe uma música exatamente do tamanho da sua edição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让歌曲与剪辑时长完全一致。"
          }
        }
      }
    },
    "Make an access token in Tailscale (Settings → Keys → Generate access token)…": {
      "localizations": {
