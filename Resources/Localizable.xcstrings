    },
    "It couldn’t be read: the card or drive may be damaged there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei konnte nicht gelesen werden: Die Karte oder das Laufwerk ist dort möglicherweise beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer: puede que la tarjeta o la unidad esté dañada en ese punto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de le lire : la carte ou le disque est peut-être endommagé à cet endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggerlo: la scheda o il disco potrebbe essere danneggiato in quel punto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込めませんでした。カードかドライブのその部分が損傷している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽을 수 없습니다. 카드나 드라이브의 해당 부분이 손상되었을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kon niet worden gelezen: de kaart of schijf is daar mogelijk beschadigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler: o cartão ou a unidade pode estar danificado nesse ponto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取：存储卡或磁盘的这部分可能已损坏。"
          }
        }
      }
    },
