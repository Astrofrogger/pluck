    "Look for new footage now (it also happens by itself every few hours)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nach neuem Material suchen (passiert auch automatisch alle paar Stunden)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar material nuevo ahora (también se hace solo cada pocas horas)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chercher de nouveaux rushes maintenant (cela se fait aussi tout seul toutes les quelques heures)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
