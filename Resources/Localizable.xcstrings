          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez à Pluck vos dossiers de rushes et trouvez vidéos et photos par leur contenu, dans votre langue. Tout fonctionne localement sur votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica a Pluck le cartelle del girato e trova video e foto per contenuto, nella tua lingua. Tutto funziona localmente sul tuo Mac."
          }
        },
