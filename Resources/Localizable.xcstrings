        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器已固定了另一个证书。请使用“重新配对”来更改。"
          }
        }
      }
    },
    "This server has no team. Restore “%@” so its links and passkeys keep working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
