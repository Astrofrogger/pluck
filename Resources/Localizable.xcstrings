    "This connection gives about %@/s, too slow to stream this smoothly. Download the proxies first: they’re ready in about %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verbindung liefert etwa %1$@/s, zu langsam, um das flüssig zu streamen. Lade zuerst die Proxys: Sie sind in etwa %2$@ fertig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This connection gives about %1$@/s, too slow to stream this smoothly. Download the proxies first: they’re ready in about %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión da unos %1$@/s, demasiado lenta para reproducir esto con fluidez. Descarga primero los proxies: estarán listos en unos %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion offre environ %1$@/s, trop lent pour diffuser cela sans à-coups. Téléchargez d’abord les proxys : ils seront prêts dans environ %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa connessione offre circa %1$@/s, troppo poco per riprodurlo in streaming senza intoppi. Scarica prima i proxy: saranno pronti in circa %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続の速度は約 %1$@/秒で、スムーズにストリーミングするには遅すぎます。先にプロキシをダウンロードしてください。約 %2$@ で準備できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결은 초당 약 %1$@로, 부드럽게 스트리밍하기엔 너무 느립니다. 먼저 프록시를 다운로드하세요. 약 %2$@ 후에 준비됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze verbinding levert ongeveer %1$@/s, te traag om dit soepel te streamen. Download eerst de proxy’s: ze zijn over ongeveer %2$@ klaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexão fornece cerca de %1$@/s, lenta demais para transmitir isso sem travar. Baixe os proxies primeiro: ficam prontos em cerca de %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此连接速度约为 %1$@/秒，太慢，无法流畅播放。请先下载代理：约 %2$@ 后即可就绪。"
          }
        }
      }
    },
