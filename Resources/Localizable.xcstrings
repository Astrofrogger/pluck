        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 순간의 상위 4분의 1을 남기고 나머지는 거부합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart het beste kwart van elk moment; wijst de rest af."
          }
