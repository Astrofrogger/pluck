    "Not paired: the server that answered isn’t the one in TrueNAS’s log. Check the NAS address, then install again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gekoppelt: Der Server, der geantwortet hat, ist nicht der aus dem TrueNAS-Log. Prüfe die NAS-Adresse und installiere erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vinculado: el servidor que respondió no es el del registro de TrueNAS. Comprueba la dirección del NAS y vuelve a instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non jumelé : le serveur qui a répondu n’est pas celui du journal de TrueNAS. Vérifiez l’adresse du NAS, puis réinstallez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbinato: il server che ha risposto non è quello nel log di TrueNAS. Controlla l’indirizzo del NAS, poi installa di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングされていません：応答したサーバーは TrueNAS のログにあるサーバーではありません。NAS のアドレスを確認してから、もう一度インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링되지 않음: 응답한 서버가 TrueNAS 로그의 서버가 아닙니다. NAS 주소를 확인한 다음 다시 설치하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet gekoppeld: de server die antwoordde is niet die uit het TrueNAS-log. Controleer het NAS-adres en installeer opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pareado: o servidor que respondeu não é o do log do TrueNAS. Verifique o endereço do NAS e instale de novo."
          }
