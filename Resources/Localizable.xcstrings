    },
    "Pluck isn’t allowed to save in “%@”. Choose another download folder in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck darf nicht in „%@“ speichern. Wähle in den Einstellungen einen anderen Download-Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck no tiene permiso para guardar en «%@». Elige otra carpeta de descargas en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck n’est pas autorisé à enregistrer dans « %@ ». Choisissez un autre dossier de téléchargement dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck non ha il permesso di salvare in “%@”. Scegli un’altra cartella di download nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck には「%@」に保存する権限がありません。設定で別のダウンロード先を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck에 ‘%@’에 저장할 권한이 없습니다. 설정에서 다른 다운로드 폴더를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck mag niet opslaan in ‘%@’. Kies een andere downloadmap in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pluck não tem permissão para salvar em “%@”. Escolha outra pasta de downloads nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck 无权保存到“%@”。请在设置中选择其他下载文件夹。"
          }
        }
      }
    },
    "Pluck keeps its own copies of the official yt-dlp release and a signed static ffmpeg build, plus the Deno runtime YouTube needs, checks for updates daily, and verifies every download against its published checksum." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck hält eigene Kopien der offiziellen yt-dlp-Version und eines signierten statischen ffmpeg-Builds sowie die Deno-Laufzeit, die YouTube braucht, sucht täglich nach Updates und prüft jeden Download anhand seiner veröffentlichten Prüfsumme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck guarda sus propias copias de la versión oficial de yt-dlp y de una compilación estática firmada de ffmpeg, además del entorno Deno que necesita YouTube, busca actualizaciones a diario y verifica cada descarga con su suma de comprobación publicada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck garde ses propres copies de la version officielle de yt-dlp et d’une version statique signée de ffmpeg, ainsi que l’environnement Deno dont YouTube a besoin, recherche les mises à jour chaque jour et vérifie chaque téléchargement avec sa somme de contrôle publiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck tiene copie proprie della versione ufficiale di yt-dlp e di una build statica firmata di ffmpeg, oltre al runtime Deno di cui YouTube ha bisogno, cerca aggiornamenti ogni giorno e verifica ogni download con il checksum pubblicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck は公式 yt-dlp リリースと署名済みの静的 ffmpeg ビルド、そして YouTube に必要な Deno ランタイムの独自のコピーを保持し、毎日アップデートを確認し、すべてのダウンロードを公開されたチェックサムで検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck은 공식 yt-dlp 릴리즈와 서명된 정적 ffmpeg 빌드, 그리고 YouTube에 필요한 Deno 런타임의 자체 사본을 유지하며, 매일 업데이트를 확인하고 모든 다운로드를 게시된 체크섬으로 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck houdt eigen kopieën bij van de officiële yt-dlp-versie, een ondertekende statische ffmpeg en de Deno-omgeving die YouTube nodig heeft. Pluck controleert dagelijks op updates en vergelijkt elke download met de gepubliceerde controlesom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pluck mantém cópias próprias da versão oficial do yt-dlp e de uma build estática assinada do ffmpeg, além do ambiente Deno de que o YouTube precisa, busca atualizações diariamente e verifica cada download com o checksum publicado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck 保留了官方 yt-dlp 版本、签名的静态 ffmpeg 版本以及 YouTube 所需的 Deno 运行时的独立副本，每天检查更新，并用已发布的校验和验证每次下载。"
          }
        }
      }
    },
    "Pluck keeps this folder up to date on this Mac, so you can edit offline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck hält diesen Ordner auf diesem Mac aktuell, damit du offline schneiden kannst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck mantiene esta carpeta al día en este Mac para que puedas editar sin conexión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck garde ce dossier à jour sur ce Mac pour que vous puissiez monter hors ligne"
