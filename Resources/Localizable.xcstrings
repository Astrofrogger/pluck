    "Couldn’t download ffmpeg, so merging video and converting audio will fail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ffmpeg konnte nicht geladen werden, daher schlagen das Zusammenführen von Video und die Audiokonvertierung fehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
