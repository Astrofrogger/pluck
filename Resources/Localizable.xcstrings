    "Type the NAS's address below and choose Connect. Pluck knows the host key already and keeps the certificate's fingerprint." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib unten die Adresse des NAS ein und wähle „Verbinden“. Pluck kennt den Host-Schlüssel bereits und merkt sich den Fingerabdruck des Zertifikats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe abajo la dirección del NAS y elige Conectar. Pluck ya conoce la clave del anfitrión y guarda la huella del certificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez ci-dessous l’adresse du NAS et choisissez Se connecter. Pluck connaît déjà la clé de l’hôte et conserve l’empreinte du certificat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi qui sotto l’indirizzo del NAS e scegli Connetti. Pluck conosce già la chiave dell’host e conserva l’impronta del certificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下に NAS のアドレスを入力して「接続」を選びます。Pluck はホストキーをすでに把握しており、証明書のフィンガープリントを保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 NAS 주소를 입력하고 연결을 선택하세요. Pluck는 호스트 키를 이미 알고 있으며 인증서 지문을 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ hieronder het adres van de NAS en kies Verbind. Pluck kent de hostsleutel al en bewaart de vingerafdruk van het certificaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite abaixo o endereço do NAS e escolha Conectar. O Pluck já conhece a chave do anfitrião e guarda a impressão digital do certificado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下方输入 NAS 的地址并选择“连接”。Pluck 已知道主机密钥，并会保存证书指纹。"
          }
        }
      }
    },
    "Type the NAS's address below and choose Connect. Pluck knows the host key already; check that the fingerprint it shows matches the log, then confirm." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib unten die Adresse des NAS ein und wähle „Verbinden“. Pluck kennt den Host-Schlüssel bereits; prüfe, ob der angezeigte Fingerabdruck mit dem Log übereinstimmt, und bestätige dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe abajo la dirección del NAS y elige Conectar. Pluck ya conoce la clave del host; comprueba que la huella que muestra coincide con el registro y confirma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez ci-dessous l’adresse du NAS et choisissez Connecter. Pluck connaît déjà la clé de l’hôte ; vérifiez que l’empreinte affichée correspond au journal, puis confirmez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi qui sotto l’indirizzo del NAS e scegli Collega. Pluck conosce già la chiave host; controlla che l’impronta mostrata corrisponda al log, poi conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下に NAS のアドレスを入力して「接続」を選んでください。Pluck はホストキーをすでに把握しています。表示されるフィンガープリントがログと一致することを確認してから、確定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 NAS 주소를 입력하고 연결을 선택하세요. Pluck은 이미 호스트 키를 알고 있습니다. 표시된 지문이 로그와 일치하는지 확인한 뒤 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ hieronder het adres van de NAS en kies Verbinden. Pluck kent de hostsleutel al; controleer of de getoonde vingerafdruk met het logboek overeenkomt en bevestig dan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite abaixo o endereço do NAS e escolha Conectar. O Pluck já conhece a chave do host; confira se a impressão digital mostrada confere com o registro e confirme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下方输入 NAS 的地址并选择“连接”。Pluck 已知道主机密钥；请核对显示的指纹是否与日志一致，然后确认。"
          }
        }
      }
    },
