    },
    "That pairing code isn’t right, or it has expired. Make a new one on the host Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kopplungscode stimmt nicht oder ist abgelaufen. Erstelle auf dem Host-Mac einen neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de vinculación no es correcto o ha caducado. Crea uno nuevo en el Mac anfitrión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de jumelage est incorrect ou a expiré. Créez-en un nouveau sur le Mac hôte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di abbinamento non è corretto o è scaduto. Creane uno nuovo sul Mac host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードが正しくないか、期限が切れています。ホスト Mac で新しいコードを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드가 올바르지 않거나 만료되었습니다. 호스트 Mac에서 새 코드를 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die koppelcode klopt niet of is verlopen. Maak een nieuwe op de host-Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de pareamento não está correto ou expirou. Crie um novo no Mac anfitrião."
          }
        },
