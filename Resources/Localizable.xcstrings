            "state": "translated",
            "value": "Metti album e playlist in una cartella propria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムとプレイリストを専用のフォルダに入れる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범과 재생목록을 별도 폴더에 넣기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet albums en afspeellijsten in een eigen map"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar álbuns e playlists em pasta própria"
          }
        },
        "zh-Hans": {
