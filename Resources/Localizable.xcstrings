            "value": "Collez un lien, ou tapez pour chercher sur YouTube"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un link o digita per cercare su YouTube"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをペースト、または入力して YouTube を検索"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
