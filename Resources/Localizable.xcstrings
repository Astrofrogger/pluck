    "Watch with the transcript, summary and chapters beside the video. Click a line to jump there." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau mit Transkript, Zusammenfassung und Kapiteln neben dem Video. Klicke auf eine Zeile, um dorthin zu springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira con la transcripción, el resumen y los capítulos junto al vídeo. Haz clic en una línea para saltar allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez avec la transcription, le résumé et les chapitres à côté de la vidéo. Cliquez sur une ligne pour y aller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda con trascrizione, riassunto e capitoli accanto al video. Fai clic su una riga per andarci."
          }
