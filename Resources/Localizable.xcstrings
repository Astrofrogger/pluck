          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem inteira sobre um fundo desfocado, para vídeos com muito texto e gráficos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模糊背景上显示完整画面，适合文字和图形较多的视频。"
          }
        }
      }
    },
