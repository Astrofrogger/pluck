    "Focus peaking: what's sharp shows green, the sharpest spot ringed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus-Peaking: Scharfes wird grün, die schärfste Stelle umkreist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realce de enfoque: lo nítido se ve en verde y lo más nítido, rodeado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus peaking : ce qui est net apparaît en vert, le point le plus net entouré"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus peaking: ciò che è nitido appare in verde, il punto più nitido cerchiato"
