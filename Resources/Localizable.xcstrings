          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me prévenir à l’ouverture"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisami quando viene aperto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開かれたら通知"
          }
        },
