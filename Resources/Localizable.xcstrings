    "yt-dlp exited with code %d.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp wurde mit Code %d beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp terminó con el código %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp s’est arrêté avec le code %d."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp è terminato con il codice %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp がコード %d で終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp가 코드 %d(으)로 종료되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp stopte met code %d."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O yt-dlp terminou com o código %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 已退出，代码 %d。"
          }
        }
      }
    },
    "yt-dlp isn’t installed, so nothing can be downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp ist nicht installiert, daher kann nichts heruntergeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp no está instalado, así que no se puede descargar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp n’est pas installé, rien ne peut donc être téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp non è installato, quindi non si può scaricare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp がインストールされていないため、何もダウンロードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp가 설치되어 있지 않아 아무것도 다운로드할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp is niet geïnstalleerd, dus er kan niets worden gedownload."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O yt-dlp não está instalado, então não dá para baixar nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装 yt-dlp，因此无法下载任何内容。"
          }
        }
      }
    },
    "yt-dlp not found. Install it with “brew install yt-dlp” or set its path in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp nicht gefunden. Installiere es mit „brew install yt-dlp“ oder lege seinen Pfad in den Einstellungen fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró yt-dlp. Instálalo con “brew install yt-dlp” o indica su ruta en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp introuvable. Installez-le avec « brew install yt-dlp » ou indiquez son chemin dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp non trovato. Installalo con “brew install yt-dlp” o imposta il suo percorso in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp が見つかりません。「brew install yt-dlp」でインストールするか、設定でパスを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp를 찾을 수 없습니다. ‘brew install yt-dlp’로 설치하거나 설정에서 경로를 지정하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp niet gevonden. Installeer het met “brew install yt-dlp” of stel het pad in bij Instellingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp não encontrado. Instale com “brew install yt-dlp” ou defina o caminho nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 yt-dlp。请用“brew install yt-dlp”安装，或在“设置”中设定其路径。"
          }
        }
      }
    },
