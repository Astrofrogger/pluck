    "Other Macs connect from anywhere over a private network built into Pluck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Macs verbinden sich von überall über ein in Pluck eingebautes privates Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros Mac se conectan desde cualquier lugar mediante una red privada integrada en Pluck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres Mac se connectent de partout via un réseau privé intégré à Pluck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri Mac si collegano da ovunque tramite una rete privata integrata in Pluck."
          }
