          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os Macs que você convidar podem editar aqui de qualquer lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
