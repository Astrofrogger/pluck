            "value" : "Bricht die Verbindung ab, wartet Pluck, bis das Internet wieder da ist, und macht weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se corta la conexión, Pluck espera a que vuelva internet y continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la connexion tombe, Pluck attend le retour d’Internet et reprend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la connessione cade, Pluck aspetta che internet torni e riprende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切れても、Pluck はインターネットが戻るのを待って続行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 끊기면 Pluck이 인터넷이 돌아올 때까지 기다렸다가 계속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valt de verbinding weg, dan wacht Pluck tot het internet terug is en gaat dan verder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a conexão cair, o Pluck espera a internet voltar e continua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果连接中断，Pluck 会等待网络恢复后继续。"
          }
        }
      }
    },
