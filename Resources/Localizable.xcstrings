    "Drop .srt or .vtt subtitles on Pluck to translate them to another language with local AI on your Mac. The translation is saved next to the original." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh .srt- oder .vtt-Untertitel auf Pluck, um sie mit lokaler KI auf deinem Mac in eine andere Sprache zu übersetzen. Die Übersetzung wird neben dem Original gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra subtítulos .srt o .vtt a Pluck para traducirlos a otro idioma con IA local en tu Mac. La traducción se guarda junto al original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez des sous-titres .srt ou .vtt sur Pluck pour les traduire dans une autre langue avec l’IA locale de votre Mac. La traduction est enregistrée à côté de l’original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sottotitoli .srt o .vtt su Pluck per tradurli in un’altra lingua con l’IA locale sul tuo Mac. La traduzione viene salvata accanto all’originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".srtや.vttの字幕をPluckにドロップすると、MacのローカルAIで別の言語に翻訳できます。翻訳は元のファイルの隣に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".srt 또는 .vtt 자막을 Pluck에 끌어다 놓으면 Mac의 로컬 AI로 다른 언어로 번역합니다. 번역은 원본 옆에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep .srt- of .vtt-ondertitels op Pluck om ze met lokale AI op je Mac naar een andere taal te vertalen. De vertaling wordt naast het origineel bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte legendas .srt ou .vtt no Pluck para traduzi-las para outro idioma com IA local no seu Mac. A tradução é salva ao lado do original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 .srt 或 .vtt 字幕拖到 Pluck 上，即可用 Mac 上的本地 AI 翻译成其他语言。译文保存在原文件旁边。"
          }
        }
      }
    },
    "Drop a JPG on a plain colour or a gradient and Pluck lifts the logo off it. Save as SVG turns your logo into a vector file, colour by colour." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh ein JPG auf einfarbigem oder verlaufendem Hintergrund hinein, und Pluck löst das Logo heraus. „Als SVG sichern“ macht aus deinem Logo eine Vektordatei, Farbe für Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta un JPG sobre un color liso o un degradado y Pluck separa el logo. Guardar como SVG convierte tu logo en un archivo vectorial, color a color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
