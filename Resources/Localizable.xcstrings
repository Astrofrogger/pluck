          "stringUnit": {
            "state": "translated",
            "value": "Acorta o alarga una canción a una duración exacta por sus frases musicales, conservando la intro y el final real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcissez ou allongez un morceau à une durée exacte sur ses phrases musicales, en gardant l’intro et la vraie fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accorcia o allunga un brano a una durata esatta sulle sue frasi musicali, mantenendo l’intro e il vero finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズ単位で曲をぴったりの長さに短く・長くします。イントロと本来のエンディングは残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레이즈 단위로 곡을 정확한 길이로 줄이거나 늘리며, 인트로와 원래 엔딩은 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort een nummer in of verleng het tot een exacte lengte op zijn muzikale frasen, met behoud van intro en echt einde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encurte ou alongue uma música para uma duração exata nas frases musicais, mantendo a introdução e o final real."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按乐句将歌曲缩短或延长到精确时长，保留前奏和真正的结尾。"
          }
        }
      }
    },
