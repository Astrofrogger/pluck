    "Titles in a shot always stay whole, and the rest of the shot stays on the people in it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel in einer Einstellung bleiben immer vollständig, der Rest bleibt auf den Personen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos de un plano siempre se ven completos, y el resto del plano se centra en las personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres d’un plan restent toujours entiers, et le reste du plan reste sur les personnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli in un’inquadratura restano sempre interi, e il resto resta sulle persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショット内のタイトルは常に全体が表示され、それ以外の部分は人物に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샷 안의 제목은 항상 전체가 보이고, 나머지는 인물에 맞춥니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titels in een shot blijven altijd heel, en de rest van het shot blijft op de mensen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos num plano ficam sempre inteiros, e o resto do plano fica nas pessoas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜头中的标题始终完整显示，其余部分对准人物。"
          }
        }
      }
    },
