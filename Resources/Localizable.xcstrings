    "Like “uhm” and “uh”, found in a transcript made on this Mac.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoals “eh” en “ehm”, gevonden in een transcript dat op deze Mac is gemaakt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „äh“ und „ähm“, gefunden in einem Transkript, das auf diesem Mac erstellt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme « euh » et « hum », trouvés dans une transcription faite sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “eh” y “em”, encontrados en una transcripción hecha en este Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come “ehm” e “uh”, trovati in una trascrizione fatta su questo Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como “é” e “hum”, encontrados em uma transcrição feita neste Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「えー」「あのー」など。このMacで作成した文字起こしから見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“음”, “어” 같은 말로, 이 Mac에서 만든 대본에서 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如“嗯”“呃”，从在此 Mac 上生成的转写中找出。"
          }
        }
      }
    },
