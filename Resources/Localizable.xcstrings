    "Shifts this camera’s dates in the copies so its photos sort with the others’; the originals aren’t changed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt die Daten dieser Kamera in den Kopien, damit ihre Fotos mit den anderen einsortiert werden; die Originale bleiben unverändert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza las fechas de esta cámara en las copias para que sus fotos se ordenen con las demás; los originales no cambian"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale les dates de cet appareil dans les copies pour que ses photos se classent avec les autres ; les originaux ne sont pas modifiés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le date di questa fotocamera nelle copie così le sue foto si ordinano con le altre; gli originali non cambiano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーのこのカメラの日時をずらし、他のカメラの写真と順に並ぶようにします。オリジナルは変更されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사본에서 이 카메라의 날짜를 이동해 다른 카메라 사진과 순서가 맞도록 합니다. 원본은 변경되지 않습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuift de datums van deze camera in de kopieën zodat de foto’s tussen de andere sorteren; de originelen blijven ongewijzigd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca as datas desta câmera nas cópias para que as fotos se ordenem com as outras; os originais não mudam"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在拷贝中平移这台相机的日期，使其照片与其他相机的照片按顺序排列；原始文件不会改变"
          }
        }
      }
    },
