          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo do Google: quase tão preciso e cerca de quatro vezes mais rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 的模型：准确度相近，速度快约四倍。"
          }
        }
      }
    },
    "H.264 (plays everywhere)": {
      "localizations": {
