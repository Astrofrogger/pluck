    "There’s no room left on “%@”. Make some room and try again: the download carries on where it stopped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf „%@“ ist kein Platz mehr. Schaffe Platz und versuche es erneut: Der Download macht dort weiter, wo er aufgehört hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda espacio en «%@». Libera espacio y vuelve a intentarlo: la descarga sigue donde se quedó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a plus de place sur « %@ ». Libérez de l’espace et réessayez : le téléchargement reprend là où il s’est arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è più spazio su “%@”. Libera spazio e riprova: il download riprende da dove si era fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に空き容量がありません。空きを作ってからもう一度試してください。ダウンロードは止まったところから続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 남은 공간이 없습니다. 공간을 확보한 뒤 다시 시도하세요. 다운로드는 멈춘 곳부터 이어집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen ruimte meer op ‘%@’. Maak ruimte en probeer het opnieuw: de download gaat verder waar hij stopte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há mais espaço em “%@”. Libere espaço e tente de novo: o download continua de onde parou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”上已没有空间。请腾出空间后再试：下载会从中断的地方继续。"
