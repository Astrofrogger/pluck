    },
    "The player no longer crashes on macOS 27, and summaries and chapters work better for Chinese, Japanese and Korean.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De speler crasht niet meer op macOS 27, en samenvattingen en hoofdstukken werken beter voor Chinees, Japans en Koreaans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Player stürzt unter macOS 27 nicht mehr ab, und Zusammenfassungen und Kapitel funktionieren besser für Chinesisch, Japanisch und Koreanisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur ne plante plus sous macOS 27, et les résumés et chapitres fonctionnent mieux en chinois, japonais et coréen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor ya no se cierra en macOS 27, y los resúmenes y capítulos funcionan mejor en chino, japonés y coreano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il player non si chiude più su macOS 27, e riassunti e capitoli funzionano meglio per cinese, giapponese e coreano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player não trava mais no macOS 27, e resumos e capítulos funcionam melhor para chinês, japonês e coreano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27でプレーヤーがクラッシュしなくなりました。また、中国語・日本語・韓国語の要約とチャプターが改善されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27에서 플레이어가 더 이상 충돌하지 않으며, 중국어·일본어·한국어의 요약과 챕터가 개선되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器在 macOS 27 上不再崩溃，中文、日语和韩语的摘要和章节效果也更好。"
          }
        }
      }
    },
    "The player no longer crashes on macOS 27. Summaries, chapters and shorts ask which language is spoken in your own files, work better in Chinese, Japanese and Korean, and file names no longer end in two dots.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De speler crasht niet meer op macOS 27. Samenvattingen, hoofdstukken en shorts vragen welke taal er gesproken wordt in je eigen bestanden, werken beter in het Chinees, Japans en Koreaans, en bestandsnamen eindigen niet meer op twee punten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Player stürzt unter macOS 27 nicht mehr ab. Zusammenfassungen, Kapitel und Shorts fragen nach der gesprochenen Sprache deiner eigenen Dateien, funktionieren besser auf Chinesisch, Japanisch und Koreanisch, und Dateinamen enden nicht mehr mit zwei Punkten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lecteur ne plante plus sous macOS 27. Les résumés, chapitres et shorts demandent la langue parlée dans vos propres fichiers, fonctionnent mieux en chinois, japonais et coréen, et les noms de fichiers ne finissent plus par deux points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reproductor ya no se cierra en macOS 27. Los resúmenes, capítulos y shorts preguntan el idioma hablado en tus propios archivos, funcionan mejor en chino, japonés y coreano, y los nombres de archivo ya no terminan en dos puntos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il player non si chiude più su macOS 27. Riassunti, capitoli e short chiedono la lingua parlata nei tuoi file, funzionano meglio in cinese, giapponese e coreano, e i nomi dei file non finiscono più con due punti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O player não trava mais no macOS 27. Resumos, capítulos e shorts perguntam o idioma falado nos seus próprios arquivos, funcionam melhor em chinês, japonês e coreano, e os nomes de arquivos não terminam mais com dois pontos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27でプレーヤーがクラッシュしなくなりました。要約、チャプター、ショートは自分のファイルで話されている言語を確認するようになり、中国語・日本語・韓国語での精度が上がり、ファイル名が2つのピリオドで終わらなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 27에서 플레이어가 더 이상 충돌하지 않습니다. 요약, 챕터, 쇼츠가 내 파일에서 쓰는 언어를 묻고, 중국어·일본어·한국어에서 더 잘 작동하며, 파일 이름이 마침표 두 개로 끝나지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放器在 macOS 27 上不再崩溃。摘要、章节和短视频会询问你自己的文件所用的语言，中文、日语和韩语效果更好，文件名也不再以两个句点结尾。"
          }
        }
      }
    },
    "The release has no checksum for the macOS build.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version hat keine Prüfsumme für den macOS-Build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión no tiene suma de comprobación para la compilación de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version n’a pas de somme de contrôle pour le build macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione non ha un checksum per la build macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリースには macOS ビルドのチェックサムがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "릴리즈에 macOS 빌드의 체크섬이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versie heeft geen controlesom voor de macOS-versie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão não tem checksum para a build do macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该版本没有 macOS 版本的校验和。"
          }
        }
      }
    },
    "The source was lossless and the file wasn’t converted to a lossy format": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle war verlustfrei, und die Datei wurde nicht in ein verlustbehaftetes Format konvertiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente era sin pérdida y el archivo no se convirtió a un formato con pérdida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source était sans perte et le fichier n’a pas été converti dans un format avec perte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sorgente era lossless e il file non è stato convertito in un formato con perdita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音源がロスレスで、ファイルも非可逆フォーマットに変換されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본이 무손실이었고 파일이 손실 포맷으로 변환되지 않았습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bron was lossless en het bestand is niet naar een lossy formaat geconverteerd"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte era sem perdas e o arquivo não foi convertido para um formato com perdas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音源为无损，且文件未转换为有损格式"
          }
        }
      }
    },
    "The stem model couldn’t be downloaded. Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stem-Modell konnte nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo de separación. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger le modèle de séparation. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello di separazione. Controlla la connessione a internet e riprova."
