    "The list survives quitting. Press Space for Quick Look, or drag a download into Finder or Mail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste bleibt nach dem Beenden erhalten. Drücke die Leertaste für die Übersicht oder zieh einen Download in den Finder oder in Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista se conserva al salir. Pulsa la barra espaciadora para Vista Rápida o arrastra una descarga al Finder o a Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste est conservée après avoir quitté. Appuyez sur Espace pour Coup d’œil, ou glissez un téléchargement dans le Finder ou Mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista resta dopo l’uscita. Premi Spazio per la Visualizzazione rapida o trascina un download nel Finder o in Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了してもリストは残ります。スペースキーでクイックルック、または Finder やメールにダウンロードをドラッグできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료해도 목록이 유지됩니다. 스페이스 바를 눌러 훑어보거나 다운로드를 Finder나 Mail로 드래그하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst blijft bewaard na het stoppen. Druk op de spatiebalk voor Snelle weergave, of sleep een download naar de Finder of Mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista continua após encerrar. Pressione Espaço para a Visualização Rápida ou arraste um download para o Finder ou o Mail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后列表仍会保留。按空格键快速查看，或将下载拖到“访达”或“邮件”中。"
          }
        }
      }
    },
    "The longest side of the photo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die längste Seite des Fotos"
          }
