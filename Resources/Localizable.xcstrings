    "Pinned folder full: %@ of %@. Raise the limit or unpin a folder. %lld files still to come." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angehefteter Ordner voll: %1$@ von %2$@. Erhöhe die Grenze oder löse einen Ordner. %3$lld Dateien stehen noch aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinned folder full: %1$@ of %2$@. Raise the limit or unpin a folder. %3$lld files still to come."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta fijada llena: %1$@ de %2$@. Sube el límite o deja de fijar una carpeta. Faltan %3$lld archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier épinglé plein : %1$@ sur %2$@. Augmentez la limite ou désépinglez un dossier. Encore %3$lld fichiers à venir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella fissata piena: %1$@ di %2$@. Alza il limite o togli una cartella. Mancano ancora %3$lld file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定したフォルダがいっぱいです：%2$@ 中 %1$@。上限を上げるか、フォルダの固定を解除してください。残り %3$lld 個のファイル。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 폴더가 가득 찼습니다: %2$@ 중 %1$@. 한도를 높이거나 폴더 고정을 해제하세요. 남은 파일 %3$lld개."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastgezette map vol: %1$@ van %2$@. Verhoog de limiet of maak een map los. Nog %3$lld bestanden te gaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta fixada cheia: %1$@ de %2$@. Aumente o limite ou desafixe uma pasta. Faltam %3$lld arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定的文件夹已满：%1$@ / %2$@。请提高上限或取消固定一个文件夹。还有 %3$lld 个文件待传。"
          }
        }
      }
    },
