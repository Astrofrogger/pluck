    "The link stops working. Its activity log and what pluck.tools keeps for it are deleted. Comments stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link funktioniert nicht mehr. Sein Aktivitätsprotokoll und was pluck.tools dafür speichert, werden gelöscht. Kommentare bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace deja de funcionar. Se eliminan su registro de actividad y lo que pluck.tools guarda de él. Los comentarios se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien ne fonctionne plus. Son journal d’activité et ce que pluck.tools conserve pour lui sont supprimés. Les commentaires restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link smette di funzionare. Il registro attività e ciò che pluck.tools conserva per esso vengono eliminati. I commenti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクは使えなくなります。アクティビティログと pluck.tools が保持しているデータは削除されます。コメントは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 더 이상 작동하지 않습니다. 활동 기록과 pluck.tools에 저장된 데이터가 삭제됩니다. 댓글은 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De link werkt niet meer. Het activiteitenlogboek en wat pluck.tools ervoor bewaart, worden verwijderd. Opmerkingen blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link para de funcionar. O registro de atividade e o que o pluck.tools guarda dele são apagados. Os comentários ficam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接将失效。其活动记录以及 pluck.tools 为其保存的数据会被删除。评论会保留。"
          }
        }
      }
    },
    "The list survives quitting. Press Space for Quick Look, or drag a download into Finder or Mail." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste bleibt nach dem Beenden erhalten. Drücke die Leertaste für die Übersicht oder zieh einen Download in den Finder oder in Mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se conserva al salir. Pulsa la barra espaciadora para Vista Rápida o arrastra una descarga al Finder o a Mail."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste est conservée après avoir quitté. Appuyez sur Espace pour Coup d’œil, ou glissez un téléchargement dans le Finder ou Mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista resta dopo l’uscita. Premi Spazio per la Visualizzazione rapida o trascina un download nel Finder o in Mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了してもリストは残ります。スペースキーでクイックルック、または Finder やメールにダウンロードをドラッグできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료해도 목록이 유지됩니다. 스페이스 바를 눌러 훑어보거나 다운로드를 Finder나 Mail로 드래그하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lijst blijft bewaard na het stoppen. Druk op de spatiebalk voor Snelle weergave, of sleep een download naar de Finder of Mail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
