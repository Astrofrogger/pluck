    "This NAS needs one last update by hand. In TrueNAS: Apps › %@ › Edit, replace the image with this one, then Save. After that it updates by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses NAS braucht ein letztes Update von Hand. In TrueNAS: Apps › %@ › Edit, ersetze das Image durch dieses und klicke auf Save. Danach aktualisiert es sich selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este NAS necesita una última actualización a mano. En TrueNAS: Apps › %@ › Edit, sustituye la imagen por esta y pulsa Save. Después se actualiza solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce NAS a besoin d’une dernière mise à jour à la main. Dans TrueNAS : Apps › %@ › Edit, remplacez l’image par celle-ci, puis Save. Ensuite, il se met à jour tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo NAS ha bisogno di un ultimo aggiornamento a mano. In TrueNAS: Apps › %@ › Edit, sostituisci l’immagine con questa, poi Save. Dopo si aggiorna da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この NAS は最後に一度だけ手動でアップデートが必要です。TrueNAS で Apps › %@ › Edit を開き、イメージをこれに置き換えて Save します。その後は自動でアップデートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 NAS는 마지막으로 한 번 직접 업데이트해야 합니다. TrueNAS에서 Apps › %@ › Edit을 열고 이미지를 이것으로 바꾼 다음 Save를 누르세요. 그 후에는 스스로 업데이트합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze NAS heeft nog één laatste update met de hand nodig. In TrueNAS: Apps › %@ › Edit, vervang de image door deze en klik op Save. Daarna werkt hij zichzelf bij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este NAS precisa de uma última atualização manual. No TrueNAS: Apps › %@ › Edit, substitua a imagem por esta e clique em Save. Depois ele se atualiza sozinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 NAS 需要最后一次手动更新。在 TrueNAS 中：Apps › %@ › Edit，将镜像替换为下面这个，然后点击 Save。之后它会自动更新。"
          }
        }
      }
    },
