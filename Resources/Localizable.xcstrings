    "Progress, speed and status now update smoothly instead of in jumps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt, Geschwindigkeit und Status werden jetzt flüssig statt sprunghaft aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso, la velocidad y el estado se actualizan con fluidez en lugar de a saltos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression, la vitesse et l’état se mettent à jour en douceur au lieu de par à-coups."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzamento, velocità e stato ora si aggiornano in modo fluido invece che a scatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行状況、速度、ステータスが飛び飛びではなく滑らかに更新されるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행률, 속도, 상태가 이제 끊기지 않고 부드럽게 업데이트됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voortgang, snelheid en status worden nu vloeiend bijgewerkt in plaats van met sprongen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresso, velocidade e status agora se atualizam suavemente em vez de aos saltos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度、速度和状态现在会平滑更新，不再跳动。"
          }
        }
      }
    },
    "Put albums and playlists in their own folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alben und Playlists in eigene Ordner legen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner álbumes y listas en su propia carpeta"
          }
        },
        "fr": {
