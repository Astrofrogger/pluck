    "Safari’s cookies need Full Disk Access: turn on Pluck in System Settings → Privacy & Security → Full Disk Access.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Cookies von Safari braucht Pluck Festplattenvollzugriff: Aktiviere Pluck unter Systemeinstellungen → Datenschutz & Sicherheit → Festplattenvollzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cookies de Safari necesitan acceso total al disco: activa Pluck en Ajustes del Sistema → Privacidad y seguridad → Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies de Safari nécessitent l’accès complet au disque : activez Pluck dans Réglages Système → Confidentialité et sécurité → Accès complet au disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cookie di Safari richiedono l’accesso completo al disco: attiva Pluck in Impostazioni di Sistema → Privacy e sicurezza → Accesso completo al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SafariのCookieにはフルディスクアクセスが必要です：「システム設定」→「プライバシーとセキュリティ」→「フルディスクアクセス」でPluckをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 쿠키에는 전체 디스크 접근 권한이 필요합니다: 시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한에서 Pluck을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de cookies van Safari is volledige schijftoegang nodig: zet Pluck aan in Systeeminstellingen → Privacy en beveiliging → Volledige schijftoegang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cookies do Safari precisam de Acesso Total ao Disco: ative o Pluck em Ajustes do Sistema → Privacidade e Segurança → Acesso Total ao Disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 的 Cookie 需要完全磁盘访问权限：请在“系统设置”→“隐私与安全性”→“完全磁盘访问权限”中打开 Pluck。"
          }
        }
      }
    },
