    "Download these languages in System Settings → General → Language & Region → Translation Languages, then try again: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade diese Sprachen unter Systemeinstellungen → Allgemein → Sprache & Region → Übersetzungssprachen und versuche es erneut: %@."
          }
        },
        "es": {
          "stringUnit": {
