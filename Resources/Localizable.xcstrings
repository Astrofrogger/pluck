        }
      }
    },
    "%@ is an rclone or FUSE mount: a copy there can’t be read back from the drive to check it. Choose a NAS share or a disk" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein rclone- oder FUSE-Laufwerk: Eine Kopie dort kann nicht vom Laufwerk zurückgelesen und geprüft werden. Wähle eine NAS-Freigabe oder ein Laufwerk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un montaje rclone o FUSE: una copia allí no se puede volver a leer del disco para comprobarla. Elige un recurso compartido del NAS o un disco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un montage rclone ou FUSE : une copie ne peut pas y être relue depuis le disque pour la vérifier. Choisissez un partage NAS ou un disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un montaggio rclone o FUSE: una copia lì non può essere riletta dal disco per controllarla. Scegli una condivisione NAS o un disco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は rclone または FUSE のマウントです：そこにあるコピーはドライブから読み戻して確認できません。NASの共有またはディスクを選んでください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) rclone 또는 FUSE 마운트입니다: 그곳의 사본은 드라이브에서 다시 읽어 확인할 수 없습니다. NAS 공유나 디스크를 선택하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is een rclone- of FUSE-koppeling: een kopie daar kan niet van de schijf worden teruggelezen om te controleren. Kies een NAS-share of een schijf"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é uma montagem rclone ou FUSE: uma cópia ali não pode ser lida de volta do disco para verificação. Escolha um compartilhamento do NAS ou um disco"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是 rclone 或 FUSE 装载：那里的副本无法从驱动器读回进行检查。请选择 NAS 共享或磁盘"
          }
        }
      }
    },
