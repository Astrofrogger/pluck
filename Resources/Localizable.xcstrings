            "state": "translated",
            "value": "Wähle Videos, Songs oder Fotos zum Konvertieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige vídeos, canciones o fotos para convertir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des vidéos, des morceaux ou des photos à convertir."
          }
