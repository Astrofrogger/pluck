    },
    "Search what was said in your videos and jump straight to that moment (⇧⌘F). Local AI understands questions, not just keywords.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche das Gesagte in deinen Videos und springe direkt zu der Stelle (⇧⌘F). Lokale KI versteht Fragen, nicht nur Stichwörter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca lo que se dice en tus vídeos y salta directamente a ese momento (⇧⌘F). La IA local entiende preguntas, no solo palabras clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez ce qui est dit dans vos vidéos et allez directement au bon moment (⇧⌘F). L’IA locale comprend les questions, pas seulement les mots-clés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca ciò che viene detto nei tuoi video e vai direttamente a quel momento (⇧⌘F). L’IA locale capisce le domande, non solo le parole chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオで話された内容を検索して、その場面に直接移動できます（⇧⌘F）。ローカル AI はキーワードだけでなく質問も理解します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오에서 말한 내용을 검색하고 그 순간으로 바로 이동합니다(⇧⌘F). 로컬 AI는 키워드뿐 아니라 질문도 이해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek wat er gezegd wordt in je video’s en spring meteen naar dat moment (⇧⌘F). Lokale AI begrijpt vragen, niet alleen trefwoorden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque o que é dito nos seus vídeos e vá direto ao momento (⇧⌘F). A IA local entende perguntas, não só palavras-chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索视频中所说的话，直接跳到那一刻（⇧⌘F）。本地 AI 能理解问题，而不只是关键词。"
          }
        }
      }
    },
