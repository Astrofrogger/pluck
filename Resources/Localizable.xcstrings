            "value" : "Sviluppa su pellicola"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィルムで現像"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필름으로 현상"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op film ontwikkelen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revelar em filme"
          }
        },
