    "Money is never expected. A star on GitHub helps more people discover Pluck and makes a real difference too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld wird nie erwartet. Ein Stern auf GitHub hilft mehr Leuten, Pluck zu entdecken, und macht auch einen echten Unterschied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se espera dinero. Una estrella en GitHub ayuda a que más gente descubra Pluck y también marca la diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun argent n’est attendu. Une étoile sur GitHub aide plus de gens à découvrir Pluck et fait aussi une vraie différence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno si aspetta denaro. Una stella su GitHub aiuta più persone a scoprire Pluck e fa davvero la differenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金は一切求めていません。GitHub でスターを付けてもらえると、より多くの人が Pluck を知るきっかけになり、大きな力になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돈은 절대 기대하지 않습니다. GitHub의 별 하나가 더 많은 사람이 Pluck을 알게 하는 데 실제로 큰 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld wordt nooit verwacht. Een ster op GitHub helpt meer mensen Pluck te ontdekken en maakt ook echt een verschil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém espera dinheiro. Uma estrela no GitHub ajuda mais pessoas a descobrir o Pluck e também faz uma diferença real."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不期待金钱回报。在 GitHub 上加颗星能帮助更多人发现 Pluck，同样意义重大。"
          }
        }
      }
    },
