    "Pick the one that fits you. You can switch any time in Settings, and your downloads, Library and settings stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die passende Version. Du kannst jederzeit in den Einstellungen wechseln; deine Downloads, Mediathek und Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la que mejor te encaje. Puedes cambiar cuando quieras en Ajustes, y tus descargas, Biblioteca y ajustes se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez celle qui vous convient. Vous pouvez changer à tout moment dans les Réglages ; vos téléchargements, votre Bibliothèque et vos réglages sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quella che fa per te. Puoi cambiare quando vuoi nelle Impostazioni; download, Libreria e impostazioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合うほうを選んでください。設定でいつでも切り替えられ、ダウンロード、ライブラリ、設定はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞는 버전을 고르세요. 설정에서 언제든지 바꿀 수 있으며 다운로드, 보관함, 설정은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat bij je past. Je kunt altijd wisselen in Instellingen; je downloads, bibliotheek en instellingen blijven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a que combina com você. Você pode trocar a qualquer momento nos Ajustes, e seus downloads, Biblioteca e ajustes continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择适合你的版本。你可以随时在设置中切换，下载内容、资料库和设置都会保留。"
          }
        }
      }
    },
