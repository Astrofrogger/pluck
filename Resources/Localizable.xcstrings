    "Judges every shot for focus, light, shake, faces, action and its look. Slower than listening only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beurteilt jede Einstellung nach Schärfe, Licht, Wackeln, Gesichtern, Action und Look. Langsamer als nur Zuhören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evalúa cada plano por enfoque, luz, temblor, caras, acción y estética. Más lento que solo escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juge chaque plan sur la netteté, la lumière, les tremblements, les visages, l’action et le style. Plus lent que l’écoute seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta ogni inquadratura per messa a fuoco, luce, mosso, volti, azione e look. Più lento del solo ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ショットのピント、光、ブレ、顔、動き、ルックを判定します。音声だけより時間がかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샷마다 초점, 빛, 흔들림, 얼굴, 동작, 룩을 판단합니다. 소리만 들을 때보다 느립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beoordeelt elke shot op scherpte, licht, beweging, gezichten, actie en look. Trager dan alleen luisteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avalia cada plano por foco, luz, tremor, rostos, ação e estética. Mais lento do que só ouvir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从对焦、光线、抖动、人脸、动作和画面风格评估每个镜头。比只听声音慢。"
          }
        }
      }
    },
