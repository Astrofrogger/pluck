    "Couldn’t read this browser’s cookies. Pick another browser (or None) in Settings → Advanced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cookies dieses Browsers konnten nicht gelesen werden. Wähle unter Einstellungen → Erweitert einen anderen Browser (oder Keinen)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
