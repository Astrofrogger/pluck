    "Platforms turn it down, so it gains nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plattformen regeln es herunter, es bringt also nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plataformas lo bajan, así que no gana nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plateformes le baissent, donc il n’y gagne rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piattaforme lo abbassano, quindi non guadagna nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラットフォーム側で音量が下げられるので、得はありません。"
