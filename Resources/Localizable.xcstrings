          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やか"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분함"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rustig"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calmo"
          }
        },
        "zh-Hans" : {
