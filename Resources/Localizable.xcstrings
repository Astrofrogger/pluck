    "Download the link you copied from any app with ⌃⌥⌘D, or set your own shortcut in Settings → General.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade den kopierten Link aus jeder App mit ⌃⌥⌘D, oder lege unter Einstellungen → Allgemein deinen eigenen Kurzbefehl fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el enlace copiado desde cualquier app con ⌃⌥⌘D, o define tu propio atajo en Ajustes → General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez le lien copié depuis n’importe quelle app avec ⌃⌥⌘D, ou choisissez votre propre raccourci dans Réglages → Général."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il link copiato da qualsiasi app con ⌃⌥⌘D, oppure imposta la tua abbreviazione in Impostazioni → Generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたリンクを ⌃⌥⌘D でどのアプリからでもダウンロードできます。ショートカットは 設定 → 一般 で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 앱에서나 ⌃⌥⌘D로 복사한 링크를 다운로드하거나, 설정 → 일반에서 나만의 단축키를 지정하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download de gekopieerde link vanuit elke app met ⌃⌥⌘D, of kies je eigen sneltoets in Instellingen → Algemeen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o link copiado de qualquer app com ⌃⌥⌘D, ou defina seu próprio atalho em Ajustes → Geral."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意 App 中按 ⌃⌥⌘D 即可下载拷贝的链接，也可以在“设置”→“通用”中设定自己的快捷键。"
          }
        }
      }
    },
