    "Smaller, for Macs with 16 GB of memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner, für Macs mit 16 GB Arbeitsspeicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más pequeño, para Mac con 16 GB de memoria."
          }
        },
        "fr": {
