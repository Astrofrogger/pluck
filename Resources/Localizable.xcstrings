        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichter gefunden: Klicke auf die Personen, die scharf bleiben sollen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caras encontradas: haz clic en las personas que deben quedar nítidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visages trouvés : cliquez sur les personnes qui doivent rester nettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volti trovati: fai clic sulle persone che devono restare nitide."
          }
