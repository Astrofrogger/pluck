            "value": "El archivo original se movió o eliminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d’origine a été déplacé ou supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file originale è stato spostato o eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルが移動または削除されました。"
          }
        },
        "ko": {
