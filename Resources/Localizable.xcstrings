    "Too short for the real ending, so it fades out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu kurz für das echte Ende, daher wird ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado corto para el final real, así que se desvanece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop court pour la vraie fin, donc fondu en sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo corto per il vero finale, quindi sfuma."
          }
        },
        "ja": {
          "stringUnit": {
