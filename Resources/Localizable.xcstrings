          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os movimentos ficam um pouco mais rápidos para caber."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作会稍微加快以适应时长。"
          }
        }
      }
    },
    "The open project in DaVinci Resolve has no video clips Pluck can reach.": {
      "localizations": {
