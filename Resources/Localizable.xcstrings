    "Contrast (hold and scroll)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrast (halten und scrollen)"
          }
        },
        "es" : {
          "stringUnit" : {
