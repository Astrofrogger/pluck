        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버에는 이미 다른 인증서가 고정되어 있습니다. 바꾸려면 ‘다시 페어링’을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
