    },
    "Only for cutting. Grades made on these proxies won’t match the render. Grade at the office or turn this off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zum Schneiden. Grades auf diesen Proxys passen nicht zum Render. Grade im Büro oder schalte das aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para montar. Las correcciones de color hechas sobre estos proxies no coincidirán con el render. Corrige el color en la oficina o desactiva esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour le montage. Un étalonnage fait sur ces proxys ne correspondra pas au rendu. Étalonnez au bureau ou désactivez ceci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per il montaggio. Le correzioni colore fatte su questi proxy non corrisponderanno al render. Correggi in ufficio o disattiva questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カット専用です。このプロキシで行ったグレーディングはレンダリングと一致しません。オフィスでグレーディングするか、これをオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컷 편집 전용입니다. 이 프록시에서 한 그레이딩은 렌더와 맞지 않습니다. 사무실에서 그레이딩하거나 이 옵션을 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen om te monteren. Grades op deze proxy’s komen niet overeen met de render. Grade op kantoor of zet dit uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só para cortar. A correção de cor feita nestes proxies não vai bater com o render. Corrija no escritório ou desative isto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于剪辑。在这些代理上做的调色与渲染结果不一致。请在办公室调色，或关闭此选项。"
          }
        }
      }
    },
