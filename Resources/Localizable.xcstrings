    "This Mac can then browse its media and keep review data there, from anywhere." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann dann von überall seine Medien durchsuchen und Review-Daten dort ablegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac podrá entonces explorar sus medios y guardar allí los datos de revisión, desde cualquier lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac pourra alors parcourir ses médias et y conserver les données de relecture, où que vous soyez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
