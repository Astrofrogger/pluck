    "Video: ready to watch (Rec.709). As Shot: as the camera was set. Log: flat, for grading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video: zum Ansehen (Rec.709). Aufnahme: wie in der Kamera eingestellt. Log: flach, zum Graden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo: listo para ver (Rec.709). Grabado: como estaba ajustada la cámara. Log: plano, para etalonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo : prêt à regarder (Rec.709). Prise de vue : comme réglé sur la caméra. Log : plat, pour l’étalonnage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video: pronto da guardare (Rec.709). Scatto: come impostato in camera. Log: piatto, per il grading."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオ：そのまま見られる（Rec.709）。撮影時：カメラの設定どおり。Log：グレーディング用のフラットな画。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오: 바로 볼 수 있음(Rec.709). 촬영 설정: 카메라 설정대로. Log: 그레이딩용 플랫."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video: klaar om te bekijken (Rec.709). Opname: zoals de camera stond. Log: vlak, om te graden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo: pronto para ver (Rec.709). Gravado: como a câmera estava. Log: plano, para colorização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频：可直接观看（Rec.709）。拍摄设置：按相机设置。Log：平坦画面，用于调色。"
          }
        }
      }
    },
