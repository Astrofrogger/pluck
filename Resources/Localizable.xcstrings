    },
    "That version of Pluck isn’t available to download yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von Pluck gibt es noch nicht zum Laden."
          }
        },
        "es": {
          "stringUnit": {
