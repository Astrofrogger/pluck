    "Look over a finished export before it goes out: flash frames, black, sound, loudness, typos in titles and more." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe einen fertigen Export, bevor er rausgeht: Blitzbilder, Schwarz, Ton, Lautheit, Tippfehler in Titeln und mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa una exportación terminada antes de enviarla: fotogramas sueltos, negro, sonido, sonoridad, erratas en los títulos y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez un export fini avant qu’il parte : images flash, noir, son, sonie, fautes dans les titres et plus encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla un export finito prima che parta: fotogrammi flash, nero, audio, loudness, refusi nei titoli e altro."
