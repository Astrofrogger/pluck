    },
    "Ask for Files links put their files straight into folders of %@; nothing there is ever replaced. The app needs write access to it. Off: Pluck moves them there from an office Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links von „Dateien anfragen“ legen ihre Dateien direkt in Ordner von %@; dort wird nie etwas ersetzt. Die App braucht Schreibzugriff darauf. Aus: Pluck verschiebt sie von einem Büro-Mac dorthin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces de Pedir archivos ponen sus archivos directamente en carpetas de %@; allí nunca se reemplaza nada. La app necesita permiso de escritura. Desactivado: Pluck los mueve allí desde un Mac de la oficina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens Demander des fichiers déposent leurs fichiers directement dans des dossiers de %@ ; rien n’y est jamais remplacé. L’app doit pouvoir y écrire. Désactivé : Pluck les y déplace depuis un Mac du bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I link Chiedi file mettono i file direttamente nelle cartelle di %@; lì non viene mai sostituito nulla. L’app deve poterci scrivere. Disattivato: Pluck li sposta lì da un Mac dell’ufficio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ファイルを依頼」リンクのファイルは %@ のフォルダに直接入り、既存のものが置き換えられることはありません。アプリに書き込み権限が必要です。オフ：オフィスの Mac から Pluck がそこへ移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘파일 요청’ 링크의 파일은 %@의 폴더로 바로 들어가며 기존 파일은 절대 바뀌지 않습니다. 앱에 쓰기 권한이 필요합니다. 끔: 사무실 Mac에서 Pluck이 그곳으로 옮깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links van Om bestanden vragen zetten hun bestanden direct in mappen van %@; daar wordt nooit iets vervangen. De app moet er kunnen schrijven. Uit: Pluck verplaatst ze daarheen vanaf een kantoor-Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links de Pedir arquivos colocam os arquivos direto em pastas de %@; nada lá é substituído. O app precisa de permissão de escrita. Desativado: o Pluck os move para lá a partir de um Mac do escritório."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“索取文件”链接的文件会直接放入 %@ 的文件夹，那里的内容永远不会被替换。应用需要对其有写入权限。关闭：由办公室 Mac 上的 Pluck 移过去。"
          }
        }
      }
    },
