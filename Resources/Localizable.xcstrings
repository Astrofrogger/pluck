    },
    "There are no pauses or filler words to remove at this setting.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen pauzes of stopwoorden om te verwijderen met deze instelling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei dieser Einstellung gibt es keine Pausen oder Füllwörter zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pause ni hésitation à supprimer avec ce réglage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay pausas ni muletillas que quitar con este ajuste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa impostazione non ci sono pause o intercalari da rimuovere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há pausas nem vícios de fala para remover com esta opção."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定では削除する間やフィラーはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정에서는 제거할 쉼이나 군말이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设置下没有可删除的停顿或口头禅。"
          }
        }
      }
    },
    "There isn’t enough memory to process this video.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
