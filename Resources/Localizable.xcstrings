    "Shot at a different speed and developed to match: more contrast pushed, less pulled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit anderer Empfindlichkeit belichtet und passend entwickelt: gepusht mehr Kontrast, gepullt weniger"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disparada a otra sensibilidad y revelada a juego: forzada da más contraste, subrevelada menos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exposé à une autre sensibilité et développé en conséquence : plus de contraste poussé, moins retenu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esposta a un’altra sensibilità e sviluppata di conseguenza: più contrasto in push, meno in pull"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "異なる感度で撮影して合わせて現像：増感でコントラスト増、減感で減"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 감도로 찍고 맞춰 현상: 증감하면 대비가 높고, 감감하면 낮습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op een andere gevoeligheid geschoten en zo ontwikkeld: push geeft meer contrast, pull minder"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografado em outra sensibilidade e revelado de acordo: puxado dá mais contraste, empurrado menos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以不同感光度拍摄并相应冲洗：增感对比更高，减感更低"
          }
        }
      }
    },
