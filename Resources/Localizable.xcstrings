        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지에서 로고를 찾지 못했습니다. 투명하거나 단색 배경의 PNG 또는 SVG를 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck vond geen logo in deze afbeelding. Probeer een PNG of SVG met een transparante of effen achtergrond."
