    "%@ has %@ free and the masters need about %@ until you delete the originals: archive to another folder or NAS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ frei, und die Master brauchen etwa %3$@, bis du die Originale löschst: archiviere in einen anderen Ordner oder NAS"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene %2$@ libres y los másteres necesitan unos %3$@ hasta que borres los originales: archiva en otra carpeta o NAS"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a %2$@ libres et les masters ont besoin d’environ %3$@ jusqu’à ce que vous supprimiez les originaux : archivez vers un autre dossier ou NAS"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha %2$@ liberi e i master richiedono circa %3$@ finché non elimini gli originali: archivia in un’altra cartella o NAS"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の空きは %2$@ で、オリジナルを削除するまでマスターに約 %3$@ 必要です：別のフォルダまたは NAS にアーカイブしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 여유 공간은 %2$@이고 원본을 삭제할 때까지 마스터에 약 %3$@이 필요합니다: 다른 폴더나 NAS로 보관하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft %2$@ vrij en de masters hebben ongeveer %3$@ nodig tot je de originelen verwijdert: archiveer naar een andere map of NAS"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tem %2$@ livres e os masters precisam de cerca de %3$@ até você apagar os originais: arquive em outra pasta ou NAS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 剩余 %2$@，在删除原始文件前母版约需 %3$@：请归档到其他文件夹或 NAS"
          }
        }
      }
    },
    "%@ is nearly full: delete what’s waiting in “Pluck · Originals to delete”, or archive to another folder or NAS" : {
