    "Follows the speaker or subject, and shows titles whole.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt dem Sprecher oder Motiv und zeigt Titel vollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue al orador o al sujeto y muestra los títulos completos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit l’orateur ou le sujet, et montre les titres en entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue l’oratore o il soggetto e mostra i titoli per intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話している人や被写体を追い、タイトルは全体を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 사람이나 피사체를 따라가고 제목은 전체를 보여 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgt de spreker of het onderwerp, en toont titels volledig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue quem fala ou o assunto e mostra os títulos inteiros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随说话者或主体，并完整显示标题。"
          }
        }
      }
