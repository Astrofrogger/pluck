    "%@ seconds with no sound at all, often a gap left in the edit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sekunden ganz ohne Ton, oft eine Lücke im Schnitt."
