    "Ask the host Mac to use its own relay (From anywhere) to make it faster." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte den Host-Mac, ein eigenes Relay zu verwenden (Von überall), damit es schneller wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al Mac anfitrión que use su propio relay (Desde cualquier lugar) para que sea más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez au Mac hôte d’utiliser son propre relais (De partout) pour accélérer la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al Mac host di usare un proprio relay (Da ovunque) per renderla più veloce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト Mac で自分のリレー（どこからでも）を使うように依頼すると、高速になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 Mac에서 자체 릴레이(어디서나)를 사용하도록 요청하면 더 빨라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag de host-Mac om een eigen relay te gebruiken (Vanaf overal) om het sneller te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça ao Mac anfitrião para usar o próprio relay (De qualquer lugar) para deixar mais rápido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请让主机 Mac 使用自己的中继（随处），以提高速度。"
          }
        }
      }
    },
