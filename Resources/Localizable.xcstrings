    "Play a finished download or show it in Finder straight from the notification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele einen fertigen Download ab oder zeige ihn im Finder – direkt aus der Mitteilung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce una descarga terminada o muéstrala en el Finder directamente desde la notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez un téléchargement terminé ou affichez-le dans le Finder directement depuis la notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduci un download completato o mostralo nel Finder direttamente dalla notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したダウンロードを、通知から直接再生したり Finder に表示したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 다운로드를 알림에서 바로 재생하거나 Finder에서 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel een voltooide download af of toon hem in de Finder, direct vanuit de melding."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduza um download concluído ou mostre-o no Finder direto da notificação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从通知中播放已完成的下载，或在“访达”中显示。"
          }
        }
      }
    },
