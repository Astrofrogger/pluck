      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck nimmt das beste verfügbare Audio und zeigt, welche Qualität du bekommen hast. Mit YouTube Premium sind das etwa 256 kbps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck elige el mejor audio disponible y muestra la calidad obtenida. Con YouTube Premium son unos 256 kbps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck prend le meilleur audio disponible et affiche la qualité obtenue. Avec YouTube Premium, c’est environ 256 kbit/s."
