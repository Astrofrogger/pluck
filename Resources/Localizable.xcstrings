    "That Mac isn’t sharing its Library any more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac gibt seine Mediathek nicht mehr frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese Mac ya no comparte su biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne partage plus sa bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel Mac non condivide più la sua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのMacはライブラリを共有していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 Mac은 더 이상 보관함을 공유하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mac deelt zijn bibliotheek niet meer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse Mac não está mais compartilhando a biblioteca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台 Mac 已不再共享资料库。"
          }
        }
      }
    },
    "That browser isn’t installed on this Mac, so cookies are skipped until you pick another.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Browser ist auf diesem Mac nicht installiert, daher werden Cookies übersprungen, bis du einen anderen wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese navegador no está instalado en este Mac, así que las cookies se omiten hasta que elijas otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce navigateur n’est pas installé sur ce Mac, les cookies sont donc ignorés jusqu’à ce que vous en choisissiez un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel browser non è installato su questo Mac, quindi i cookie vengono ignorati finché non ne scegli un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのブラウザはこの Mac にインストールされていないため、別のブラウザを選ぶまで Cookie は使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 브라우저는 이 Mac에 설치되어 있지 않으므로 다른 브라우저를 선택할 때까지 쿠키를 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die browser is niet geïnstalleerd op deze Mac, dus cookies worden overgeslagen tot je een andere kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse navegador não está instalado neste Mac, então os cookies são ignorados até você escolher outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上未安装该浏览器，因此在你选择其他浏览器之前将跳过 Cookie。"
          }
        }
      }
    },
    "That clip isn’t ready on the host Mac.": {
