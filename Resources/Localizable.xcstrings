    "Syncs every camera to the DJ’s mix and builds a beat-cut edit in DaVinci Resolve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert jede Kamera mit dem Mix des DJs und erstellt in DaVinci Resolve einen Schnitt im Takt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza cada cámara con la mezcla del DJ y monta una edición al ritmo en DaVinci Resolve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise chaque caméra sur le mix du DJ et monte une édition au rythme dans DaVinci Resolve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza ogni camera con il mix del DJ e crea un montaggio a tempo in DaVinci Resolve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのカメラをDJのミックスに同期し、DaVinci Resolveでビートに合わせた編集を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 카메라를 DJ 믹스에 맞춰 싱크하고 DaVinci Resolve에서 비트에 맞춘 편집을 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseert elke camera met de mix van de dj en maakt een montage op de beat in DaVinci Resolve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza cada câmera com a mixagem do DJ e monta uma edição no ritmo no DaVinci Resolve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每台机位与 DJ 的混音同步，并在 DaVinci Resolve 中生成踩点剪辑。"
          }
        }
      },
      "extractionState": "stale"
    },
