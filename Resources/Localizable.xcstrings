    "That browser isn’t installed on this Mac, so cookies are skipped until you pick another.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Browser ist auf diesem Mac nicht installiert, daher werden Cookies übersprungen, bis du einen anderen wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese navegador no está instalado en este Mac, así que las cookies se omiten hasta que elijas otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce navigateur n’est pas installé sur ce Mac, les cookies sont donc ignorés jusqu’à ce que vous en choisissiez un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel browser non è installato su questo Mac, quindi i cookie vengono ignorati finché non ne scegli un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのブラウザはこの Mac にインストールされていないため、別のブラウザを選ぶまで Cookie は使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 브라우저는 이 Mac에 설치되어 있지 않으므로 다른 브라우저를 선택할 때까지 쿠키를 건너뜁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die browser is niet geïnstalleerd op deze Mac, dus cookies worden overgeslagen tot je een andere kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse navegador não está instalado neste Mac, então os cookies são ignorados até você escolher outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上未安装该浏览器，因此在你选择其他浏览器之前将跳过 Cookie。"
          }
        }
      }
    },
    "The download didn’t match its published checksum, so it was discarded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download stimmte nicht mit seiner veröffentlichten Prüfsumme überein und wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no coincidía con su suma de comprobación publicada y se descartó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne correspondait pas à sa somme de contrôle publiée et a été supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download non corrispondeva al checksum pubblicato ed è stato scartato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが公開されたチェックサムと一致しなかったため、破棄しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 게시된 체크섬과 일치하지 않아 폐기했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De download kwam niet overeen met de gepubliceerde controlesom en is daarom verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não correspondia ao checksum publicado e foi descartado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容与已发布的校验和不符，已被丢弃。"
          }
        }
      }
    },
    "The download isn’t signed by its developer, so it was discarded.": {
      "localizations": {
        "de": {
