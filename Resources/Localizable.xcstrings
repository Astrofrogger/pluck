    "Subtitles can now be translated into several languages at once, with local AI on your Mac.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondertitels kunnen nu in één keer naar meerdere talen worden vertaald, met lokale AI op je Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel lassen sich jetzt mit lokaler KI auf deinem Mac in mehrere Sprachen auf einmal übersetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
