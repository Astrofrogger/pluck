        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유럽 방송은 25 또는 50fps를 요구하지만 이 파일은 %@입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
