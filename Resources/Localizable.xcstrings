    },
    "Paired Macs render and search footage on this Mac. Keep Pluck and DaVinci Resolve open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Macs rendern und durchsuchen Material auf diesem Mac. Lass Pluck und DaVinci Resolve geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Mac vinculados renderizan y buscan material en este Mac. Mantén Pluck y DaVinci Resolve abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Mac jumelés font leurs rendus et cherchent des rushes sur ce Mac. Laissez Pluck et DaVinci Resolve ouverts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Mac abbinati eseguono rendering e cercano girato su questo Mac. Tieni aperti Pluck e DaVinci Resolve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングした Mac はこの Mac でレンダリングや素材検索を行います。Pluck と DaVinci Resolve を開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Mac이 이 Mac에서 렌더링하고 소스를 검색합니다. Pluck과 DaVinci Resolve를 열어 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelde Macs renderen en doorzoeken beeldmateriaal op deze Mac. Houd Pluck en DaVinci Resolve open."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Macs pareados renderizam e pesquisam material neste Mac. Mantenha o Pluck e o DaVinci Resolve abertos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的 Mac 会在此 Mac 上渲染和搜索素材。请保持 Pluck 和 DaVinci Resolve 打开。"
          }
        }
      }
    },
    "Paired Macs search it by what’s in the picture and fetch just the shots they need.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Macs durchsuchen es nach Bildinhalt und holen nur die nötigen Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Mac vinculados lo buscan por lo que se ve y descargan solo los planos que necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Mac jumelés y cherchent par le contenu de l’image et ne récupèrent que les plans utiles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Mac abbinati lo cercano per contenuto dell’immagine e scaricano solo le inquadrature che servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングした Mac は映っている内容で検索し、必要なショットだけを取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 Mac이 화면 내용으로 검색하고 필요한 샷만 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelde Macs doorzoeken het op wat er in beeld is en halen alleen de shots op die ze nodig hebben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Macs pareados pesquisam pelo conteúdo da imagem e baixam só os planos de que precisam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的 Mac 可按画面内容搜索，并只获取所需镜头。"
          }
        }
      }
    },
