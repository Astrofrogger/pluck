          "stringUnit": {
            "state": "translated",
            "value": "Il broadcast europeo richiede 25 o 50 fps; questo è %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヨーロッパの放送では 25 または 50 fps が求められますが、これは %@ です。"
