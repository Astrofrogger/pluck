    },
    "Turn a logo into a smooth animation. Pluck finds the shapes and letters in it and animates them in, with an outro and the length you choose. Export transparent ProRes or MP4, in any format. Find it in the File menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem Logo eine flüssige Animation. Pluck findet die Formen und Buchstaben darin und animiert sie herein, mit Outro und der Länge deiner Wahl. Exportiere transparentes ProRes oder MP4 in jedem Format. Zu finden im Menü „Ablage“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un logo en una animación fluida. Pluck encuentra sus formas y letras y las anima, con salida y la duración que elijas. Exporta ProRes transparente o MP4 en cualquier formato. Está en el menú Archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez un logo en animation fluide. Pluck repère ses formes et ses lettres et les anime, avec une sortie et la durée de votre choix. Exportez en ProRes transparent ou MP4, dans tous les formats. Dans le menu Fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un logo in un’animazione fluida. Pluck ne trova forme e lettere e le anima, con un’uscita e la durata che scegli. Esporta ProRes trasparente o MP4 in qualsiasi formato. Si trova nel menu File."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴをなめらかなアニメーションに。Pluckがロゴの形と文字を見つけてアニメーションさせます。アウトロと長さも選べます。透明なProResまたはMP4で、どの形式でも書き出せます。「ファイル」メニューから。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고를 부드러운 애니메이션으로 만드세요. Pluck이 로고의 형태와 글자를 찾아 애니메이션하며, 아웃트로와 길이도 고를 수 있습니다. 투명 ProRes나 MP4로 어떤 포맷이든 내보낼 수 있습니다. 파일 메뉴에 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een logo een vloeiende animatie. Pluck vindt de vormen en letters erin en animeert ze, met een outro en de lengte die je kiest. Exporteer transparante ProRes of MP4, in elk formaat. Te vinden in het Archief-menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um logo numa animação suave. O Pluck encontra as formas e letras e as anima, com saída e a duração que você escolher. Exporte ProRes transparente ou MP4, em qualquer formato. Fica no menu Arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标志变成流畅的动画。Pluck 会找出其中的形状和字母并做成动画，可选结尾和时长。导出透明 ProRes 或 MP4，任意格式。在“文件”菜单中。"
          }
        }
      }
    },
    "Turn a logo into an animated intro, or a vector file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem Logo ein animiertes Intro oder eine Vektordatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un logo en una intro animada o en un archivo vectorial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez un logo en intro animée ou en fichier vectoriel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un logo in un’intro animata o in un file vettoriale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴをアニメーションのイントロやベクターファイルにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고를 애니메이션 인트로나 벡터 파일로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een logo een geanimeerde intro of een vectorbestand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um logo em uma abertura animada ou em um arquivo vetorial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标志变成动画片头或矢量文件。"
          }
        }
      }
    },
    "Turn a long video into vertical shorts: local AI picks the best moments, keeps the speaker in frame and captions every word.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem langen Video vertikale Shorts: Lokale KI wählt die besten Momente, hält den Sprecher im Bild und untertitelt jedes Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un vídeo largo en shorts verticales: la IA local elige los mejores momentos, mantiene al orador en el encuadre y subtitula cada palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez une longue vidéo en shorts verticaux : l’IA locale choisit les meilleurs moments, garde l’orateur dans le cadre et sous-titre chaque mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un video lungo in short verticali: l’IA locale sceglie i momenti migliori, mantiene l’oratore nell’inquadratura e sottotitola ogni parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いビデオを縦型ショートにします。ローカル AI がベストな場面を選び、話している人をフレームに収め、すべての単語に字幕を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 비디오를 세로형 쇼츠로 만듭니다. 로컬 AI가 최고의 순간을 고르고, 말하는 사람을 화면에 유지하며, 모든 단어에 자막을 넣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een lange video verticale shorts: lokale AI kiest de beste momenten, houdt de spreker in beeld en ondertitelt elk woord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um vídeo longo em shorts verticais: a IA local escolhe os melhores momentos, mantém quem fala no quadro e legenda cada palavra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把长视频变成竖屏短视频：本地 AI 挑选最佳片段，让说话者保持在画面中，并为每个词加字幕。"
          }
        }
      }
    },
    "Turn a video, or part of it, into an animated GIF in three sizes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem Video oder einem Teil davon ein animiertes GIF in drei Größen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un vídeo, o una parte, en un GIF animado en tres tamaños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez une vidéo, ou une partie, en GIF animé en trois tailles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un video, o una parte, in una GIF animata in tre dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオやその一部を、3 つのサイズのアニメーション GIF にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오나 그 일부를 세 가지 크기의 움직이는 GIF로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een video, of een deel ervan, een geanimeerde GIF in drie formaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um vídeo, ou parte dele, em um GIF animado em três tamanhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将视频或其中一部分制作成三种尺寸的动画 GIF。"
          }
        }
      }
    },
    "Turn it on in Settings → Downloads to add every song you download to Apple Music, or only the file types you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es in Einstellungen → Downloads ein, um jeden geladenen Song zu Apple Music hinzuzufügen, oder nur die Dateitypen, die du wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes → Descargas para añadir cada canción que descargues a Apple Music, o solo los tipos de archivo que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages → Téléchargements pour ajouter chaque morceau téléchargé à Apple Music, ou seulement les types de fichiers choisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in Impostazioni → Download per aggiungere ad Apple Music ogni brano che scarichi, o solo i tipi di file che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → ダウンロード でオンにすると、ダウンロードしたすべての曲、または選んだ種類のファイルだけを Apple Music に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 다운로드에서 켜면 다운로드하는 모든 노래 또는 선택한 파일 유형만 Apple Music에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het aan in Instellingen → Downloads om elk nummer dat je downloadt toe te voegen aan Apple Music, of alleen de bestandstypen die je kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Ajustes → Downloads para adicionar cada música que você baixar ao Apple Music, ou só os tipos de arquivo que escolher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“下载”中打开后，可将下载的每首歌曲，或仅所选类型的文件，添加到 Apple Music。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to use summaries and chapters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Apple Intelligence in den Systemeinstellungen ein, um Zusammenfassungen und Kapitel zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes del Sistema para usar resúmenes y capítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Réglages Système pour utiliser les résumés et les chapitres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni di Sistema per usare riassunti e capitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約とチャプタを使うには、システム設定で Apple Intelligence をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약 및 챕터를 사용하려면 시스템 설정에서 Apple Intelligence를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Apple Intelligence aan in Systeeminstellingen om samenvattingen en hoofdstukken te gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence nos Ajustes do Sistema para usar resumos e capítulos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中打开 Apple 智能，即可使用总结和章节。"
          }
        }
      }
    },
    "Turn on Split into Chapters in the format menu to save DJ mixes and full albums as separate, tagged tracks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „In Kapitel aufteilen“ im Formatmenü ein, um DJ-Mixe und ganze Alben als einzelne, getaggte Titel zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Dividir en capítulos en el menú de formato para guardar sesiones de DJ y álbumes completos como pistas separadas y etiquetadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Diviser en chapitres dans le menu de format pour enregistrer les mix de DJ et les albums complets en pistes séparées et étiquetées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Dividi in capitoli nel menu del formato per salvare mix DJ e album completi come tracce separate e taggate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットメニューで「チャプタごとに分割」をオンにすると、DJ ミックスやアルバム全体をタグ付きの個別のトラックとして保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포맷 메뉴에서 챕터별로 분할을 켜면 DJ 믹스와 전체 앨범을 태그가 지정된 개별 트랙으로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Splits in hoofdstukken aan in het formaatmenu om dj-mixen en volledige albums als losse, getagde nummers te bewaren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Dividir em capítulos no menu de formato para salvar mixes de DJ e álbuns completos como faixas separadas e marcadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在格式菜单中打开“按章节拆分”，即可将 DJ 混音和整张专辑存储为单独的、带标签的曲目。"
          }
        }
      }
    },
    "Turns the video, or the part you choose above, into an animated GIF for chats and documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Macht aus dem Video oder dem oben gewählten Teil ein animiertes GIF für Chats und Dokumente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el vídeo, o la parte que elijas arriba, en un GIF animado para chats y documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme la vidéo, ou la partie choisie ci-dessus, en GIF animé pour les discussions et les documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il video, o la parte che scegli qui sopra, in una GIF animata per chat e documenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ、または上で選んだ部分を、チャットや書類用のアニメーション GIF にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오나 위에서 선택한 부분을 채팅과 문서용 움직이는 GIF로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van de video, of het stuk dat je hierboven kiest, een geanimeerde GIF voor chats en documenten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma o vídeo, ou a parte que você escolher acima, em um GIF animado para conversas e documentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将视频或你在上方选择的部分制作成用于聊天和文稿的动画 GIF。"
          }
        }
      }
    },
    "Twice as smooth": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee keer zo vloeiend"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelt so flüssig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux fois plus fluide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El doble de fluido"
          }
        },
        "it": {
          "stringUnit": {
