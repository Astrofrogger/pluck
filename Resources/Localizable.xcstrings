            "value" : "2 つのショットの間に 1 フレームだけあります。編集の残りだと思われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 샷 사이에 프레임 하나가 끼어 있습니다. 편집하다 남은 것으로 보입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén beeld tussen twee shots, waarschijnlijk overgebleven van de montage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um único quadro entre dois planos, provavelmente sobra da edição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个镜头之间夹着单独一帧，可能是剪辑时遗留的。"
          }
        }
      }
    },
