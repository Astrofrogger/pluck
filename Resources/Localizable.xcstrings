        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilm ahora funciona de forma nativa: una descarga de 9 MB en lugar de cientos, renderizado varias veces más rápido y cada ajuste como un dial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilm fonctionne désormais en natif : un téléchargement de 9 Mo au lieu de centaines, un rendu plusieurs fois plus rapide et chaque réglage sous forme de molette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilm ora funziona in modo nativo: un download di 9 MB invece di centinaia, rendering molto più veloce e ogni impostazione come una manopola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilmがネイティブで動作するようになりました。ダウンロードは数百MBではなく9MB、レンダリングは数倍高速、すべての設定をダイヤルで調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
