          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann werden die E-Mail-Adressen der Kunden und die Aktivität eines archivierten Links gelöscht. Freigaben behalten Name und Datum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entonces se borran los correos de los clientes y la actividad de un enlace archivado. Las aprobaciones conservan el nombre y la fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les e-mails des clients et l’activité d’un lien archivé sont alors supprimés. Les validations gardent le nom et la date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allora vengono eliminate le email dei clienti e l’attività di un link archiviato. Le approvazioni mantengono nome e data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その時点で、アーカイブ済みリンクのクライアントのメールアドレスとアクティビティを削除します。承認には名前と日付が残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그때 보관된 링크의 클라이언트 이메일과 활동이 삭제됩니다. 승인에는 이름과 날짜가 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dan worden de e-mailadressen van klanten en de activiteit van een gearchiveerde link gewist. Akkoorden houden naam en datum."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Então os e-mails dos clientes e a atividade de um link arquivado são apagados. As aprovações mantêm o nome e a data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "届时将删除已归档链接的客户邮箱和活动记录。批准记录保留姓名和日期。"
          }
        }
      }
