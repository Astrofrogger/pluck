    "This Mac doesn’t support Apple Intelligence, which summaries and chapters need.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac unterstützt Apple Intelligence nicht, das Zusammenfassungen und Kapitel benötigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no admite Apple Intelligence, que necesitan los resúmenes y capítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge Apple Intelligence, nécessaire aux résumés et aux chapitres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non supporta Apple Intelligence, necessaria per riassunti e capitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は、要約とチャプタに必要な Apple Intelligence に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 요약 및 챕터에 필요한 Apple Intelligence를 지원하지 않습니다."
          }
        },
        "nl": {
