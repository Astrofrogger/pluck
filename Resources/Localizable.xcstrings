    },
    "Also used for Spotify links. Pluck picks the best audio on offer and only converts when needed. FLAC and WAV can’t add quality the source doesn’t have; each download shows what it got.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auch für Spotify-Links verwendet. Pluck nimmt das beste verfügbare Audio und konvertiert nur, wenn nötig. FLAC und WAV können keine Qualität hinzufügen, die die Quelle nicht hat; jeder Download zeigt, was er bekommen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se usa para enlaces de Spotify. Pluck elige el mejor audio disponible y solo convierte cuando hace falta. FLAC y WAV no pueden añadir calidad que la fuente no tiene; cada descarga muestra lo que obtuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé aussi pour les liens Spotify. Pluck prend le meilleur audio disponible et ne convertit que si nécessaire. FLAC et WAV ne peuvent pas ajouter une qualité que la source n’a pas ; chaque téléchargement indique ce qu’il a obtenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato anche per i link Spotify. Pluck sceglie il miglior audio disponibile e converte solo quando serve. FLAC e WAV non possono aggiungere qualità che la sorgente non ha; ogni download mostra cosa ha ottenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify のリンクにも使われます。Pluck は提供されている最高の音声を選び、必要な場合にだけ変換します。FLAC や WAV は元の音源にない音質を加えることはできません。各ダウンロードに実際の音質が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 링크에도 사용됩니다. Pluck은 제공되는 최상의 오디오를 가져오고 필요할 때만 변환합니다. FLAC과 WAV는 원본에 없는 음질을 더할 수 없으며, 각 다운로드에 실제로 받은 음질이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt ook gebruikt voor Spotify-links. Pluck kiest de beste beschikbare audio en zet alleen om als dat nodig is. FLAC en WAV kunnen geen kwaliteit toevoegen die de bron niet heeft; bij elke download zie je wat er binnenkwam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também usado para links do Spotify. O Pluck pega o melhor áudio disponível e só converte quando necessário. FLAC e WAV não podem adicionar qualidade que a fonte não tem; cada download mostra o que obteve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也用于 Spotify 链接。Pluck 会选取最佳音频，仅在需要时转换。FLAC 和 WAV 无法增加音源本身没有的音质；每个下载都会显示实际获得的音质。"
          }
        }
      }
    },
    "Always ask where to save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer fragen, wo gesichert werden soll"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar siempre dónde guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours demander où enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi sempre dove salvare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存先を毎回確認する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 저장할 위치 묻기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag altijd waar te bewaren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre perguntar onde salvar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是询问存储位置"
          }
        }
      }
    },
    "Always fills the frame, steady on the subject of each shot.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt immer das Bild, ruhig auf dem Motiv jeder Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre llena el encuadre, fijo en el sujeto de cada plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit toujours le cadre, fixe sur le sujet de chaque plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempie sempre l’inquadratura, ferma sul soggetto di ogni ripresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にフレームを埋め、各ショットの被写体に固定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 화면을 채우고 각 장면의 피사체에 고정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vult altijd het beeld, stil op het onderwerp van elk shot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre preenche o quadro, fixo no assunto de cada cena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终填满画面，并稳定对准每个镜头的主体。"
          }
        }
      }
    },
