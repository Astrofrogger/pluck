    "So you can search inside them. Runs in the background after each download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du darin suchen kannst. Läuft nach jedem Download im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder buscar dentro de ellas. Se ejecuta en segundo plano tras cada descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour pouvoir y rechercher. S’exécute en arrière-plan après chaque téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così puoi cercarci dentro. Viene eseguito in background dopo ogni download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中身を検索できるようにします。ダウンロードのたびにバックグラウンドで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안에서 검색할 수 있도록 합니다. 다운로드할 때마다 백그라운드에서 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat je erin kunt zoeken. Draait op de achtergrond na elke download."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para você poder buscar dentro deles. Roda em segundo plano após cada download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以便在其中搜索。每次下载后在后台运行。"
          }
        }
      }
    },
    "Songs get their lyrics, so they show up in Apple Music and on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Songs bekommen ihren Songtext, sodass er in Apple Music und auf dem iPhone erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las canciones reciben su letra, que aparece en Apple Music y en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morceaux reçoivent leurs paroles, qui s’affichent dans Apple Music et sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I brani ricevono il loro testo, che appare in Apple Music e su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲に歌詞が付くので、Apple Music や iPhone で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래에 가사가 포함되어 Apple Music과 iPhone에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers krijgen hun songtekst, zodat die verschijnt in Apple Music en op iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As músicas recebem a letra, que aparece no Apple Music e no iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌曲会附带歌词，在 Apple Music 和 iPhone 上显示。"
          }
        }
      }
    },
