    "Add its folder to the Library and Pluck indexes all its footage and photos." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Ordner zur Bibliothek hinzu, und Pluck indexiert alle Aufnahmen und Fotos darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade su carpeta a la biblioteca y Pluck indexará todo su material y sus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez son dossier à la bibliothèque et Pluck indexe toutes ses images et photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi la sua cartella alla libreria e Pluck indicizza tutto il girato e le foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダをライブラリに追加すると、Pluck が中の映像と写真をすべて索引します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더를 보관함에 추가하면 Pluck이 모든 영상과 사진의 색인을 만듭니다."
          }
        },
        "nl" : {
