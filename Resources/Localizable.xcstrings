    "Saves only the part you choose above, in the same quality.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert nur den oben gewählten Teil, in gleicher Qualität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda solo la parte que elijas arriba, con la misma calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre seulement la partie choisie ci-dessus, avec la même qualité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva solo la parte che scegli qui sopra, con la stessa qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で選んだ部分だけを同じ品質で保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 선택한 부분만 같은 품질로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart alleen het stuk dat je hierboven kiest, in dezelfde kwaliteit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva só a parte que você escolher acima, com a mesma qualidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅以相同质量存储你在上方选择的部分。"
          }
        }
      }
    },
    "Saves the sound as an audio file in the format below. Audio that’s already in that format is copied without quality loss.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert den Ton als Audiodatei im Format unten. Audio, das schon in diesem Format ist, wird ohne Qualitätsverlust kopiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el sonido como archivo de audio en el formato de abajo. El audio que ya está en ese formato se copia sin pérdida de calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le son dans un fichier audio au format ci-dessous. L’audio déjà dans ce format est copié sans perte de qualité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il suono come file audio nel formato qui sotto. L’audio già in quel formato viene copiato senza perdita di qualità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を下のフォーマットのオーディオファイルとして保存します。すでにそのフォーマットの場合は音質を落とさずコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 아래 포맷의 오디오 파일로 저장합니다. 이미 그 포맷인 오디오는 품질 손실 없이 복사합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart het geluid als audiobestand in het formaat hieronder. Audio die al in dat formaat is, wordt zonder kwaliteitsverlies gekopieerd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o som como arquivo de áudio no formato abaixo. O áudio que já está nesse formato é copiado sem perda de qualidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将声音存储为下方格式的音频文件。已是该格式的音频会无损复制。"
          }
        }
      }
    },
