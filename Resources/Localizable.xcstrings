          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il video, o la parte che scegli qui sopra, in una GIF animata per chat e documenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ、または上で選んだ部分を、チャットや書類用のアニメーション GIF にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오나 위에서 선택한 부분을 채팅과 문서용 움직이는 GIF로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt van de video, of het stuk dat je hierboven kiest, een geanimeerde GIF voor chats en documenten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforma o vídeo, ou a parte que você escolher acima, em um GIF animado para conversas e documentos."
          }
