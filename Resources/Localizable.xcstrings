    "That Mac can’t reach this server any more. To join again, it needs a new invitation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann den Server nicht mehr erreichen. Um wieder beizutreten, braucht er eine neue Einladung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese Mac ya no puede conectar con este servidor. Para volver a unirse, necesita una nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut plus joindre ce serveur. Pour le rejoindre à nouveau, il lui faut une nouvelle invitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel Mac non può più raggiungere questo server. Per unirsi di nuovo, serve un nuovo invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その Mac はこのサーバーに接続できなくなります。再び参加するには新しい招待が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 Mac은 더 이상 이 서버에 연결할 수 없습니다. 다시 참여하려면 새 초대가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mac kan deze server niet meer bereiken. Om opnieuw lid te worden, is een nieuwe uitnodiging nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse Mac não consegue mais acessar este servidor. Para entrar de novo, precisa de um novo convite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那台 Mac 将无法再连接此服务器。要重新加入，需要新的邀请。"
          }
        }
      }
    },
    "That Mac isn’t sharing its Library any more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac gibt seine Mediathek nicht mehr frei."
