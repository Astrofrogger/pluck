    "Originals added to Deliver are uploaded to the NAS, into the folder you pick." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale, die zu Deliver hinzugefügt werden, werden in den gewählten Ordner auf dem NAS hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los originales que añadas a Deliver se suben al NAS, a la carpeta que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les originaux ajoutés à Deliver sont téléversés sur le NAS, dans le dossier choisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli originali aggiunti a Deliver vengono caricati sul NAS, nella cartella che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliver に追加したオリジナルは、選んだ NAS 上のフォルダにアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliver에 추가한 원본은 선택한 NAS 폴더에 업로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originelen die je aan Deliver toevoegt, worden naar de gekozen map op de NAS geüpload."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os originais adicionados ao Deliver são enviados ao NAS, para a pasta que você escolher."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加到 Deliver 的原始文件会上传到 NAS 上你选择的文件夹。"
          }
        }
      }
    },
    "Originals are never deleted" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale werden nie gelöscht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los originales nunca se borran"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les originaux ne sont jamais supprimés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli originali non vengono mai eliminati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルは削除されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 절대 삭제되지 않습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originelen worden nooit verwijderd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os originais nunca são apagados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不会删除原始文件"
          }
        }
      }
    },
    "Originals only go to the Trash if you choose, after their masters are checked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale kommen nur in den Papierkorb, wenn du es willst – nachdem ihre Master geprüft wurden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los originales solo van a la papelera si lo eliges, después de comprobar sus másteres"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les originaux ne vont à la corbeille que si vous le choisissez, une fois leurs masters vérifiés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli originali vanno nel cestino solo se lo scegli, dopo la verifica dei loro master"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オリジナルは、マスターの確認後に、選んだ場合のみゴミ箱に入れられます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본은 마스터를 확인한 뒤, 원할 때만 휴지통으로 이동합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originelen gaan alleen naar de prullenmand als je dat kiest, nadat hun masters zijn gecontroleerd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os originais só vão para o Lixo se você escolher, depois que os masters forem verificados"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你选择的情况下，原始文件才会在母版检查通过后移到废纸篓"
          }
        }
      }
    },
    "Originals with a checked master: %@ freed once they’re in the Trash" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originale mit geprüftem Master: %@ werden frei, sobald sie im Papierkorb sind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originales con un máster comprobado: %@ liberados cuando estén en la papelera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originaux avec un master vérifié : %@ libérés une fois dans la corbeille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originali con un master controllato: %@ liberati una volta nel cestino"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認済みマスターのあるオリジナル：ゴミ箱に入れると %@ が解放されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인된 마스터가 있는 원본: 휴지통으로 옮기면 %@ 확보"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originelen met een gecontroleerde master: %@ komt vrij zodra ze in de prullenmand staan"
          }
        },
        "pt-BR" : {
