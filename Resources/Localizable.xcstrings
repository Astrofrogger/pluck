    "%@ LUFS; the target is %@. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; das Ziel ist %2$@. %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; el objetivo es %2$@. %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS ; la cible est %2$@. %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; l’obiettivo è %2$@. %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS（目標は %2$@）。%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS, 목표는 %2$@입니다. %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; het doel is %2$@. %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; o alvo é %2$@. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS；目标为 %2$@。%3$@"
          }
        }
      }
    },
    "%@ LUFS; the target is %@. It will sound weaker than what plays before and after it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; das Ziel ist %2$@. Es klingt schwächer als das, was davor und danach läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; el objetivo es %2$@. Sonará más flojo que lo que suene antes y después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS ; la cible est %2$@. Il sonnera plus faible que ce qui passe avant et après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; l’obiettivo è %2$@. Suonerà più debole di ciò che viene prima e dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS（目標は %2$@）。前後に流れるものより小さく聞こえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS, 목표는 %2$@입니다. 앞뒤에 재생되는 것보다 작게 들립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; het doel is %2$@. Het klinkt zwakker dan wat ervoor en erna speelt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS; o alvo é %2$@. Vai soar mais fraco do que o que toca antes e depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ LUFS；目标为 %2$@。听起来会比前后播放的内容更弱。"
          }
        }
      }
    },
