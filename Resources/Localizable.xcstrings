    "Imports the clip itself into the project open in DaVinci Resolve, with the sound the camera recorded beside it linked to it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert den Clip selbst in das in DaVinci Resolve geöffnete Projekt, mit dem daneben aufgenommenen Ton der Kamera verbunden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa el clip en sí al proyecto abierto en DaVinci Resolve, con el sonido que grabó la cámara a su lado vinculado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe le plan lui-même dans le projet ouvert dans DaVinci Resolve, avec le son enregistré à côté par la caméra lié à lui"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa la clip stessa nel progetto aperto in DaVinci Resolve, con l’audio registrato accanto dalla camera collegato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップそのものを DaVinci Resolve で開いているプロジェクトに読み込み、カメラが横に記録した音声をリンクします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립 원본을 DaVinci Resolve에 열려 있는 프로젝트로 가져오고, 카메라가 옆에 녹음한 소리를 연결합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeert de clip zelf in het project dat in DaVinci Resolve open staat, met het geluid dat de camera ernaast opnam eraan gekoppeld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa o próprio clipe no projeto aberto no DaVinci Resolve, com o som que a câmera gravou ao lado vinculado a ele"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将片段本身导入 DaVinci Resolve 中打开的项目，并链接摄影机在旁录制的声音"
          }
        }
      }
    },
    "Imports the clips shown into the project open in DaVinci Resolve, each with the sound the camera recorded beside it linked to it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiert die angezeigten Clips in das in DaVinci Resolve geöffnete Projekt, jeweils mit dem daneben aufgenommenen Ton der Kamera verbunden"
