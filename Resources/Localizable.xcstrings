    "Pluck can keep it waiting and send it to %@ as soon as the server is back, even after a restart." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck kann es zurückhalten und an %@ senden, sobald der Server wieder da ist, auch nach einem Neustart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck puede dejarlo en espera y enviarlo a %@ en cuanto vuelva el servidor, incluso tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck peut le mettre en attente et l’envoyer à %@ dès que le serveur est de retour, même après un redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck può tenerlo in attesa e inviarlo a %@ appena il server torna disponibile, anche dopo un riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck はこれを待機させ、サーバーが戻りしだい %@ に送信できます。再起動後も有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck이 대기시켰다가 서버가 돌아오는 즉시 %@(으)로 보낼 수 있습니다. 재시작 후에도 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck kan het laten wachten en naar %@ sturen zodra de server terug is, ook na een herstart."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pluck pode deixá-lo em espera e enviá-lo para %@ assim que o servidor voltar, mesmo depois de reiniciar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluck 可以先将其保留，在服务器恢复后立即发送到 %@，即使重启后也可以。"
          }
        }
      }
    },
