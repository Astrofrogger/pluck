    "Space comes back once you delete these. On TrueNAS, snapshots keep deleted files until they expire." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Platz kommt zurück, sobald du sie löschst. Auf TrueNAS behalten Snapshots gelöschte Dateien, bis sie ablaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio vuelve cuando los borras. En TrueNAS, las instantáneas conservan los archivos borrados hasta que caducan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace revient une fois ces fichiers supprimés. Sur TrueNAS, les instantanés gardent les fichiers supprimés jusqu’à leur expiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio torna quando li elimini. Su TrueNAS, gli snapshot conservano i file eliminati finché non scadono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらを削除すると容量が戻ります。TrueNAS では、スナップショットが期限切れになるまで削除したファイルを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것들을 삭제하면 공간이 돌아옵니다. TrueNAS에서는 스냅샷이 만료될 때까지 삭제한 파일을 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ruimte komt terug zodra je deze verwijdert. Op TrueNAS houden snapshots verwijderde bestanden tot ze verlopen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço volta quando você os apaga. No TrueNAS, os snapshots mantêm arquivos apagados até expirarem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除这些后空间才会回来。在 TrueNAS 上，快照会保留已删除的文件直到过期。"
          }
        }
      }
    },
