    "Pick Light, Regular, Bold or Black for shorts captions and burned-in subtitles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Leicht, Normal, Fett oder Extrafett für Shorts-Untertitel und eingebrannte Untertitel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Fina, Normal, Negrita o Extranegrita para los subtítulos de los shorts y los subtítulos incrustados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Léger, Normal, Gras ou Extra-gras pour les sous-titres des shorts et les sous-titres incrustés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Leggero, Normale, Grassetto o Nero per i sottotitoli degli short e quelli impressi nel video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートの字幕と焼き込み字幕に、ライト、レギュラー、ボールド、ブラックを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쇼츠 자막과 영상에 입힌 자막에 가늘게, 보통, 굵게, 아주 굵게 중에서 고를 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Licht, Normaal, Vet of Extra vet voor ondertitels in shorts en ingebrande ondertitels."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Leve, Normal, Negrito ou Extranegrito para legendas de shorts e legendas gravadas no vídeo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可为短视频字幕和烧录字幕选择细体、常规、粗体或特粗。"
          }
        }
      }
    },
    "Pick from playlists": {
      "localizations": {
