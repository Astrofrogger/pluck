          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de Pluck n’est pas encore disponible au téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella versione di Pluck non è ancora disponibile per il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのバージョンの Pluck はまだダウンロードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
