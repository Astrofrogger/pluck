    "Files you take out of the Library stay out, and files that aren’t there any more no longer come back." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien, die du aus der Mediathek entfernst, bleiben draußen, und fehlende Dateien kommen nicht mehr zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos que quitas de la biblioteca no vuelven, y los que ya no existen dejan de reaparecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers retirés de la bibliothèque n’y reviennent plus, et les fichiers disparus non plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file tolti dalla libreria restano fuori, e quelli che non esistono più non ricompaiono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリから外したファイルは戻らず、存在しなくなったファイルも再び表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함에서 뺀 파일은 다시 나타나지 않고, 더 이상 없는 파일도 돌아오지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden die je uit de bibliotheek haalt blijven weg, en bestanden die er niet meer zijn komen niet meer terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos que você tira da biblioteca não voltam, e os que não existem mais deixam de reaparecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从资料库移除的文件不会再回来，已不存在的文件也不会再出现。"
          }
        }
      }
    },
