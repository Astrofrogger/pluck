    "This server already has another certificate pinned. Use Pair Again to change it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Server ist bereits ein anderes Zertifikat gespeichert. Ändere es mit „Erneut koppeln“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor ya tiene otro certificado fijado. Usa Volver a vincular para cambiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre certificat est déjà épinglé pour ce serveur. Utilisez Jumeler à nouveau pour le changer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questo server è già fissato un altro certificato. Usa Abbina di nuovo per cambiarlo."
