    "Waveform, RGB parade and vectorscope of the picture (Rec.709). Nothing is measured while hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellenform, RGB-Parade und Vektorskop des Bildes (Rec.709). Ausgeblendet wird nichts gemessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma de onda, desfile RGB y vectorscopio de la imagen (Rec.709). Oculto, no se mide nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme d’onde, parade RVB et vectorscope de l’image (Rec.709). Masqués, rien n’est mesuré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma d’onda, parade RGB e vettorscopio dell’immagine (Rec.709). Quando nascosti non si misura nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の波形、RGBパレード、ベクトルスコープ（Rec.709）。隠している間は何も測りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면의 파형, RGB 퍼레이드, 벡터스코프(Rec.709). 숨겨져 있으면 아무것도 측정하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golfvorm, RGB-parade en vectorscope van het beeld (Rec.709). Verborgen wordt er niets gemeten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma de onda, parade RGB e vetorscópio da imagem (Rec.709). Oculto, nada é medido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面的波形图、RGB 分量图和矢量示波器（Rec.709）。隐藏时不进行测量。"
          }
        }
      }
    },
    "Waveform, RGB parade and vectorscope, false colour (⌥F), and a still to compare with, split or side by side (⌥G, ⌥C)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wellenform, RGB-Parade und Vektorskop, Falschfarben (⌥F) und ein Standbild zum Vergleichen, geteilt oder nebeneinander (⌥G, ⌥C)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma de onda, desfile RGB y vectorscopio, falso color (⌥F) y un fotograma para comparar, dividido o lado a lado (⌥G, ⌥C)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme d’onde, parade RVB et vectorscope, fausses couleurs (⌥F) et une image fixe à comparer, en partage ou côte à côte (⌥G, ⌥C)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma d’onda, parade RGB e vettorscopio, falsi colori (⌥F) e un fermo immagine da confrontare, diviso o affiancato (⌥G, ⌥C)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波形、RGBパレード、ベクトルスコープ、フォルスカラー（⌥F）、比較用の静止画を分割または横並びで（⌥G、⌥C）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파형, RGB 퍼레이드, 벡터스코프, 폴스 컬러(⌥F), 비교할 스틸을 분할 또는 나란히(⌥G, ⌥C)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Golfvorm, RGB-parade en vectorscope, valse kleuren (⌥F) en een still om mee te vergelijken, gesplitst of naast elkaar (⌥G, ⌥C)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma de onda, parade RGB e vetorscópio, falsa cor (⌥F) e um quadro para comparar, dividido ou lado a lado (⌥G, ⌥C)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波形图、RGB 分量图和矢量示波器，伪色（⌥F），以及用于比较的静帧，分屏或并排（⌥G、⌥C）。"
          }
        }
      }
    },
