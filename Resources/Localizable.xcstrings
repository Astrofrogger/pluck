        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier texte contenant des liens, un par ligne ou mêlés à d’autre texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file di testo con dei link, uno per riga o in mezzo ad altro testo."
          }
        },
        "ja": {
