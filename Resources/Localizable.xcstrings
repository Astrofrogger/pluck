        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het origineel kon niet worden teruggezet (%1$@; %2$@). Het staat veilig in ‘Pluck · Originals to delete’; Hervatten probeert het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível devolver o original (%1$@; %2$@). Ele está seguro em “Pluck · Originals to delete”; Retomar tenta de novo."
