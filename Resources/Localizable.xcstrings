    "The host Mac doesn’t let this Mac fetch originals. Its owner can allow it under Share this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host-Mac erlaubt diesem Mac nicht, Originale zu laden. Der Besitzer kann das unter „Diesen Mac teilen“ erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac anfitrión no deja que este Mac descargue originales. Su propietario puede permitirlo en «Compartir este Mac»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac hôte ne permet pas à ce Mac de récupérer les originaux. Son propriétaire peut l’autoriser dans « Partager ce Mac »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Mac host non consente a questo Mac di scaricare gli originali. Il proprietario può consentirlo in “Condividi questo Mac”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト Mac はこの Mac によるオリジナルの取得を許可していません。所有者は「この Mac を共有」で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트 Mac이 이 Mac에서 원본을 받는 것을 허용하지 않습니다. 소유자가 “이 Mac 공유”에서 허용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De host-Mac laat deze Mac geen originelen ophalen. De eigenaar kan dat toestaan onder ‘Deze Mac delen’."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac anfitrião não permite que este Mac baixe originais. O proprietário pode permitir em “Compartilhar este Mac”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机 Mac 不允许此 Mac 获取原始文件。其所有者可在“共享此 Mac”中允许。"
          }
        }
      }
    },
