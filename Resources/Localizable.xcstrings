    "Transcribe any video or song with local AI, save subtitles, add them to the video or burn them in, and translate them into another language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkribiere jedes Video und jeden Song mit lokaler KI, sichere Untertitel, füge sie zum Video hinzu oder brenne sie ein und übersetze sie in eine andere Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribe cualquier vídeo o canción con IA local, guarda subtítulos, añádelos al vídeo o grábalos en la imagen, y tradúcelos a otro idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrivez n’importe quelle vidéo ou morceau avec l’IA locale, enregistrez les sous-titres, ajoutez-les à la vidéo ou incrustez-les, et traduisez-les dans une autre langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrivi qualsiasi video o brano con l’IA locale, salva i sottotitoli, aggiungili al video o imprimili nell’immagine e traducili in un’altra lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆるビデオや曲をローカル AI で文字起こしし、字幕を保存したり、ビデオに追加・焼き込んだり、別の言語に翻訳したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 AI로 어떤 비디오나 노래든 받아쓰고, 자막을 저장하거나 비디오에 추가하거나 화면에 입히고, 다른 언어로 번역합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribeer elke video of elk nummer met lokale AI, bewaar ondertitels, voeg ze toe aan de video of brand ze in, en vertaal ze naar een andere taal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcreva qualquer vídeo ou música com IA local, salve legendas, adicione ao vídeo ou grave na imagem, e traduza para outro idioma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用本地 AI 转写任何视频或歌曲，存储字幕、添加到视频或烧录到画面中，并翻译成其他语言。"
          }
        }
      }
    },
