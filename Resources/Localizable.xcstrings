    "Export a transcript with its summary, chapters and speakers as text, Markdown or Word, save a frame as a picture, and send files straight to DaVinci Resolve.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer een transcript met samenvatting, hoofdstukken en sprekers als tekst, Markdown of Word, bewaar een beeld als afbeelding en stuur bestanden meteen naar DaVinci Resolve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere ein Transkript mit Zusammenfassung, Kapiteln und Sprechern als Text, Markdown oder Word, sichere ein Einzelbild als Bild und sende Dateien direkt an DaVinci Resolve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez une transcription avec résumé, chapitres et intervenants en texte, Markdown ou Word, enregistrez une image de la vidéo et envoyez des fichiers directement vers DaVinci Resolve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta una transcripción con resumen, capítulos y hablantes como texto, Markdown o Word, guarda un fotograma como imagen y envía archivos directamente a DaVinci Resolve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta una trascrizione con riassunto, capitoli e persone come testo, Markdown o Word, salva un fotogramma come immagine e invia file direttamente a DaVinci Resolve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte uma transcrição com resumo, capítulos e falantes como texto, Markdown ou Word, salve um quadro como imagem e envie arquivos direto ao DaVinci Resolve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約・チャプター・話者付きの文字起こしをテキスト、Markdown、Wordで書き出し、フレームを画像として保存し、ファイルをDaVinci Resolveに直接送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약, 챕터, 화자가 포함된 대본을 텍스트, Markdown, Word로 내보내고, 프레임을 사진으로 저장하고, 파일을 DaVinci Resolve로 바로 보낼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可将带摘要、章节和说话人的转写导出为文本、Markdown 或 Word，将画面存为图片，并把文件直接发送到 DaVinci Resolve。"
          }
        }
      }
    },
