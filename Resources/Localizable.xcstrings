    "Fast all the way: every bar, every bar on the drop too, no holds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchgehend schnell: jeder Takt, auch im Drop, keine längeren Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido de principio a fin: cada compás, también en el drop, sin pausas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide tout du long : chaque mesure, sur le drop aussi, sans plan tenu."
          }
        },
        "it": {
