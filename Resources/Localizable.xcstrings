    "The left channel has no sound at all. On headphones it plays on one side only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der linke Kanal hat überhaupt keinen Ton. Auf Kopfhörern spielt es nur auf einer Seite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal izquierdo no tiene nada de sonido. Con auriculares suena solo por un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le canal gauche n’a aucun son. Au casque, il ne joue que d’un côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il canale sinistro non ha alcun suono. In cuffia si sente da un lato solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左チャンネルに音がまったくありません。ヘッドホンでは片側からしか聞こえません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 채널에 소리가 전혀 없습니다. 헤드폰에서는 한쪽에서만 들립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het linkerkanaal heeft helemaal geen geluid. Op een koptelefoon speelt het maar aan één kant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal esquerdo não tem som nenhum. No fone, toca só de um lado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左声道完全没有声音。用耳机听时只有一侧有声。"
          }
        }
      }
    },
    "The length differs" : {
