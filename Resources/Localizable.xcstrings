    "Make a song exactly as long as your edit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring einen Song genau auf die Länge deines Schnitts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta una canción a la duración exacta de tu montaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez une chanson à la durée exacte de votre montage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi un brano lungo esattamente quanto il tuo montaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲を編集の長さぴったりに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래를 편집 길이에 딱 맞춥니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nummer precies zo lang als je montage."
          }
        },
        "pt-BR": {
