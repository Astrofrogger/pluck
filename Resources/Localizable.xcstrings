          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드럽고 일정한 카메라 무빙: 스피드 램프에 좋습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vloeiende, gelijkmatige camerabeweging: goed voor een speed ramp"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um movimento de câmera suave e constante: bom para uma rampa de velocidade"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平稳均匀的运镜：适合做变速"
          }
        }
      }
    },
    "A soft wipe reveals the logo, the letters settle into place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weiche Blende enthüllt das Logo, die Buchstaben setzen sich an ihren Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un barrido suave revela el logo y las letras se asientan en su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volet doux révèle le logo, les lettres se posent à leur place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tendina morbida rivela il logo, le lettere si assestano al loro posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やわらかなワイプでロゴが現れ、文字が所定の位置に収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 와이프로 로고가 드러나고 글자가 제자리에 자리 잡습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte wipe onthult het logo, de letters vallen op hun plek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transição suave revela o logo e as letras se encaixam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的划像展现标志，字母落到位。"
          }
        }
      }
    },
    "A soft-edged reveal moves across the logo, the shapes easing into place behind it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weiche Kante gleitet über das Logo und enthüllt es, die Formen gleiten dahinter an ihren Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borde suave recorre el logo y lo revela, y las formas se asientan detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bord doux traverse le logo pour le révéler, les formes se posent derrière lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bordo morbido attraversa il logo rivelandolo, le forme si assestano dietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やわらかな境界がロゴを横切って現れ、その後ろで形が所定の位置に収まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 경계가 로고를 가로지르며 드러내고, 그 뒤로 형태가 제자리를 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zachte rand schuift over het logo en onthult het, de vormen glijden erachter op hun plek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma borda suave percorre o logo e o revela, com as formas se encaixando atrás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔和的边缘扫过标志将其展现，形状随之落到位。"
          }
        }
      }
    },
