    "Right-click a folder in Browse and choose Keep on This Mac to edit it offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in „Durchsuchen“ mit der rechten Maustaste auf einen Ordner und wähle „Auf diesem Mac behalten“, um offline zu schneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en una carpeta en Explorar y elige Conservar en este Mac para editarla sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un dossier dans Parcourir et choisissez Garder sur ce Mac pour le monter hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro su una cartella in Sfoglia e scegli Mantieni su questo Mac per montarla offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ブラウズ」でフォルダを右クリックし、「この Mac に保持」を選ぶとオフラインで編集できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보기에서 폴더를 오른쪽 클릭하고 ‘이 Mac에 보관’을 선택하면 오프라인으로 편집할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een map in Bladeren en kies Bewaren op deze Mac om offline te monteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito numa pasta em Navegar e escolha Manter neste Mac para editar off-line."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“浏览”中右键点按文件夹，选择“保留在这台 Mac 上”即可离线剪辑。"
          }
        }
      }
    },
