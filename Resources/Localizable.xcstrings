    "1. Point a (sub)domain at the office’s public IP (or a dynamic DNS name)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Richte eine (Sub-)Domain auf die öffentliche IP des Büros (oder einen dynamischen DNS-Namen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Apunta un (sub)dominio a la IP pública de la oficina (o a un nombre DNS dinámico)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Faites pointer un (sous-)domaine vers l’IP publique du bureau (ou un nom DNS dynamique)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Punta un (sotto)dominio all’IP pubblico dell’ufficio (o a un nome DNS dinamico)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. （サブ）ドメインをオフィスのパブリック IP（またはダイナミック DNS 名）に向けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. (서브)도메인을 사무실의 공인 IP(또는 동적 DNS 이름)로 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Laat een (sub)domein naar het publieke IP-adres van het kantoor wijzen (of een dynamische DNS-naam)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Aponte um (sub)domínio para o IP público do escritório (ou um nome de DNS dinâmico)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 将一个（子）域名指向办公室的公网 IP（或动态 DNS 名称）。"
          }
        }
      }
    },
    "1. System Settings › Energy: turn on Wake for network access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Systemeinstellungen › Energie: „Beim Netzwerkzugriff aufwachen“ einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Ajustes del Sistema › Energía: activa “Activar para acceso a la red”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Réglages Système › Énergie : activez « Réactiver pour l’accès au réseau »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Impostazioni di Sistema › Energia: attiva “Riattiva per accesso alla rete”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. システム設定 › エネルギー：「ネットワークアクセスによってスリープを解除」をオンにします。"
          }
        },
        "ko" : {
