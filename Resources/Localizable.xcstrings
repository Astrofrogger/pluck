    "Puts the speaker’s name where it changes. Up to four speakers; rename them in Pluck Player.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de naam van de spreker waar die wisselt. Tot vier sprekers; geef ze een naam in Pluck Player."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt den Namen des Sprechers dort, wo er wechselt. Bis zu vier Sprecher; benenne sie im Pluck Player."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le nom de l’intervenant quand il change. Jusqu’à quatre intervenants ; renommez-les dans Pluck Player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone el nombre del hablante donde cambia. Hasta cuatro hablantes; cámbiales el nombre en Pluck Player."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette il nome di chi parla dove cambia. Fino a quattro persone; rinominale in Pluck Player."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca o nome do falante onde ele muda. Até quatro falantes; renomeie-os no Pluck Player."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話者が替わるところに名前を入れます。最大4人。名前はPluck Playerで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
