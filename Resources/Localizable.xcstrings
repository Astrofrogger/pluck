    "Type a song or video name instead of a link, then download it from YouTube Music or YouTube with one click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe statt eines Links den Namen eines Songs oder Videos und lade ihn mit einem Klick von YouTube Music oder YouTube."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el nombre de una canción o vídeo en lugar de un enlace y descárgalo de YouTube Music o YouTube con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez le nom d’un morceau ou d’une vidéo au lieu d’un lien, puis téléchargez-le depuis YouTube Music ou YouTube en un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita il nome di un brano o di un video invece di un link e scaricalo da YouTube Music o YouTube con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクの代わりに曲名やビデオ名を入力すれば、YouTube Music や YouTube からワンクリックでダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 대신 노래나 비디오 이름을 입력하고 YouTube Music이나 YouTube에서 클릭 한 번으로 다운로드하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ de naam van een nummer of video in plaats van een link en download hem met één klik van YouTube Music of YouTube."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o nome de uma música ou vídeo em vez de um link e baixe do YouTube Music ou do YouTube com um clique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入歌曲或视频名称而不是链接，一键从 YouTube Music 或 YouTube 下载。"
          }
        }
      }
    },
