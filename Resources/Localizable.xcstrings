    "Type a song or video name instead of a link, then download it from YouTube Music or YouTube with one click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe statt eines Links den Namen eines Songs oder Videos und lade ihn mit einem Klick von YouTube Music oder YouTube."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el nombre de una canción o vídeo en lugar de un enlace y descárgalo de YouTube Music o YouTube con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez le nom d’un morceau ou d’une vidéo au lieu d’un lien, puis téléchargez-le depuis YouTube Music ou YouTube en un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
