    "Fast all the way: every bar, every bar on the drop too, no holds." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchgehend schnell: jeder Takt, auch im Drop, keine längeren Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rápido de principio a fin: cada compás, también en el drop, sin pausas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapide tout du long : chaque mesure, sur le drop aussi, sans plan tenu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veloce dall’inizio alla fine: ogni battuta, anche sul drop, senza pause."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初から最後まで速く：毎小節、ドロップでも毎小節、長回しなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음부터 끝까지 빠르게: 매 마디, 드롭에서도 매 마디, 길게 잡지 않음."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snel van begin tot eind: elke maat, ook op de drop, zonder langere shots."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rápido do início ao fim: cada compasso, no drop também, sem pausas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全程快切：每小节一切，高潮段也一样，不停留。"
          }
        }
      }
    },
