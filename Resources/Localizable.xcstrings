          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba una voz en off mientras suena la línea de tiempo. Las canciones pueden bajar mientras alguien habla y volver después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une voix off pendant que la timeline défile. Les musiques peuvent baisser quand quelqu’un parle, puis revenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra una voce fuori campo mentre la timeline scorre. I brani possono abbassarsi mentre qualcuno parla e tornare dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムライン再生中にナレーションを録音。誰かが話す間は曲が下がり、その後戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타임라인이 재생되는 동안 보이스오버를 녹음하세요. 누군가 말하는 동안 곡이 작아졌다가 다시 돌아옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem een voice-over op terwijl de tijdlijn speelt. Nummers kunnen zachter gaan terwijl iemand spreekt en daarna terugkomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave uma narração enquanto a linha do tempo toca. As músicas podem abaixar enquanto alguém fala e voltar depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在时间线播放时录制旁白。有人说话时歌曲可自动降低，之后恢复。"
          }
        }
      }
    },
