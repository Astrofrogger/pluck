    "Logged ^[%lld clip](inflect: true) with ^[%lld marker](inflect: true) in “%@”. In DaVinci, search the media pool or make smart bins on Keywords." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Clips mit %lld Markern in „%@“ protokolliert. Durchsuche in DaVinci den Media Pool oder erstelle intelligente Bins nach Schlüsselwörtern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se registraron %lld clips con %lld marcadores en «%@». En DaVinci, busca en el Media Pool o crea bins inteligentes por palabras clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld plans journalisés avec %lld marqueurs dans « %@ ». Dans DaVinci, cherchez dans le Media Pool ou créez des chutiers intelligents par mots-clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrate %lld clip con %lld marker in “%@”. In DaVinci, cerca nel Media Pool o crea bin intelligenti per parole chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%3$@」で %1$lld 個のクリップに %2$lld 個のマーカーを記録しました。DaVinci でメディアプールを検索するか、キーワードでスマートビンを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%3$@”에서 %1$lld개 클립에 %2$lld개 마커를 기록했습니다. DaVinci에서 미디어 풀을 검색하거나 키워드로 스마트 빈을 만드세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld clips gelogd met %lld markers in ‘%@’. Zoek in DaVinci in de Media Pool of maak slimme bins op trefwoorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld clipes registrados com %lld marcadores em “%@”. No DaVinci, busque no Media Pool ou crie bins inteligentes por palavras-chave."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在“%3$@”中记录 %1$lld 个片段和 %2$lld 个标记。在 DaVinci 中搜索媒体池，或按关键词创建智能素材箱。"
          }
        }
      }
    },
