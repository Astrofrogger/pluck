            "value": "Duurt ongeveer %lld u op deze Mac. Probeer eerst een deel van de video."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert auf diesem Mac etwa %lld Std. Probiere zuerst einen Teil des Videos."
