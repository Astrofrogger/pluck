    "Couldn’t find a steady beat in this song, or the length is too far from the original to cut on its phrases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Song wurde kein gleichmäßiger Beat gefunden, oder die Länge weicht zu stark vom Original ab, um an Phrasen zu schneiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un ritmo estable en esta canción, o la duración se aleja demasiado del original para cortar por frases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun tempo régulier trouvé dans ce morceau, ou la durée est trop éloignée de l’original pour couper sur les phrases."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun ritmo costante trovato in questo brano, oppure la durata è troppo lontana dall’originale per tagliare sulle frasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲で安定したビートが見つからないか、長さが元の曲と離れすぎていてフレーズ単位で編集できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡에서 일정한 비트를 찾지 못했거나, 길이가 원곡과 너무 달라 프레이즈 단위로 자를 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vaste beat gevonden in dit nummer, of de lengte wijkt te veel af van het origineel om op frasen te knippen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrada uma batida estável nesta música, ou a duração está longe demais da original para cortar nas frases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这首歌没有找到稳定的节拍，或者时长与原曲相差太大，无法按乐句剪切。"
          }
        }
      }
