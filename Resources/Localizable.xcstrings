    "Closing the window keeps Pluck running in the menu bar. Choose Quit Pluck to stop it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Fenster schließt, läuft Pluck in der Menüleiste weiter. Wähle „Pluck beenden“, um es zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar la ventana, Pluck sigue en la barra de menús. Elige Salir de Pluck para detenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la fenêtre laisse Pluck actif dans la barre des menus. Choisissez Quitter Pluck pour l’arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo la finestra, Pluck resta attivo nella barra dei menu. Scegli Esci da Pluck per fermarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じても Pluck はメニューバーで動き続けます。止めるには「Pluck を終了」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윈도우를 닫아도 Pluck은 메뉴 막대에서 계속 실행됩니다. 중단하려면 Pluck 종료를 선택하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het venster sluit, blijft Pluck actief in de menubalk. Kies 'Stop Pluck' om het te stoppen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar a janela mantém o Pluck na barra de menus. Escolha Encerrar o Pluck para pará-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口后 Pluck 会继续在菜单栏中运行。选择“退出 Pluck”以停止它。"
          }
        }
      }
    },
