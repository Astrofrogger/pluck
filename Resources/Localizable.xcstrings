          "stringUnit": {
            "state": "translated",
            "value": "音源为无损，且文件未转换为有损格式"
          }
        }
      }
    },
    "The stem model couldn’t be downloaded. Check your internet connection and try again.": {
      "localizations": {
        "de": {
