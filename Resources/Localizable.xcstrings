            "value": "ローカル AI、編集ツール、どこでも編集付き。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 AI, 편집 도구, 어디서나 편집 포함."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met lokale AI, de montagetools en Overal monteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com IA local, as ferramentas de edição e Editar de qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "含本地 AI、剪辑工具和随处剪辑。"
          }
        }
      }
    },
    "With the originals on its storage; you get a small preview back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Originalen auf dessen Speicher; du bekommst eine kleine Vorschau zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con los originales en su almacenamiento; recibes una pequeña vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les originaux sur son stockage ; vous recevez un petit aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con gli originali sul suo storage; ricevi una piccola anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その Mac のストレージにあるオリジナル素材を使い、小さなプレビューが届きます。"
