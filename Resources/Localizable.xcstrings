    "Turn a long video into vertical shorts: local AI picks the best moments, keeps the speaker in frame and captions every word.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem langen Video vertikale Shorts: Lokale KI wählt die besten Momente, hält den Sprecher im Bild und untertitelt jedes Wort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un vídeo largo en shorts verticales: la IA local elige los mejores momentos, mantiene al orador en el encuadre y subtitula cada palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez une longue vidéo en shorts verticaux : l’IA locale choisit les meilleurs moments, garde l’orateur dans le cadre et sous-titre chaque mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un video lungo in short verticali: l’IA locale sceglie i momenti migliori, mantiene l’oratore nell’inquadratura e sottotitola ogni parola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いビデオを縦型ショートにします。ローカル AI がベストな場面を選び、話している人をフレームに収め、すべての単語に字幕を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 비디오를 세로형 쇼츠로 만듭니다. 로컬 AI가 최고의 순간을 고르고, 말하는 사람을 화면에 유지하며, 모든 단어에 자막을 넣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een lange video verticale shorts: lokale AI kiest de beste momenten, houdt de spreker in beeld en ondertitelt elk woord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um vídeo longo em shorts verticais: a IA local escolhe os melhores momentos, mantém quem fala no quadro e legenda cada palavra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把长视频变成竖屏短视频：本地 AI 挑选最佳片段，让说话者保持在画面中，并为每个词加字幕。"
          }
        }
      }
    },
    "Turn a video, or part of it, into an animated GIF in three sizes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach aus einem Video oder einem Teil davon ein animiertes GIF in drei Größen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte un vídeo, o una parte, en un GIF animado en tres tamaños."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez une vidéo, ou une partie, en GIF animé en trois tailles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un video, o una parte, in una GIF animata in tre dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオやその一部を、3 つのサイズのアニメーション GIF にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오나 그 일부를 세 가지 크기의 움직이는 GIF로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van een video, of een deel ervan, een geanimeerde GIF in drie formaten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme um vídeo, ou parte dele, em um GIF animado em três tamanhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将视频或其中一部分制作成三种尺寸的动画 GIF。"
          }
        }
      }
    },
    "Turn it on in Settings → Downloads to add every song you download to Apple Music, or only the file types you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte es in Einstellungen → Downloads ein, um jeden geladenen Song zu Apple Music hinzuzufügen, oder nur die Dateitypen, die du wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo en Ajustes → Descargas para añadir cada canción que descargues a Apple Music, o solo los tipos de archivo que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le dans Réglages → Téléchargements pour ajouter chaque morceau téléchargé à Apple Music, ou seulement les types de fichiers choisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo in Impostazioni → Download per aggiungere ad Apple Music ogni brano che scarichi, o solo i tipi di file che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → ダウンロード でオンにすると、ダウンロードしたすべての曲、または選んだ種類のファイルだけを Apple Music に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 다운로드에서 켜면 다운로드하는 모든 노래 또는 선택한 파일 유형만 Apple Music에 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het aan in Instellingen → Downloads om elk nummer dat je downloadt toe te voegen aan Apple Music, of alleen de bestandstypen die je kiest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative em Ajustes → Downloads para adicionar cada música que você baixar ao Apple Music, ou só os tipos de arquivo que escolher."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”→“下载”中打开后，可将下载的每首歌曲，或仅所选类型的文件，添加到 Apple Music。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to use summaries and chapters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Apple Intelligence in den Systemeinstellungen ein, um Zusammenfassungen und Kapitel zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes del Sistema para usar resúmenes y capítulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Réglages Système pour utiliser les résumés et les chapitres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni di Sistema per usare riassunti e capitoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約とチャプタを使うには、システム設定で Apple Intelligence をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요약 및 챕터를 사용하려면 시스템 설정에서 Apple Intelligence를 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Apple Intelligence aan in Systeeminstellingen om samenvattingen en hoofdstukken te gebruiken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence nos Ajustes do Sistema para usar resumos e capítulos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“系统设置”中打开 Apple 智能，即可使用总结和章节。"
          }
        }
      }
    },
    "Turn on Split into Chapters in the format menu to save DJ mixes and full albums as separate, tagged tracks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „In Kapitel aufteilen“ im Formatmenü ein, um DJ-Mixe und ganze Alben als einzelne, getaggte Titel zu sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Dividir en capítulos en el menú de formato para guardar sesiones de DJ y álbumes completos como pistas separadas y etiquetadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Diviser en chapitres dans le menu de format pour enregistrer les mix de DJ et les albums complets en pistes séparées et étiquetées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Dividi in capitoli nel menu del formato per salvare mix DJ e album completi come tracce separate e taggate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマットメニューで「チャプタごとに分割」をオンにすると、DJ ミックスやアルバム全体をタグ付きの個別のトラックとして保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포맷 메뉴에서 챕터별로 분할을 켜면 DJ 믹스와 전체 앨범을 태그가 지정된 개별 트랙으로 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Splits in hoofdstukken aan in het formaatmenu om dj-mixen en volledige albums als losse, getagde nummers te bewaren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Dividir em capítulos no menu de formato para salvar mixes de DJ e álbuns completos como faixas separadas e marcadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在格式菜单中打开“按章节拆分”，即可将 DJ 混音和整张专辑存储为单独的、带标签的曲目。"
          }
        }
      }
    },
    "Turns the video, or the part you choose above, into an animated GIF for chats and documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
