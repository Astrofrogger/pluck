    "Select several items with ⌘ or ⇧ and add subtitles, remove silences or clean up the audio of all of them in one go.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer meerdere onderdelen met ⌘ of ⇧ en voeg ondertitels toe, verwijder stiltes of schoon de audio op van allemaal tegelijk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mehrere Objekte mit ⌘ oder ⇧ aus und füge Untertitel hinzu, entferne Pausen oder bereinige den Ton aller Objekte auf einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez plusieurs éléments avec ⌘ ou ⇧ et ajoutez des sous-titres, supprimez les silences ou nettoyez le son de tous en une fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona varios elementos con ⌘ o ⇧ y añade subtítulos, quita silencios o limpia el audio de todos a la vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona più elementi con ⌘ o ⇧ e aggiungi sottotitoli, rimuovi i silenzi o pulisci l’audio di tutti in una volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione vários itens com ⌘ ou ⇧ e adicione legendas, remova silêncios ou limpe o áudio de todos de uma vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘や⇧で複数の項目を選び、字幕の追加、無音の削除、音声のクリーンアップをまとめて実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 또는 ⇧로 여러 항목을 선택해 자막 추가, 무음 제거, 오디오 정리를 한 번에 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 ⌘ 或 ⇧ 选择多个项目，一次性为它们添加字幕、删除静音或清理音频。"
          }
        }
      }
    },
