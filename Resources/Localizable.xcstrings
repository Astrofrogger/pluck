    "Open the Music app once, so it creates the folder Pluck adds songs to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Musik-App einmal, damit sie den Ordner anlegt, in den Pluck Songs legt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Música una vez para que cree la carpeta donde Pluck añade las canciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Musique une fois pour qu’elle crée le dossier où Pluck ajoute les morceaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’app Musica una volta, così crea la cartella in cui Pluck aggiunge i brani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミュージック App を一度開いて、Pluck が曲を追加するフォルダを作成させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 앱을 한 번 열어 Pluck이 노래를 추가할 폴더를 만들게 하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de Muziek-app één keer, zodat die de map aanmaakt waar Pluck nummers aan toevoegt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app Música uma vez para que ele crie a pasta onde o Pluck adiciona as músicas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一次“音乐”App，让它创建 Pluck 添加歌曲的文件夹。"
          }
        }
      }
    },
    "Opening a project switches DaVinci Resolve on the host Mac to it": {
      "localizations": {
        "de": {
          "stringUnit": {
