    "Now %lldp. Local AI adds real detail, not just bigger pixels.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu %lldp. Lokale AI voegt echt detail toe, niet alleen grotere pixels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt %lldp. Lokale KI ergänzt echte Details, nicht nur größere Pixel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actuellement %lldp. L’IA locale ajoute de vrais détails, pas seulement des pixels plus gros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora %lldp. La IA local añade detalle real, no solo píxeles más grandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora %lldp. L’IA locale aggiunge dettagli reali, non solo pixel più grandi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora %lldp. A IA local adiciona detalhes reais, não só pixels maiores."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%lldp。ローカルAIが、単に拡大するのではなく本物のディテールを加えます。"
