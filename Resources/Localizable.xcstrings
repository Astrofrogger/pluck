    "Lower thirds, a title card and an end card in the logo’s colours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauchbinden, eine Titelkarte und eine Abspann-Karte in den Farben des Logos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rótulos, una cartela de título y un cierre con los colores del logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthés, un carton de titre et un carton de fin aux couleurs du logo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottopancia, un cartello titolo e un cartello finale nei colori del logo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴの色で作るローワーサード、タイトルカード、エンドカード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고 색상으로 만든 로워 서드, 타이틀 카드, 엔드 카드."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naamtitels, een titelkaart en een eindkaart in de kleuren van het logo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas, uma cartela de título e uma cartela final nas cores do logo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用标志配色的人名条、标题卡和结尾卡。"
          }
        }
      }
    },
    "Lower thirds, a title card and an end card in your logo’s colours, animated and ready for the edit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauchbinden, eine Titelkarte und eine Abspann-Karte in den Farben deines Logos, animiert und bereit für den Schnitt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rótulos, una cartela de título y un cierre con los colores de tu logo, animados y listos para la edición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synthés, un carton de titre et un carton de fin aux couleurs de votre logo, animés et prêts pour le montage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottopancia, un cartello titolo e un cartello finale nei colori del tuo logo, animati e pronti per il montaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴの色で作る、アニメーション付きのローワーサード、タイトルカード、エンドカード。編集にすぐ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고 색상으로 만든 애니메이션 로워 서드, 타이틀 카드, 엔드 카드. 바로 편집에 쓸 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naamtitels, een titelkaart en een eindkaart in de kleuren van je logo, geanimeerd en klaar voor de montage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas, uma cartela de título e uma cartela final nas cores do seu logo, animadas e prontas para a edição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用你的标志配色、带动画的人名条、标题卡和结尾卡，可直接用于剪辑。"
          }
        }
      }
    },
    "Lowered to %lldp to stay sharp": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %lldp gesenkt, damit es scharf bleibt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducido a %lldp para mantener la nitidez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaissé à %lldp pour rester net"
