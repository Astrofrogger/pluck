    "%@ seconds of black. Fine if it’s meant as a pause.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sekunden Schwarz. In Ordnung, wenn es als Pause gedacht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos en negro. Bien si es una pausa intencionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondes de noir. Pas de souci si c’est voulu comme pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondi di nero. Va bene se è una pausa voluta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒の黒。意図した間なら問題ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초 동안 검은 화면. 의도한 쉼이라면 괜찮습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconden zwart. Prima als het als pauze bedoeld is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos de preto. Tudo bem se for uma pausa intencional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒黑屏。如果是有意停顿则没问题。"
          }
        }
      }
    },
    "%@ seconds of black. Some platforms pick a black first frame as the thumbnail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sekunden Schwarz. Manche Plattformen nehmen ein schwarzes erstes Bild als Vorschaubild."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos en negro. Algunas plataformas eligen un primer fotograma negro como miniatura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondes de noir. Certaines plateformes prennent une première image noire comme miniature."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondi di nero. Alcune piattaforme usano un primo fotogramma nero come miniatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒の黒。最初のフレームが黒だとサムネイルに使うプラットフォームもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초 동안 검은 화면. 일부 플랫폼은 검은 첫 프레임을 썸네일로 씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconden zwart. Sommige platforms kiezen een zwart eerste beeld als thumbnail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos de preto. Algumas plataformas usam um primeiro quadro preto como miniatura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒黑屏。有些平台会把黑色首帧用作缩略图。"
          }
        }
      }
    },
    "%@ seconds of silence. Fine if it’s meant as a pause.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sekunden Stille. In Ordnung, wenn es als Pause gedacht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos de silencio. Bien si es una pausa intencionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondes de silence. Pas de souci si c’est voulu comme pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondi di silenzio. Va bene se è una pausa voluta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒の無音。意図した間なら問題ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초 동안 무음. 의도한 쉼이라면 괜찮습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconden stilte. Prima als het als pauze bedoeld is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos de silêncio. Tudo bem se for uma pausa intencional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒静音。如果是有意停顿则没问题。"
          }
        }
      }
    },
    "%@ seconds without any movement. Fine for a title or a still; check it isn’t a frozen render.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Sekunden ohne jede Bewegung. In Ordnung für einen Titel oder ein Standbild; prüfe, ob es kein eingefrorener Render ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos sin ningún movimiento. Bien para un título o una imagen fija; comprueba que no sea un render congelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondes sans aucun mouvement. Normal pour un titre ou une image fixe ; vérifiez que ce n’est pas un rendu figé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ secondi senza alcun movimento. Va bene per un titolo o un fermo immagine; verifica che non sia un render bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒間まったく動きがありません。タイトルや静止画なら問題ありませんが、レンダリングが止まっていないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초 동안 움직임이 없습니다. 타이틀이나 정지 화면이면 괜찮지만, 렌더링이 멈춘 것은 아닌지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconden zonder enige beweging. Prima voor een titel of still; controleer of het geen bevroren render is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segundos sem nenhum movimento. Tudo bem para um título ou imagem parada; verifique se não é uma renderização congelada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 秒没有任何运动。若是标题或静帧则没问题；请确认不是卡住的渲染。"
          }
        }
      }
    },
