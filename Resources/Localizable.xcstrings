    "Pause big downloads and continue later, even after quitting Pluck.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere große Downloads und mach später weiter, sogar nachdem du Pluck beendet hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa descargas grandes y continúa más tarde, incluso después de salir de Pluck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez en pause les gros téléchargements et reprenez plus tard, même après avoir quitté Pluck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa i download grandi e riprendi più tardi, anche dopo essere uscito da Pluck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなダウンロードを一時停止して、Pluck を終了した後でも続きから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 다운로드를 일시 정지하고 Pluck을 종료한 후에도 나중에 이어서 받을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer grote downloads en ga later verder, zelfs nadat je Pluck hebt gestopt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause downloads grandes e continue depois, mesmo após encerrar o Pluck."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停大型下载并稍后继续，即使退出 Pluck 之后也可以。"
          }
        }
      }
    },
