          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後、ペアリング済みの %lld 台の Mac には新しい招待が必要です。このネットワーク上の Mac は引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
