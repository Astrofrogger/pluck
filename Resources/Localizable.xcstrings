        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 옆에 받아쓰기, 요약, 챕터를 두고 시청합니다. 줄을 클릭하면 그곳으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk met het transcript, de samenvatting en de hoofdstukken naast de video. Klik op een regel om erheen te springen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista com a transcrição, o resumo e os capítulos ao lado do vídeo. Clique em uma linha para ir até ela."
          }
