    "Every camera and a sound recorder. Synced by timecode, sound and light flashes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Kamera und ein Tonrecorder. Synchronisiert über Timecode, Ton und Lichtblitze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las cámaras y una grabadora de sonido. Se sincronizan por timecode, sonido y destellos de luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les caméras et un enregistreur son. Synchronisation par timecode, son et flashs lumineux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni camera e un registratore audio. Sincronizzate tramite timecode, suono e lampi di luce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのカメラと録音機。タイムコード、音声、光のフラッシュで同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 카메라와 사운드 레코더. 타임코드, 소리, 빛 섬광으로 동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke camera en een geluidsrecorder. Gesynchroniseerd op timecode, geluid en lichtflitsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as câmeras e um gravador de som. Sincronizados por timecode, som e flashes de luz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
