    "Videos with chapters, like DJ mixes and full albums, are saved as one file per chapter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos mit Kapiteln, etwa DJ-Mixe und ganze Alben, werden als eine Datei pro Kapitel gesichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos con capítulos, como sesiones de DJ y álbumes completos, se guardan como un archivo por capítulo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos avec chapitres, comme les mix de DJ et les albums complets, sont enregistrées en un fichier par chapitre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I video con capitoli, come mix DJ e album completi, vengono salvati come un file per capitolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DJ ミックスやアルバム全体など、チャプタのあるビデオをチャプタごとに 1 ファイルで保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DJ 믹스나 전체 앨범처럼 챕터가 있는 비디오를 챕터마다 파일 하나로 저장합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Video’s met hoofdstukken, zoals dj-mixen en volledige albums, worden als één bestand per hoofdstuk bewaard"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeos com capítulos, como mixes de DJ e álbuns completos, são salvos como um arquivo por capítulo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带章节的视频（如 DJ 混音和整张专辑）将按章节存储为单独的文件"
          }
        }
      }
    },
