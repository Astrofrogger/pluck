    "Translated on this Mac with local AI: Apple’s on-device translation. Nothing is uploaded. The translation is saved next to the original." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac mit lokaler KI übersetzt: Apples Übersetzung auf dem Gerät. Es wird nichts hochgeladen. Die Übersetzung wird neben dem Original gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se traduce en este Mac con IA local: la traducción en el dispositivo de Apple. No se sube nada. La traducción se guarda junto al original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit sur ce Mac avec l’IA locale : la traduction sur l’appareil d’Apple. Rien n’est envoyé. La traduction est enregistrée à côté de l’original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradotto su questo Mac con l’IA locale: la traduzione sul dispositivo di Apple. Non viene caricato nulla. La traduzione viene salvata accanto all’originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上でローカルAI（Appleのオンデバイス翻訳）を使って翻訳します。何もアップロードされません。翻訳は元のファイルの隣に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 로컬 AI(Apple의 온디바이스 번역)로 번역합니다. 아무것도 업로드되지 않습니다. 번역은 원본 옆에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaald op deze Mac met lokale AI: Apples vertaling op het apparaat. Er wordt niets geüpload. De vertaling wordt naast het origineel bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduzido neste Mac com IA local: a tradução no dispositivo da Apple. Nada é enviado. A tradução é salva ao lado do original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此 Mac 上使用本地 AI（Apple 的设备端翻译）进行翻译，不会上传任何内容。译文保存在原文件旁边。"
          }
        }
      }
    },
