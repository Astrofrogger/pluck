        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale AI op je Mac knipt lange pauzes en stopwoorden zoals “ehm” uit een video of opname, in een strakkere kopie. Om verder te monteren kan Pluck ook een montagelijst voor DaVinci Resolve of Premiere Pro bewaren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA local no seu Mac corta pausas longas e vícios de fala como “é” de um vídeo ou gravação, em uma cópia enxuta. Para edição, também pode salvar uma lista de edição para o DaVinci Resolve ou o Premiere Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上的本地 AI 会从视频或录音中剪掉长停顿和“嗯”之类的口头禅，生成精简副本。剪辑时还可以保存 DaVinci Resolve 或 Premiere Pro 的剪辑列表。"
          }
        }
      }
    },
    "Local AI on your Mac finds faces and follows them through the video, and blurs everyone except the people you keep sharp. It can blur licence plates and other text too." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale KI auf deinem Mac findet Gesichter, verfolgt sie durch das Video und verpixelt alle außer den Personen, die du scharf lässt. Auch Kennzeichen und anderer Text lassen sich verpixeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA local de tu Mac encuentra caras, las sigue por el vídeo y difumina a todos salvo a las personas que dejes nítidas. También puede difuminar matrículas y otros textos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
