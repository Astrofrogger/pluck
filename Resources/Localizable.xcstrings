    "Takes your logo apart into its shapes and animates them in, smooth and refined.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zerlegt dein Logo in seine Formen und animiert sie herein – weich und edel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompone tu logo en sus formas y las anima, de forma suave y refinada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompose votre logo en formes et les anime, en douceur et avec raffinement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scompone il logo nelle sue forme e le anima, in modo morbido e raffinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴを形ごとに分解して、なめらかで上品にアニメーションさせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고를 형태별로 나눠 부드럽고 세련되게 애니메이션합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt je logo uit elkaar in zijn vormen en animeert ze, vloeiend en verfijnd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa seu logo em formas e as anima de forma suave e refinada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标志拆成各个形状，以顺滑精致的方式做成动画。"
          }
        }
      }
    },
    "Takes your logo apart into its shapes and animates them in: smooth, with a little spring and a light sweep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zerlegt dein Logo in seine Formen und animiert sie herein: weich, mit etwas Federung und einem Lichtschimmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompone tu logo en sus formas y las anima: suave, con un pequeño rebote y un destello de luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompose votre logo en formes et les anime : en douceur, avec un léger rebond et un reflet lumineux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scompone il logo nelle sue forme e le anima: morbido, con un piccolo rimbalzo e un riflesso di luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴを形ごとに分解してアニメーションさせます。なめらかに、少し弾んで、最後に光が走ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로고를 형태별로 나눠 애니메이션합니다. 부드럽게, 살짝 튀며, 빛이 지나갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt je logo uit elkaar in zijn vormen en animeert ze: vloeiend, met een lichte vering en een lichtflits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa seu logo em formas e as anima: suave, com um leve salto e um brilho de luz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标志拆成各个形状并做成动画：顺滑、带一点弹性，最后一道光扫过。"
          }
        }
      },
      "extractionState": "stale"
    },
