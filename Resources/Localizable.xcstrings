          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è (ancora) un’anteprima per quel rendering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのレンダリングのプレビューは（まだ）ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
