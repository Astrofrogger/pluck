        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck 保存的所有内容，含合集和标签。"
          }
        }
      }
    },
    "Everything between the two Macs is encrypted and signed, and the host Mac is never open to the internet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles zwischen den beiden Macs ist verschlüsselt und signiert, und der Host-Mac ist nie offen fürs Internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que pasa entre los dos Mac va cifrado y firmado, y el Mac anfitrión nunca queda abierto a internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui passe entre les deux Mac est chiffré et signé, et le Mac hôte n’est jamais ouvert à Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto tra i due Mac è cifrato e firmato, e il Mac host non è mai aperto a internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 台の Mac 間の通信はすべて暗号化・署名され、ホスト Mac がインターネットに公開されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 Mac 사이의 모든 통신은 암호화되고 서명되며, 호스트 Mac은 인터넷에 열리지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles tussen de twee Macs is versleuteld en ondertekend, en de host-Mac staat nooit open voor het internet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo entre os dois Macs é criptografado e assinado, e o Mac anfitrião nunca fica aberto à internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台 Mac 之间的一切都经过加密和签名，主机 Mac 绝不会向互联网开放。"
          }
        }
      }
    },
    "Everything in Pluck, plus local AI (subtitles, summaries, shorts, stems…), the editing tools for DaVinci Resolve, the Logo Animator and Edit Anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aus Pluck, plus lokale KI (Untertitel, Zusammenfassungen, Shorts, Stems …), die Schnittwerkzeuge für DaVinci Resolve, der Logo-Animator und Überall bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de Pluck, más IA local (subtítulos, resúmenes, shorts, stems…), las herramientas de edición para DaVinci Resolve, el Animador de logos y Editar en cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout Pluck, plus l’IA locale (sous-titres, résumés, shorts, stems…), les outils de montage pour DaVinci Resolve, l’Animateur de logo et Monter partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto Pluck, più l’IA locale (sottotitoli, riassunti, short, stem…), gli strumenti di montaggio per DaVinci Resolve, l’Animatore di logo e Montaggio ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck のすべてに加え、ローカル AI（字幕、要約、ショート、ステム…）、DaVinci Resolve 用の編集ツール、ロゴアニメーター、どこでも編集。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck의 모든 기능에 로컬 AI(자막, 요약, 쇼츠, 스템…), DaVinci Resolve용 편집 도구, 로고 애니메이터, 어디서나 편집가 더해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles van Pluck, plus lokale AI (ondertitels, samenvattingen, shorts, stems…), de montagetools voor DaVinci Resolve, de Logo-animator en Overal monteren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo do Pluck, mais IA local (legendas, resumos, shorts, stems…), as ferramentas de edição para o DaVinci Resolve, o Animador de logo e Editar de qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluck 的全部功能，外加本地 AI（字幕、摘要、短视频、分轨…）、DaVinci Resolve 剪辑工具、标志动画器和随处剪辑。"
          }
        }
      }
    },
    "Everything new up to version %@": {
      "localizations": {
