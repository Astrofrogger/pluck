    "Cuts an interview or panel to whoever is talking, with every camera synced to the microphone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet ein Interview oder Panel auf die Person, die gerade spricht – alle Kameras mit dem Mikrofon synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta una entrevista o mesa redonda en quien está hablando, con cada cámara sincronizada con el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte une interview ou une table ronde sur la personne qui parle, chaque caméra synchronisée sur le micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Monta un’intervista o un panel su chi sta parlando, con ogni camera sincronizzata al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インタビューやパネルを話している人に合わせて編集します。すべてのカメラはマイクに同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터뷰나 패널 토론을 말하는 사람에 맞춰 편집합니다. 모든 카메라는 마이크에 싱크됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Monteert een interview of panel op wie er praat, met elke camera gesynchroniseerd op de microfoon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta uma entrevista ou painel para quem está falando, com cada câmera sincronizada ao microfone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将采访或座谈剪辑到正在说话的人，所有机位都与麦克风同步。"
          }
        }
      },
      "extractionState": "stale"
    },
    "Cuts every pause longer than a third of a second. Fast, like a vlog.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knipt elke pauze langer dan een derde seconde weg. Vlot, zoals een vlog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet jede Pause über einer Drittelsekunde. Schnell, wie ein Vlog."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe chaque pause de plus d’un tiers de seconde. Rythmé, comme un vlog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta cada pausa de más de un tercio de segundo. Ágil, como un vlog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taglia ogni pausa più lunga di un terzo di secondo. Veloce, come un vlog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta toda pausa maior que um terço de segundo. Rápido, como um vlog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.3秒を超える間をすべてカットします。Vlogのようにテンポよく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.3초가 넘는 모든 쉼을 자릅니다. 브이로그처럼 빠르게."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪掉所有超过三分之一秒的停顿。节奏快，像 Vlog。"
          }
        }
      }
    },
    "Cuts pauses longer than about half a second, keeping a natural rhythm.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knipt pauzes langer dan ongeveer een halve seconde weg, met een natuurlijk ritme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet Pausen über etwa einer halben Sekunde, mit natürlichem Rhythmus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe les pauses de plus d’une demi-seconde environ, en gardant un rythme naturel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta las pausas de más de medio segundo aproximadamente, con un ritmo natural."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taglia le pause più lunghe di circa mezzo secondo, mantenendo un ritmo naturale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta pausas maiores que cerca de meio segundo, mantendo um ritmo natural."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約0.5秒を超える間をカットし、自然なリズムを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 0.5초가 넘는 쉼을 잘라 자연스러운 리듬을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪掉超过约半秒的停顿，保持自然节奏。"
          }
        }
      }
    },
