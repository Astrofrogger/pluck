    "A .drp is imported and saved again beside it as “… relinked.drp”. Resolve keeps its own project backups." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine .drp wird importiert und daneben als „… relinked.drp“ gespeichert. Resolve behält eigene Projekt-Backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un .drp se importa y se guarda de nuevo a su lado como «… relinked.drp». Resolve guarda sus propias copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un .drp est importé puis enregistré à côté sous « … relinked.drp ». Resolve garde ses propres sauvegardes de projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un .drp viene importato e salvato accanto come «… relinked.drp». Resolve conserva i propri backup dei progetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".drp は読み込まれ、横に「… relinked.drp」として保存されます。Resolve は独自のプロジェクトバックアップを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".drp는 가져온 뒤 옆에 “… relinked.drp”로 다시 저장됩니다. Resolve는 자체 프로젝트 백업을 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een .drp wordt geïmporteerd en ernaast bewaard als ‘… relinked.drp’. Resolve houdt zijn eigen projectback-ups."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um .drp é importado e salvo ao lado como “… relinked.drp”. O Resolve mantém os próprios backups de projeto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".drp 会被导入并在旁边另存为“… relinked.drp”。Resolve 会保留自己的项目备份。"
          }
        }
      }
    },
    "Deleted files stay in %@ on this share until it’s emptied" : {
