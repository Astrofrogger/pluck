        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태가 왼쪽에서 오른쪽으로 하나씩 미끄러져 들어옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vormen schuiven een voor een binnen, van links naar rechts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As formas deslizam uma após a outra, da esquerda para a direita."
