    "Broadcasters reject it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender lehnen das ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cadenas lo rechazan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diffuseurs le refusent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le emittenti lo rifiutano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放送局では受け付けられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송사에서 거부됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenders weigeren het."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As emissoras recusam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播机构会拒收。"
          }
        }
      }
    },
    "Browser cookies are never sent to videos found on web pages, and the tools Pluck downloads are checked for their developers’ signatures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-Cookies werden nie an Videos gesendet, die auf Webseiten gefunden werden, und die Tools, die Pluck lädt, werden auf die Signatur ihrer Entwickler geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cookies del navegador nunca se envían a vídeos encontrados en páginas web, y se comprueba la firma de los desarrolladores de las herramientas que descarga Pluck."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies du navigateur ne sont jamais envoyés aux vidéos trouvées sur des pages web, et la signature des développeurs des outils téléchargés par Pluck est vérifiée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cookie del browser non vengono mai inviati ai video trovati nelle pagine web, e degli strumenti scaricati da Pluck viene verificata la firma degli sviluppatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web ページで見つかったビデオにブラウザの Cookie が送られることはありません。また、Pluck がダウンロードするツールは開発元の署名を確認しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 페이지에서 찾은 비디오에는 브라우저 쿠키를 절대 보내지 않으며, Pluck이 다운로드하는 도구는 개발자 서명을 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Browsercookies worden nooit meegestuurd naar video’s die op webpagina’s gevonden worden, en de tools die Pluck downloadt worden gecontroleerd op de handtekening van hun ontwikkelaars."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cookies do navegador nunca são enviados para vídeos encontrados em páginas da web, e as ferramentas que o Pluck baixa têm a assinatura dos desenvolvedores verificada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器 Cookie 绝不会发送给在网页上找到的视频，Pluck 下载的工具也会检查其开发者签名。"
          }
        }
      }
    },
