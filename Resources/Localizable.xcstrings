    "The deliverables for “%@” couldn’t be made": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Deliverables für „%@“ konnten nicht erstellt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron crear los entregables de «%@»"
