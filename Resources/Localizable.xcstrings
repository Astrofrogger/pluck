    "Nearly as sharp and about four times quicker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast so genau und etwa viermal schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi igual de preciso y unas cuatro veces más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque aussi précis et environ quatre fois plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi altrettanto preciso e circa quattro volte più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼ同等の精度で約4倍速い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 같은 정확도에 약 4배 빠릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna net zo scherp en ongeveer vier keer sneller."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase tão preciso e cerca de quatro vezes mais rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确度相近，速度快约四倍。"
