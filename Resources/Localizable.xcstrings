    "Select a clip to see its highlights, markers and transcript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Clip, um Highlights, Marker und Abschrift zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un clip para ver sus destacados, marcadores y transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un clip pour voir ses temps forts, marqueurs et transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una clip per vederne momenti salienti, marcatori e trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
