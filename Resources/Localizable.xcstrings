            "value": "Plus petit, pour les Mac avec 16 Go de mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più piccolo, per Mac con 16 GB di memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小型。16 GBメモリのMac向け。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 작은 모델, 16GB 메모리 Mac용."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleiner, voor Macs met 16 GB geheugen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menor, para Macs com 16 GB de memória."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较小，适合 16 GB 内存的 Mac。"
          }
        }
      }
    },
    "Smallest, for Macs with 8 GB of memory. Less precise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am kleinsten, für Macs mit 8 GB Arbeitsspeicher. Weniger genau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El más pequeño, para Mac con 8 GB de memoria. Menos preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plus petit, pour les Mac avec 8 Go de mémoire. Moins précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il più piccolo, per Mac con 8 GB di memoria. Meno preciso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小。8 GBメモリのMac向け。精度は低め。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 작은 모델, 8GB 메모리 Mac용. 정확도는 낮습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinste, voor Macs met 8 GB geheugen. Minder precies."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O menor, para Macs com 8 GB de memória. Menos preciso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最小，适合 8 GB 内存的 Mac。准确度较低。"
          }
        }
      }
    },
    "So you can search inside them. Runs in the background after each download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du darin suchen kannst. Läuft nach jedem Download im Hintergrund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder buscar dentro de ellas. Se ejecuta en segundo plano tras cada descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour pouvoir y rechercher. S’exécute en arrière-plan après chaque téléchargement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così puoi cercarci dentro. Viene eseguito in background dopo ogni download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中身を検索できるようにします。ダウンロードのたびにバックグラウンドで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안에서 검색할 수 있도록 합니다. 다운로드할 때마다 백그라운드에서 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat je erin kunt zoeken. Draait op de achtergrond na elke download."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para você poder buscar dentro deles. Roda em segundo plano após cada download."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以便在其中搜索。每次下载后在后台运行。"
          }
        }
      }
    },
