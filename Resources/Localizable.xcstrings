    "Licence plates, name tags, screens and signs. Titles and captions in the video are blurred too.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummerplaten, naambadges, schermen en borden. Titels en ondertitels in de video worden ook vervaagd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennzeichen, Namensschilder, Bildschirme und Schilder. Titel und Untertitel im Video werden ebenfalls verpixelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaques d’immatriculation, badges, écrans et panneaux. Les titres et sous-titres de la vidéo sont floutés aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Matrículas, identificadores, pantallas y carteles. También se difuminan los títulos y subtítulos del vídeo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Targhe, badge, schermi e cartelli. Anche titoli e sottotitoli del video vengono sfocati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Placas, crachás, telas e placas de sinalização. Títulos e legendas do vídeo também são desfocados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナンバープレート、名札、画面、看板など。動画内のタイトルや字幕もぼかされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호판, 명찰, 화면, 표지판. 영상 속 제목과 자막도 흐려집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车牌、胸牌、屏幕和标牌。视频中的标题和字幕也会被模糊。"
          }
        }
      }
    },
