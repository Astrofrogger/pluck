    "Renders anything this Mac sends, without checking which files it uses. Only for your own Macs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendert alles, was dieser Mac sendet, ohne zu prüfen, welche Dateien es verwendet. Nur für deine eigenen Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza todo lo que envía este Mac, sin comprobar qué archivos usa. Solo para tus propios Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait le rendu de tout ce que ce Mac envoie, sans vérifier quels fichiers il utilise. Réservé à vos propres Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue il rendering di tutto ciò che questo Mac invia, senza verificare quali file usa. Solo per i tuoi Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac から送られたものを、使用ファイルを確認せずにすべてレンダリングします。自分の Mac 専用です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 보내는 모든 것을 어떤 파일을 쓰는지 확인하지 않고 렌더링합니다. 본인의 Mac에만 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendert alles wat deze Mac stuurt, zonder te controleren welke bestanden het gebruikt. Alleen voor je eigen Macs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderiza tudo o que este Mac enviar, sem verificar quais arquivos usa. Somente para os seus próprios Macs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "渲染这台 Mac 发来的任何内容，不检查它用到哪些文件。仅适用于你自己的 Mac。"
          }
        }
      }
    },
