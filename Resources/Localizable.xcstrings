    "Stays sharp. Click to blur.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt scharf. Klicken zum Unscharfmachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene nítido. Haz clic para difuminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste net. Cliquez pour flouter."
          }
        },
        "it": {
