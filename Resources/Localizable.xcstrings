    "The full picture over a blurred fill, for videos with a lot of text and graphics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Bild über einer unscharfen Füllung, für Videos mit viel Text und Grafik."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen completa sobre un relleno desenfocado, para vídeos con mucho texto y gráficos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image entière sur un fond flouté, pour les vidéos avec beaucoup de texte et de graphismes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’immagine intera su uno sfondo sfocato, per video con molto testo e grafica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかした背景の上に全体の映像を表示します。テキストやグラフィックの多いビデオ向け。"
          }
        },
        "ko": {
