    "A close-up per person and a wide shot work best. Each camera needs its own sound to be synced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten eine Nahaufnahme pro Person und eine Totale. Jede Kamera braucht eigenen Ton zum Synchronisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona mejor con un primer plano por persona y un plano general. Cada cámara necesita su propio sonido para sincronizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéalement un gros plan par personne et un plan large. Chaque caméra a besoin de son propre son pour être synchronisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona meglio con un primo piano per persona e un campo largo. Ogni camera deve avere il proprio audio per la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1人ずつのクローズアップと引きのショットが最適です。同期には各カメラの音声が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인물별 클로즈업과 와이드 샷 하나가 가장 좋습니다. 싱크하려면 각 카메라에 자체 소리가 있어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een close-up per persoon en een totaalshot werken het best. Elke camera heeft eigen geluid nodig om te syncen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona melhor com um close por pessoa e um plano aberto. Cada câmera precisa do próprio som para sincronizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每人一个特写机位加一个全景机位效果最好。每台机位都需要自带声音才能同步。"
          }
        }
      },
      "extractionState": "stale"
    },
    "A cut derush timeline": {
      "localizations": {
