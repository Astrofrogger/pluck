        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilm draait nu native: een download van 9 MB in plaats van honderden, meerdere keren sneller en elke instelling als draaiknop."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O spektrafilm agora roda nativamente: um download de 9 MB em vez de centenas, renderização várias vezes mais rápida e cada ajuste como um dial."
