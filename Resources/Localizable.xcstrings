      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spektrafilm läuft jetzt nativ: ein Download von 9 MB statt Hunderten, mehrfach schnellere Berechnung und jede Einstellung als Regler."
