          }
        }
      }
    },
    "There’s no wide shot: crosstalk stays on the last speaker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Totale: Bei Durcheinanderreden bleibt das Bild bei der letzten Person."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay plano general: cuando hablan a la vez, se queda en el último hablante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de plan large : quand on parle en même temps, l’image reste sur le dernier intervenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è un campo largo: quando parlano insieme si resta sull’ultimo interlocutore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引きのショットがありません。同時に話している間は直前の話者のままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "와이드 샷이 없습니다. 동시에 말할 때는 마지막 화자에 머뭅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen totaalshot: bij door elkaar praten blijft het beeld op de laatste spreker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há plano aberto: quando falam ao mesmo tempo, fica no último falante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有全景机位：多人同时说话时停留在上一位说话人。"
          }
        }
      },
      "extractionState": "stale"
    },
    "These settings make the photos bigger. Lower the quality or the size.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesen Einstellungen werden die Fotos größer. Senke die Qualität oder die Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estos ajustes las fotos ocupan más. Baja la calidad o el tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages rendent les photos plus lourdes. Baissez la qualité ou la taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con queste impostazioni le foto diventano più grandi. Riduci la qualità o la dimensione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定では写真が大きくなります。品質かサイズを下げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정에서는 사진이 더 커집니다. 품질이나 크기를 낮추십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze instellingen worden de foto’s groter. Verlaag de kwaliteit of de grootte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com esses ajustes as fotos ficam maiores. Diminua a qualidade ou o tamanho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置会使照片变大。请降低质量或尺寸。"
          }
        }
      }
    },
