          }
        }
      }
    },
    "European broadcast expects 25 or 50 fps; this is %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Europäischer Rundfunk erwartet 25 oder 50 fps; dies sind %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La emisión europea espera 25 o 50 fps; este es %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusion européenne attend 25 ou 50 i/s ; celle-ci est à %@."
          }
        },
